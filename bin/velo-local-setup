#!/bin/bash
# velo-local-setup — the standard worker:local setup: LM Studio, tuned.
#
#   velo-local-setup           idempotent; safe to re-run after any LM Studio update
#
# 1. LM Studio's llama.cpp runtime is current (the model needs >= 2.46.0).
# 2. The model shards are in LM Studio's models folder (shared download step).
# 3. LM Studio's per-model load config carries the tuned settings from
#    velo-local.conf. Without them it loads 4 slots with small batches and runs
#    2.5x slower — measured, see velo-local.conf.
# 4. The llama-server alternative is stopped: two 84 GB copies do not fit.
# 5. The model is loaded and answers a tool call.
#
# Sampling is not configured here: the runner sends it on every request.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
die() { printf '\n\033[31mERROR:\033[0m %s\n\n' "$1" >&2; exit 1; }
ok()  { printf '\033[32m  ok\033[0m %s\n' "$1"; }
# shellcheck source=velo-local.conf
. "$HERE/velo-local.conf" || die "velo-local.conf missing next to velo-local-setup"

LMS="/Applications/LM Studio.app/Contents/Resources/app/.webpack/lms"
[[ -x "$LMS" ]] || die "LM Studio not found — install it from https://lmstudio.ai, open it once, then re-run"
MODELS="$HOME/.cache/lm-studio/models"
CFGROOT="$HOME/.cache/lm-studio/.internal/user-concrete-model-default-config"
read -r -a SHARDS <<<"$VELO_LOCAL_GGUF_SHARDS"

# 1. runtime
"$LMS" runtime update llama.cpp -y >/dev/null 2>&1 || die "lms runtime update llama.cpp failed"
ok "llama.cpp runtime: $("$LMS" runtime ls 2>/dev/null | awk '/llama.cpp/ && /✓/ {print $1}')"

# 2. model files
"$HERE/velo-llama-server" fetch || exit 1

# 3. tuned load config, keyed by the first shard's path under the models folder
rel="${VELO_LOCAL_GGUF_DIR#"$MODELS"/}/${SHARDS[0]}"
[[ "$rel" != /* ]] || die "VELO_LOCAL_GGUF_DIR is not under $MODELS — LM Studio would not see the model"
cfg="$CFGROOT/$rel.json"
mkdir -p "$(dirname "$cfg")"
[[ -f "$cfg" ]] && cp -p "$cfg" "$cfg.bak-$(date -u +%Y%m%dT%H%M%SZ)"
python3 - "$cfg" <<EOF || die "could not write $cfg"
import json, sys
kv = {"checked": True, "value": "$LMSTUDIO_KV_TYPE"}
json.dump({"preset": "", "operation": {"fields": []}, "load": {"fields": [
    {"key": "llm.load.contextLength", "value": $LMSTUDIO_CONTEXT},
    {"key": "llm.load.llama.flashAttention", "value": True},
    {"key": "llm.load.llama.kCacheQuantizationType", "value": kv},
    {"key": "llm.load.llama.vCacheQuantizationType", "value": kv},
    {"key": "llm.load.llama.evalBatchSize", "value": $LMSTUDIO_EVAL_BATCH},
    {"key": "llm.load.llama.physicalBatchSize", "value": $LMSTUDIO_PHYSICAL_BATCH},
    {"key": "llm.load.numParallelSessions", "value": $LMSTUDIO_PARALLEL},
]}}, open(sys.argv[1], "w"), indent=2)
EOF
ok "tuned load config: $cfg"

# 4. one copy of the model in memory
if launchctl print "gui/$(id -u)/ai.velostream.velo-llama-server" >/dev/null 2>&1; then
  "$HERE/velo-llama-server" uninstall
fi

# 5. load and prove it
"$LMS" unload "$VELO_LOCAL_MODEL_DEFAULT" >/dev/null 2>&1
"$LMS" load "$VELO_LOCAL_MODEL_DEFAULT" -y >/dev/null 2>&1 || die "lms load $VELO_LOCAL_MODEL_DEFAULT failed — see LM Studio's server log"
"$LMS" ps --json 2>/dev/null | python3 -c "
import json, sys
m = next((m for m in json.load(sys.stdin) if m['identifier'] == '$VELO_LOCAL_MODEL_DEFAULT'), None)
assert m, 'model not loaded'
assert m['contextLength'] == $LMSTUDIO_CONTEXT, f\"context {m['contextLength']} != $LMSTUDIO_CONTEXT\"
assert m['parallel'] == $LMSTUDIO_PARALLEL, f\"parallel {m['parallel']} != $LMSTUDIO_PARALLEL\"
" || die "loaded, but not with the tuned settings above"
ok "loaded: $VELO_LOCAL_MODEL_DEFAULT, context $LMSTUDIO_CONTEXT, parallel $LMSTUDIO_PARALLEL"
python3 - <<EOF || die "the model did not answer a tool call at $VELO_LOCAL_BASE_URL"
import json, urllib.request
tools = [{"type": "function", "function": {"name": "bash", "description": "Run a shell command",
          "parameters": {"type": "object", "properties": {"command": {"type": "string"}}, "required": ["command"]}}}]
body = {"model": "$VELO_LOCAL_MODEL_DEFAULT", "tools": tools, "max_tokens": 4000,
        "messages": [{"role": "user", "content": "List the files in /tmp using the tool."}]}
req = urllib.request.Request("$VELO_LOCAL_BASE_URL/chat/completions", json.dumps(body).encode(),
                             {"Content-Type": "application/json"})
calls = json.load(urllib.request.urlopen(req, timeout=600))["choices"][0]["message"].get("tool_calls")
assert calls and calls[0]["function"]["name"] == "bash", f"no tool call: {calls}"
EOF
ok "tool call answered at $VELO_LOCAL_BASE_URL"
