#!/bin/bash
# velo-llama-server — serve the worker:local model with llama-server.
#
#   velo-llama-server setup       one-shot, idempotent: pinned llama.cpp build + model + service
#   velo-llama-server fetch       download any missing model shard or MTP head (shared with velo-local-setup)
#   velo-llama-server install     write + load the launchd agent (starts now, and at login)
#   velo-llama-server uninstall   unload + remove the launchd agent (frees the model's memory)
#   velo-llama-server status      is it up, which build, which model
#   velo-llama-server run         run in the foreground (what launchd calls)
#
# Binary, model, endpoint and flags all come from velo-local.conf — the same file
# the dispatcher reads — so the server and its clients cannot disagree.
# Why llama-server and not LM Studio's API, and why unsloth's fork rather than
# Homebrew's build (MTP): see the measurements in velo-local.conf.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
die() { printf '\n\033[31mERROR:\033[0m %s\n\n' "$1" >&2; exit 1; }
ok()  { printf '\033[32m  ok\033[0m %s\n' "$1"; }
# shellcheck source=velo-launchd-lib.sh
. "$HERE/velo-launchd-lib.sh" || { echo "velo-launchd-lib.sh missing next to $0" >&2; exit 1; }
# shellcheck source=velo-local.conf
. "$HERE/velo-local.conf" || die "velo-local.conf missing next to velo-llama-server"

LABEL=ai.velostream.velo-llama-server
LOG="${VELO_STATE:-$HOME/.agents/state}/llama-server.log"
URL="$VELO_LLAMA_SERVER_URL"
PORT="${URL##*:}"; PORT="${PORT%%/*}"
HOST="${URL#*://}"; HOST="${HOST%%:*}"
read -r -a SHARDS <<<"$VELO_LOCAL_GGUF_SHARDS"
GGUF="$VELO_LOCAL_GGUF_DIR/${SHARDS[0]}"   # llama.cpp finds the other shards itself
MTP="$VELO_LOCAL_GGUF_DIR/$VELO_LOCAL_MTP"

# One file from the model's Hugging Face repo: size-checked, resumable, idempotent.
hf_fetch() {  # <subdir in repo> <file name>
  local repo sub want have dest
  repo="${VELO_LOCAL_HF%%/*}/$(cut -d/ -f2 <<<"$VELO_LOCAL_HF")"
  sub="$1"; dest="$VELO_LOCAL_GGUF_DIR/$2"
  want=$(curl -fsSL "https://huggingface.co/api/models/$repo/tree/main/$sub" \
    | python3 -c 'import json,sys; n=sys.argv[1]; print(next(f["size"] for f in json.load(sys.stdin) if f["path"].endswith("/"+n)))' "$2") \
    || die "could not read the size of $2 from huggingface.co/$repo"
  have=$(stat -f %z "$dest" 2>/dev/null || echo 0)
  if [[ "$have" == "$want" ]]; then ok "present: $2"; return 0; fi
  echo "  .. downloading $2 ($((want / 1000000000)) GB; resumes if interrupted)"
  curl -fL --retry 10 --retry-delay 10 -C - -o "$dest" \
    "https://huggingface.co/$repo/resolve/main/$sub/$2" || die "download failed: $2 (re-run setup to resume)"
  have=$(stat -f %z "$dest")
  [[ "$have" == "$want" ]] || die "size mismatch for $2: $have != $want (re-run setup to resume)"
  ok "downloaded: $2"
}

case "${1:-}" in
  run)
    [[ -x "$VELO_LLAMA_SERVER" ]] || die "llama-server not found at $VELO_LLAMA_SERVER — run: velo-llama-server setup"
    [[ -f "$GGUF" ]] || die "model not found: $GGUF — run: velo-llama-server setup"
    [[ -f "$MTP" ]] || die "MTP head not found: $MTP — run: velo-llama-server fetch"
    # llama.cpp's own env vars, because the message has spaces (see velo-local.conf).
    export LLAMA_ARG_THINK_BUDGET="$VELO_LLAMA_THINK_BUDGET"
    export LLAMA_ARG_THINK_BUDGET_MESSAGE="$VELO_LLAMA_THINK_BUDGET_MESSAGE"
    # Validated against the model's template, not the server's list: the server
    # also takes minimal/high/max, which this template rejects or remaps.
    case "$VELO_LLAMA_REASONING_EFFORT" in
      xhigh|medium|low) export LLAMA_ARG_REASONING_EFFORT="$VELO_LLAMA_REASONING_EFFORT" ;;
      *) die "VELO_LLAMA_REASONING_EFFORT must be xhigh, medium or low (velo-local.conf), got '$VELO_LLAMA_REASONING_EFFORT'" ;;
    esac
    "$VELO_LLAMA_SERVER" --version 2>&1 | grep -m1 '^version'
    # One copy of the model in memory. At login LM Studio may reload its last
    # models (it remembers this one); two 84 GB copies do not fit, and a failed
    # allocation here would make launchd retry every 30 s forever. So if LM
    # Studio's server is up AND has the model loaded, unload it there first.
    # Only called when the server already answers: `lms` can start LM Studio's
    # background service itself, and this must never launch LM Studio.
    if curl -sf -m 3 "$VELO_LMSTUDIO_BASE_URL/models" >/dev/null 2>&1 && [[ -x "$VELO_LMS" ]] \
       && "$VELO_LMS" ps --json 2>/dev/null | python3 -c "
import json, sys
sys.exit(0 if any(m.get('identifier') == '$VELO_GGUF_MODEL_ID' for m in json.load(sys.stdin)) else 1)"; then
      "$VELO_LMS" unload "$VELO_GGUF_MODEL_ID" >/dev/null 2>&1 \
        && echo "velo-llama-server: unloaded $VELO_GGUF_MODEL_ID from LM Studio (one copy in memory)" \
        || echo "velo-llama-server: WARNING could not unload $VELO_GGUF_MODEL_ID from LM Studio" >&2
    fi
    # Word-splitting VELO_LLAMA_ARGS is intended: it is a flag list.
    # shellcheck disable=SC2086
    exec "$VELO_LLAMA_SERVER" -m "$GGUF" --alias "$VELO_GGUF_MODEL_ID" \
      --host "$HOST" --port "$PORT" $VELO_LLAMA_ARGS
    ;;
  setup)
    # Every step checks before it acts, so re-running is safe and cheap.
    if [[ -x "$VELO_LLAMA_SERVER" ]]; then
      ok "llama.cpp present: $("$VELO_LLAMA_SERVER" --version 2>&1 | grep -m1 '^version')"
    else
      [[ "$(uname -sm)" == "Darwin arm64" ]] || die "the pinned build is macOS arm64 only; set VELO_LLAMA_SERVER in velo-local.conf"
      tarball="llama-$VELO_LLAMA_FORK_TAG-bin-macos-arm64.tar.gz"
      mkdir -p "$VELO_LLAMA_FORK_DIR"
      echo "  .. downloading llama.cpp $VELO_LLAMA_FORK_TAG (unslothai/llama.cpp)"
      curl -fL --retry 5 -o "$VELO_LLAMA_FORK_DIR/$tarball" \
        "https://github.com/unslothai/llama.cpp/releases/download/$VELO_LLAMA_FORK_TAG/$tarball" \
        || die "download failed: $tarball"
      tar xzf "$VELO_LLAMA_FORK_DIR/$tarball" -C "$VELO_LLAMA_FORK_DIR" || die "could not unpack $tarball"
      [[ -x "$VELO_LLAMA_SERVER" ]] || die "unpacked, but no llama-server at $VELO_LLAMA_SERVER — fix velo-local.conf"
      ok "llama.cpp installed: $("$VELO_LLAMA_SERVER" --version 2>&1 | grep -m1 '^version')"
    fi
    "$0" fetch || exit 1
    velo_launchd_install "$LABEL" "$HERE/velo-llama-server" "$LOG"
    echo "  .. waiting for the model to load"
    for _ in $(seq 1 100); do curl -sf "http://$HOST:$PORT/health" >/dev/null && break; sleep 3; done
    "$0" status
    ;;
  fetch)
    mkdir -p "$VELO_LOCAL_GGUF_DIR"
    for sh in "${SHARDS[@]}"; do hf_fetch "$(cut -d/ -f3- <<<"$VELO_LOCAL_HF")" "$sh"; done
    hf_fetch "$VELO_LOCAL_MTP_HF_DIR" "$VELO_LOCAL_MTP"
    ;;
  install)   velo_launchd_install "$LABEL" "$HERE/velo-llama-server" "$LOG" ;;
  uninstall) velo_launchd_uninstall "$LABEL" ;;
  status)
    if curl -sf "http://$HOST:$PORT/health" >/dev/null; then
      ok "up at $URL serving $(curl -s "$URL/models" | python3 -c 'import json,sys;print(",".join(m["id"] for m in json.load(sys.stdin)["data"]))')"
      ok "binary: $VELO_LLAMA_SERVER ($("$VELO_LLAMA_SERVER" --version 2>&1 | grep -m1 '^version'))"
    else
      die "not responding at $URL — see $LOG"
    fi
    ;;
  *) die "usage: velo-llama-server setup | fetch | install | uninstall | status | run" ;;
esac
