#!/bin/bash
# velo-llama-server — serve the worker:local model with llama-server directly.
#
#   velo-llama-server install     write + load the launchd agent (starts now, and at login)
#   velo-llama-server uninstall   unload + remove the launchd agent
#   velo-llama-server status      is it up, on which port, serving which model
#   velo-llama-server run         run in the foreground (what launchd calls)
#
# Model, endpoint and flags come from velo-local.conf — the same file the
# dispatcher reads — so the server and its clients cannot disagree about either.
# Why not LM Studio's API: see the measurements in velo-local.conf.
set -uo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
die() { printf '\n\033[31mERROR:\033[0m %s\n\n' "$1" >&2; exit 1; }
ok()  { printf '\033[32m  ok\033[0m %s\n' "$1"; }
# shellcheck source=velo-local.conf
. "$HERE/velo-local.conf" || die "velo-local.conf missing next to velo-llama-server"

LABEL=ai.velostream.velo-llama-server
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG="${VELO_STATE:-$HOME/.agents/state}/llama-server.log"
PORT="${VELO_LOCAL_BASE_URL##*:}"; PORT="${PORT%%/*}"
HOST="${VELO_LOCAL_BASE_URL#*://}"; HOST="${HOST%%:*}"

case "${1:-}" in
  run)
    [[ -x "$VELO_LLAMA_SERVER_DIR/llama-server" ]] || die "llama-server not found in $VELO_LLAMA_SERVER_DIR (update LM Studio's llama.cpp runtime, or fix velo-local.conf)"
    [[ -f "$VELO_LOCAL_GGUF" ]] || die "model not found: $VELO_LOCAL_GGUF"
    # Word-splitting VELO_LLAMA_ARGS is intended: it is a flag list.
    # shellcheck disable=SC2086
    DYLD_LIBRARY_PATH="$VELO_LLAMA_SERVER_DIR" exec "$VELO_LLAMA_SERVER_DIR/llama-server" \
      -m "$VELO_LOCAL_GGUF" --alias "$VELO_LOCAL_MODEL_DEFAULT" --host "$HOST" --port "$PORT" \
      $VELO_LLAMA_ARGS
    ;;
  install)
    # The plist records THIS script's path. Installing from a worktree would
    # point launchd at a checkout that gets removed.
    [[ "$HERE" == "$HOME/.agents/bin" ]] || die "run install from ~/.agents/bin (after install.sh), not $HERE"
    mkdir -p "$(dirname "$PLIST")" "$(dirname "$LOG")"
    cat > "$PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$HERE/velo-llama-server</string><string>run</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict></plist>
EOF
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null
    launchctl bootstrap "gui/$(id -u)" "$PLIST" || die "launchctl bootstrap failed for $PLIST"
    ok "launchd agent loaded: $LABEL  log: $LOG"
    ;;
  uninstall)
    launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null
    rm -f "$PLIST"
    ok "launchd agent removed: $LABEL"
    ;;
  status)
    if curl -sf "http://$HOST:$PORT/health" >/dev/null; then
      ok "up at $VELO_LOCAL_BASE_URL serving $(curl -s "$VELO_LOCAL_BASE_URL/models" | python3 -c 'import json,sys;print(",".join(m["id"] for m in json.load(sys.stdin)["data"]))')"
    else
      die "not responding at $VELO_LOCAL_BASE_URL — see $LOG"
    fi
    ;;
  *) die "usage: velo-llama-server install | uninstall | status | run" ;;
esac
