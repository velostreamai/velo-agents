#!/bin/bash
# velo-orchestrd — the always-on, LLM-free orchestration checker (#2285 PR2).
#
#   velo-orchestrd [tick]      run one idempotent tick (default action)
#   velo-orchestrd install     install the launchd agent (runs every 300s)
#   velo-orchestrd uninstall   remove the launchd agent
#   velo-orchestrd status      launchd status + tail of the daemon log
#
# Why this exists: `velo-dispatch`, `velo-pr-gate` and `velo-merge` all start
# detached work and return immediately, and nothing woke the orchestrating
# session when that work finished (#2285) — six gates and two workers once sat
# unprocessed for ~8 hours overnight. The fix is not "remember to poll"; it is
# a mechanical checker that needs no model and runs on its own schedule.
#
# Every tick is idempotent: posting and merging are guarded, doubly — a cheap
# pre-check in step_gates/step_merge below, and the authoritative (pr,
# gate-name-or-head, sha) lock + done-marker INSIDE velo-gate-post and
# velo-merge themselves (#2285 Round 2), so a session's own --wait loop and
# this daemon's tick can never post or merge the same fact twice even when
# they race. Escalation ids are deduped by content so the same fact is never
# raised twice either. See .agents/README.md "velo-orchestrd" for the full
# design.
#
# This PR's "Integration after PR1" list — velo-watch --attention, the
# SessionStart listing, velo-pr-gate recording the gated sha at launch, the
# shared post/merge-once guard, and the .agents-only merge exception in
# velo-merge itself — is now done (#2285 Round 2). The one thing this daemon
# still deliberately does NOT do is auto-merge an .agents/-only PR itself
# (see step_merge below) — velo-merge can now merge one when a human or a
# --wait loop calls it directly, but this daemon escalates instead, by
# policy: tooling changes that alter how every future gate/merge/dispatch
# behaves get a human's final click, on purpose, even once CI-not-required is
# handled at the tool level.
#
# Bash 3.2 only (macOS system /bin/bash). No associative arrays, no `${x,,}`.

set -uo pipefail
# Which repo: VELO_REPO (alias VELO_GATE_REPO), else the default; see velo-repo-lib.sh. The gate tools it runs
# (velo-gate, velo-gate-post, velo-merge) resolve the repo from the same two variables, so they act on the repo it lists.
. "${VELO_REPO_LIB:-$(dirname "${BASH_SOURCE[0]}")/velo-repo-lib.sh}" || exit 1
repo_init || exit 1
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=./velo-orch-lib.sh
source "$HERE/velo-orch-lib.sh"
# shellcheck source=./velo-worktree-lib.sh
source "$HERE/velo-worktree-lib.sh"

VELO_GATE="${VELO_GATE_BIN:-$HERE/velo-gate}"
VELO_GATE_POST="${VELO_GATE_POST_BIN:-$HERE/velo-gate-post}"
VELO_MERGE="${VELO_MERGE_BIN:-$HERE/velo-merge}"
VELO_DISPATCH="${VELO_DISPATCH_BIN:-$HERE/velo-dispatch}"

WIP_CAP="${VELO_ORCH_WIP_CAP:-4}"
MIN_DISK_GB="${VELO_ORCH_MIN_DISK_GB:-25}"
# Two configurable numbers, per the #2285 review's "define wedge in numbers":
# how long agent.log may sit still (WEDGE_MINUTES) before it counts at all,
# and a grace period (WEDGE_GRACE_MINUTES) a freshly-dispatched worktree gets
# before it is even eligible — a brand-new worker's agent.log is legitimately
# quiet during index build / first-turn setup, and without a grace period
# that reads as wedged. WEDGE_MINUTES must also stay long enough that a local
# worker's own slow prefill (measured ~85s per 43K tokens, several per run)
# does not trip it — 30m default clears that with a wide margin.
WEDGE_MINUTES="${VELO_ORCH_WEDGE_MINUTES:-30}"
WEDGE_GRACE_MINUTES="${VELO_ORCH_WEDGE_GRACE_MINUTES:-10}"
WORKTREE_GLOB="${VELO_ORCH_WORKTREE_GLOB:-$HOME/RustroverProjects/$REPO_NAME-*}"
LOG_FILE="${VELO_ORCH_LOG:-$ORCH_DIR/orchestrd.log}"
LOG_MAX_BYTES="${VELO_ORCH_LOG_MAX_BYTES:-5242880}"

PLIST_LABEL="ai.velostream.orchestrd"
PLIST_SRC="$(cd "$HERE/.." && pwd)/launchd/$PLIST_LABEL.plist"
PLIST_DST="$HOME/Library/LaunchAgents/$PLIST_LABEL.plist"

log()  { mkdir -p "$ORCH_DIR"; printf '%s %s\n' "$(date -u +%FT%TZ)" "$1" >> "$LOG_FILE"; }

rotate_log_if_needed() {
  [[ -f "$LOG_FILE" ]] || return 0
  local sz
  sz=$(stat -f %z "$LOG_FILE" 2>/dev/null || stat -c %s "$LOG_FILE" 2>/dev/null || echo 0)
  [[ "$sz" -gt "$LOG_MAX_BYTES" ]] || return 0
  mv -f "$LOG_FILE" "$LOG_FILE.1"
}

# ---- kill switch, auth, global lock ------------------------------------------

is_paused() { [[ -f "$PAUSE_FILE" ]]; }

check_gh_auth() {
  local out
  if out=$(gh auth status 2>&1); then
    return 0
  fi
  # Deduped per-day: a broken token stays broken for hours, and re-raising the
  # same fact every 5 minutes is exactly the noise #2285's own id-dedup rule
  # exists to prevent.
  local day; day=$(date -u +%Y-%m-%d)
  if attention_append "gh-auth:orch:$day" "gh-auth" "" "" "$day" \
       "gh auth status failed: $(printf '%s' "$out" | tr '\n' ' ' | cut -c1-300)"; then
    log "ESCALATE gh-auth: $(printf '%s' "$out" | head -1)"
  fi
  return 1
}

LOCK_OWNED=0
acquire_lock() {
  mkdir -p "$ORCH_DIR"
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    local holder; holder=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo "")
    if [[ -n "$holder" ]] && orch_pid_alive "$holder"; then
      return 1
    fi
    rm -rf "$LOCK_DIR"
    mkdir "$LOCK_DIR" 2>/dev/null || return 1
  fi
  printf '%s\n' "$$" > "$LOCK_DIR/pid"
  LOCK_OWNED=1
  return 0
}

release_lock() {
  [[ "$LOCK_OWNED" -eq 1 ]] || return 0
  local holder; holder=$(cat "$LOCK_DIR/pid" 2>/dev/null || echo "")
  [[ "$holder" == "$$" ]] && rm -rf "$LOCK_DIR"
}

# ---- detect: finished workers -------------------------------------------------
#
# "Finished" means a NEW line landed in ~/.agents/state/records/<issue>.result.jsonl
# — append-only, one row per worker exit (crash, timeout or clean). Offsets are
# tracked per issue so a tick never re-reads the whole history, and the escalation
# id includes the row's own `dispatched_at`, which is unique per run.

step_workers() {
  [[ -d "$RECORDS_DIR" ]] || return 0
  mkdir -p "$OFFSETS_DIR"
  local f issue count offset_file prev_count
  for f in "$RECORDS_DIR"/*.result.jsonl; do
    [[ -f "$f" ]] || continue
    issue=$(basename "$f" .result.jsonl)
    [[ "$issue" =~ ^[0-9]+$ ]] || continue
    count=$(grep -c . "$f" 2>/dev/null || echo 0)
    offset_file="$OFFSETS_DIR/$issue.count"
    prev_count=0
    [[ -f "$offset_file" ]] && prev_count=$(cat "$offset_file" 2>/dev/null || echo 0)
    [[ "$prev_count" =~ ^[0-9]+$ ]] || prev_count=0
    if [[ "$count" -gt "$prev_count" ]]; then
      local line n=0 dispatched_at outcome worker
      while IFS= read -r line; do
        n=$((n + 1))
        [[ "$n" -le "$prev_count" ]] && continue
        [[ -n "$line" ]] || continue
        dispatched_at=$(jq -r '.dispatched_at // ""' <<<"$line" 2>/dev/null)
        outcome=$(jq -r '.outcome // "unknown"' <<<"$line" 2>/dev/null)
        worker=$(jq -r '.worker // "unknown"' <<<"$line" 2>/dev/null)
        [[ -n "$dispatched_at" ]] || dispatched_at="line-$n"
        if attention_append "worker-finished:$issue:$dispatched_at" "worker-finished" "" "$issue" "$dispatched_at" \
             "#$issue worker=$worker outcome=$outcome — verify from git before any PR, never from the worker's own report."; then
          log "ESCALATE worker-finished #$issue outcome=$outcome"
        fi
      done < "$f"
    fi
    printf '%s\n' "$count" > "$offset_file"
  done
}

# ---- detect + post: gates -----------------------------------------------------
#
# "Finished" means the reviewer's pid (persisted by velo-pr-gate's
# gate_track_pid to "<log>.pid" right after launch) has exited. A gate whose
# pid file does not exist is NOT assumed finished — it predates the
# pid-persistence, or was dispatched by something else — so it is left alone
# rather than guessed at from the log's mtime. Neither is one whose pid file
# cannot name a pid (empty, not a number, unreadable): "no live pid" is only
# "finished" when the pid is KNOWN, because judging a log that is still being
# written posts a partial review under the gate header, and the post-once
# guard then keeps the real report off the PR. That state is logged each tick.
#
# Posting always uses the sha recorded in "$GATE_DIR/gated.sha" — written by
# velo-pr-gate at LAUNCH, before any gate is dispatched (#2285 Round 2). Its
# absence is still read defensively: escalate rather than ever posting
# against the CURRENT head, which could stamp coverage the gate never had —
# it happens for gates dispatched before that write existed, or run some
# other way entirely.
#
# The actual `gh pr comment` call, and the (pr, gate-name, sha) post-once
# guard against a session's own --wait racing this same tick, both live
# INSIDE velo-gate-post now (#2285 Round 2) — this loop's own
# "does a header already exist" check below is a cheap pre-filter that saves
# calling velo-gate-post at all in the common case, not the enforcement.

# Records the verdict through velo-gate, and says it was recorded only if it was. velo-gate REFUSES
# on purpose — a stale gate, gate comments it cannot read, a label it cannot set — and its message
# is the reason. Sending it to /dev/null and logging "gate:passed" regardless reported a verdict
# that was never recorded, on every tick, with nothing escalated: a PR left at gate:running behind
# a log that said it had passed.
record_verdict() {   # <pr> <head sha> <--pass|--block> <label it sets>
  local pr="$1" head="$2" mode="$3" label="$4" out
  if out=$("$VELO_GATE" "$pr" "$mode" 2>&1); then
    log "$label #$pr"
  elif attention_append "gate-label-failed:$pr:$head:$label" "gate-label-failed" "$pr" "" "$head" \
         "velo-gate $mode refused or failed for #$pr @ ${head:0:9}, so $label was NOT recorded: $(printf '%s' "$out" | tr '\n' ' ' | cut -c1-300)"; then
    log "ESCALATE gate-label-failed #$pr $label"
  fi
}

step_gates() {
  local prs pr
  prs=$(gh pr list --repo "$REPO" --label gate:running --state open --json number 2>/dev/null | jq -r '.[].number')
  [[ -n "$prs" ]] || return 0
  for pr in $prs; do
    local meta head comments needed
    meta=$(gh pr view "$pr" --repo "$REPO" --json headRefOid,comments 2>/dev/null) || continue
    head=$(jq -r '.headRefOid' <<<"$meta")
    comments=$(jq -r '[.comments[].body] | join("\n---\n")' <<<"$meta")
    needed=$(gate_needed_names "$pr" "$VELO_GATE")
    [[ -n "$needed" ]] || continue

    local all_approve=1 any_blocked=0 name
    for name in $needed; do
      local log_base gate_dir log_file pid_file
      log_base=$(gate_log_for_name "$name") || { all_approve=0; continue; }
      gate_dir="$GATE_ROOT/$pr"
      log_file="$gate_dir/$log_base"
      pid_file="$log_file.pid"
      [[ -f "$log_file" ]] || { all_approve=0; continue; }

      if [[ -f "$pid_file" ]]; then
        local pid; pid=$(cat "$pid_file" 2>/dev/null)
        pid="${pid//[[:space:]]/}"
        if ! [[ "$pid" =~ ^[0-9]+$ ]]; then
          all_approve=0
          log "gate '$name' for #$pr: $pid_file holds no readable pid ('${pid:0:40}') — not treated as finished"
          continue   # empty, not a pid, or unreadable: it cannot say the reviewer is gone
        fi
        if orch_pid_alive "$pid"; then
          all_approve=0
          continue   # still running
        fi
      else
        all_approve=0
        continue   # cannot tell "finished" from "still running" without the pid
      fi

      local sha_file gated_sha
      sha_file="$gate_dir/gated.sha"
      if [[ ! -f "$sha_file" ]]; then
        if attention_append "gate-nosha:$pr:$head" "gate-nosha" "$pr" "" "$head" \
             "gate '$name' finished for #$pr but $sha_file does not exist — cannot post without risking a claim of coverage the gate never had. Post by hand: velo-gate-post $pr $name $log_file --sha <the sha this gate ran against>"; then
          log "ESCALATE gate-nosha #$pr $name"
        fi
        all_approve=0
        continue
      fi
      gated_sha=$(tr -d '[:space:]' < "$sha_file")
      [[ -n "$gated_sha" ]] || { all_approve=0; continue; }

      local header; header="gate: $name @ ${gated_sha:0:9}"
      if ! orch_comments_open_with "$header" <<<"$comments"; then
        local post_out post_rc
        post_out=$("$VELO_GATE_POST" "$pr" "$name" "$log_file" --sha "$gated_sha" 2>&1); post_rc=$?
        if [[ $post_rc -ne 0 ]]; then
          if attention_append "gate-post-failed:$pr:$gated_sha:$name" "gate-post-failed" "$pr" "" "$gated_sha" \
               "velo-gate-post refused '$name' for #$pr @ ${gated_sha:0:9}: $(printf '%s' "$post_out" | tr '\n' ' ' | cut -c1-300)"; then
            log "ESCALATE gate-post-failed #$pr $name"
          fi
          all_approve=0
          continue
        fi
        comments="$comments"$'\n---\n'"$header"   # so a later gate in this same loop sees it too (as its own comment)
        log "POST #$pr $name @ ${gated_sha:0:9}"
      fi

      local verdict; verdict=$(verdict_of "$(cat "$log_file")")
      case "$verdict" in
        approve) : ;;
        approve-with-findings)
          all_approve=0
          if attention_append "gate-findings:$pr:$gated_sha:$name" "gate-findings" "$pr" "" "$gated_sha" \
               "'$name' returned approve-with-findings for #$pr @ ${gated_sha:0:9} — fix hot-path/wrong-data findings, waive the rest to the nits issue, then re-gate."; then
            log "ESCALATE gate-findings #$pr $name"
          fi
          ;;
        blocked)
          all_approve=0; any_blocked=1
          if attention_append "gate-blocked:$pr:$gated_sha:$name" "gate-blocked" "$pr" "" "$gated_sha" \
               "'$name' returned blocked for #$pr @ ${gated_sha:0:9} — a fix brief is needed."; then
            log "ESCALATE gate-blocked #$pr $name"
          fi
          ;;
        *)
          all_approve=0
          if attention_append "gate-malformed:$pr:$gated_sha:$name" "gate-malformed" "$pr" "" "$gated_sha" \
               "'$name' for #$pr @ ${gated_sha:0:9} has no recognisable **Verdict:** line — read $log_file by hand."; then
            log "ESCALATE gate-malformed #$pr $name"
          fi
          ;;
      esac
    done

    if [[ "$any_blocked" -eq 1 ]]; then
      record_verdict "$pr" "$head" --block gate:blocked
    elif [[ "$all_approve" -eq 1 ]]; then
      record_verdict "$pr" "$head" --pass gate:passed
    fi
  done
}

# ---- merge ---------------------------------------------------------------------
#
# Never merges a PR whose diff is entirely under .agents/. velo-merge itself
# now accepts one of these without CI (#2285 Round 2 — this repo's CI skips
# non-Rust paths, so no lane ever runs for them, and velo-merge's own
# AGENTS_ONLY check tells "no CI ran" apart from "something is wrong" for
# exactly this shape). This daemon deliberately does NOT use that: tooling
# changes govern how every future gate/merge/dispatch behaves, so this one
# file-shape always gets a human's final click regardless of what the tool
# itself now allows. Escalate, never call velo-merge for these at all.

step_merge() {
  local prs pr
  prs=$(gh pr list --repo "$REPO" --label gate:passed --state open --json number 2>/dev/null | jq -r '.[].number')
  [[ -n "$prs" ]] || return 0
  for pr in $prs; do
    local meta files head
    meta=$(gh pr view "$pr" --repo "$REPO" --json files,headRefOid 2>/dev/null) || continue
    files=$(jq -r '[.files[].path] | join("\n")' <<<"$meta")
    head=$(jq -r '.headRefOid' <<<"$meta")

    if is_agents_only "$files"; then
      if attention_append "agents-only-merge:$pr:$head" "agents-only-merge" "$pr" "" "$head" \
           "#$pr touches only .agents/ paths — auto-merge is refused (CI does not run on tooling-only diffs). Merge by hand once verified."; then
        log "ESCALATE agents-only-merge #$pr"
      fi
      continue
    fi

    local out rc
    out=$("$VELO_MERGE" "$pr" 2>&1); rc=$?
    if [[ $rc -eq 0 ]]; then
      log "MERGED #$pr"
    elif grep -q 'CI FAILING' <<<"$out"; then
      if attention_append "ci-failed:$pr:$head" "ci-failed" "$pr" "" "$head" \
           "CI is failing on #$pr @ ${head:0:9}: $(grep 'CI FAILING' <<<"$out" | head -1 | cut -c1-300)"; then
        log "ESCALATE ci-failed #$pr"
      fi
    else
      # Routine and self-healing: stale gate, pending CI, merge conflicts.
      # None of these need a human paged at 3am — they clear on their own
      # (re-gate, wait, rebase) and the next tick tries again.
      log "merge refused #$pr (routine): $(printf '%s' "$out" | tail -1 | cut -c1-200)"
    fi
  done
}

# ---- dispatch --------------------------------------------------------------------
#
# Consumes ONE entry from the front of $QUEUE_FILE per tick (FIFO), popping it
# unconditionally so a malformed or now-mismatched entry cannot wedge every
# later one behind it. The two things pinned at queue time — the worker label
# and the brief's sha256 — are re-checked against live state before dispatch.
#
# An entry that is popped and NOT dispatched — malformed, labels unreadable,
# several worker labels, a pin that moved, or velo-dispatch itself refusing —
# is escalated every time, under an id of its own attempt: the operator who
# queued it is told the dispatch did not happen, and why.

list_active_worktrees() {   # -> one worktree path per line with a live worker pid
  local d pid
  for d in $WORKTREE_GLOB; do
    [[ -d "$d" ]] || continue
    # a worker of another repo under this directory name (the owner differs, the name does not) is not this repo's: it is
    # neither counted against the cap nor escalated
    repo_owns "$d" || continue
    pid=$(orch_running_pid_for "$d")
    [[ -n "$pid" ]] && printf '%s\n' "$d"
  done
}

wip_count() { list_active_worktrees | grep -c . ; }

free_disk_gb() { df -g "$HOME" 2>/dev/null | awk 'NR==2{print $4}'; }

queue_pop_head() {
  local rest; rest=$(tail -n +2 "$QUEUE_FILE" 2>/dev/null)
  if [[ -n "$rest" ]]; then printf '%s\n' "$rest" > "$QUEUE_FILE"; else : > "$QUEUE_FILE"; fi
}

# One escalation id per ATTEMPT. step_dispatch pops the entry before it checks or runs anything, so no
# tick ever sees the same entry twice; an id of (issue, brief) that dedupes forever could only swallow
# the NEXT time someone re-queues the same entry — a dispatch that did not happen, and nobody told.
dispatch_attempt_id() {   # <kind> <issue, or "none"> -> an id no other attempt shares
  printf '%s:%s:%s-%s' "$1" "$2" "$(date -u +%FT%TZ)" "$$"
}

step_dispatch() {
  [[ -s "$QUEUE_FILE" ]] || return 0

  local wip; wip=$(wip_count)
  if [[ "$wip" -ge "$WIP_CAP" ]]; then
    log "dispatch: WIP cap reached ($wip/$WIP_CAP) — nothing dispatched"
    return 0
  fi

  local disk; disk=$(free_disk_gb)
  if [[ -z "$disk" || "$disk" -lt "$MIN_DISK_GB" ]]; then
    local day; day=$(date -u +%Y-%m-%d)
    if attention_append "low-disk:orch:$day" "low-disk" "" "" "$day" \
         "only ${disk:-?}GB free (< ${MIN_DISK_GB}GB) — dispatch paused until this clears."; then
      log "ESCALATE low-disk ${disk:-?}GB"
    fi
    return 0
  fi

  local line; line=$(head -1 "$QUEUE_FILE")
  queue_pop_head
  [[ -n "$line" ]] || return 0

  local issue brief worker brief_sha256
  issue=$(jq -r '.issue // ""' <<<"$line" 2>/dev/null)
  brief=$(jq -r '.brief // ""' <<<"$line" 2>/dev/null)
  worker=$(jq -r '.worker // ""' <<<"$line" 2>/dev/null)
  brief_sha256=$(jq -r '.brief_sha256 // ""' <<<"$line" 2>/dev/null)

  # An entry that cannot be dispatched at all is dropped — it was popped above, so one bad entry cannot
  # wedge the queue — but whoever queued it was expecting a worker, so it is escalated too. The issue
  # must be a NUMBER: attention_append reads it with `tonumber`, and when that fails it returns the
  # same status as "already escalated", so an event naming a non-numeric issue vanished without a trace.
  local bad=""
  if ! [[ "$issue" =~ ^[0-9]+$ ]]; then bad="no numeric issue"
  elif [[ -z "$brief" ]]; then bad="no brief path"
  elif [[ ! -f "$brief" ]]; then bad="no brief file at $brief"
  fi
  if [[ -n "$bad" ]]; then
    log "dispatch: malformed/unreadable queue head, dropped ($bad): $(printf '%s' "$line" | cut -c1-200)"
    local bad_issue=""; [[ "$issue" =~ ^[0-9]+$ ]] && bad_issue="$issue"
    if attention_append "$(dispatch_attempt_id dispatch-malformed "${bad_issue:-none}")" "dispatch-malformed" "" "$bad_issue" "" \
         "queue entry dropped, nothing dispatched — $bad: $(printf '%s' "$line" | cut -c1-200)"; then
      log "ESCALATE dispatch-malformed ($bad)"
    fi
    return 0
  fi

  local cur_labels cur_worker cur_sha256 errf why workers n_workers
  # A read that FAILS is not an issue with no worker label. The entry is dropped either way (it was
  # popped above, so one bad entry cannot wedge the queue), but whoever re-queues it is told the true
  # reason: a dropped connection used to be reported as "the issue now has worker:<none>".
  errf=$(mktemp "${TMPDIR:-/tmp}/velo-orchestrd-gh.XXXXXX" 2>/dev/null) || errf=/dev/null
  if ! cur_labels=$(gh issue view "$issue" --repo "$REPO" --json labels --jq '[.labels[].name]|join(",")' 2>"$errf"); then
    why=$(head -n 1 "$errf" 2>/dev/null | cut -c1-200)
    [[ "$errf" == /dev/null ]] || rm -f "$errf"
    if attention_append "$(dispatch_attempt_id dispatch-unreadable "$issue")" "dispatch-unreadable" "" "$issue" "$brief_sha256" \
         "could not read the labels of #$issue to re-check the pinned worker=$worker: ${why:-gh exited non-zero with no message} — dropped, re-queue once gh answers."; then
      log "ESCALATE dispatch-unreadable #$issue"
    fi
    return 0
  fi
  [[ "$errf" == /dev/null ]] || rm -f "$errf"
  # ONE worker is derived from the issue's labels, and an issue with several has none: velo-dispatch
  # refuses it ("at most one"), so naming the FIRST as the worker passed a pin the dispatch itself
  # would reject, and the refusal reached only the daemon log.
  workers=$(tr ',' '\n' <<<"$cur_labels" | grep '^worker:' || true)
  n_workers=$(grep -c . <<<"$workers" || true)
  if [[ "$n_workers" -gt 1 ]]; then
    if attention_append "$(dispatch_attempt_id dispatch-mismatch "$issue")" "dispatch-mismatch" "" "$issue" "$brief_sha256" \
         "queue pinned worker=$worker but #$issue now has $n_workers worker labels ($(tr '\n' ' ' <<<"$workers" | sed 's/ $//')) — velo-dispatch refuses more than one; dropped, re-queue after resolving."; then
      log "ESCALATE dispatch-mismatch #$issue ($n_workers worker labels)"
    fi
    return 0
  fi
  cur_worker="${workers#worker:}"
  cur_sha256=$(shasum -a 256 "$brief" 2>/dev/null | awk '{print $1}')

  if [[ "$cur_worker" != "$worker" || "$cur_sha256" != "$brief_sha256" ]]; then
    if attention_append "$(dispatch_attempt_id dispatch-mismatch "$issue")" "dispatch-mismatch" "" "$issue" "$brief_sha256" \
         "queue pinned worker=$worker sha256=${brief_sha256:0:12} but the issue now has worker:${cur_worker:-<none>} and the brief now hashes to ${cur_sha256:0:12} — dropped, re-queue after resolving."; then
      log "ESCALATE dispatch-mismatch #$issue"
    fi
    return 0
  fi

  log "dispatch: #$issue -> worker:$worker (wip $wip/$WIP_CAP)"
  # velo-dispatch refuses on purpose — stale anchors, a brief that fails its lint, no disk, a dirty tree —
  # and says why on its output. That output stays in the log, and its STATUS decides: the entry is already
  # popped, so a refusal that reached only the log was a dispatch the operator queued and nobody was told
  # had not happened. The output goes to the log FILE, never a pipe (the supervisor it detaches would hold
  # a pipe open and hang the tick); the reason is read back from what was appended.
  local d_from d_rc d_why
  d_from=$(wc -c < "$LOG_FILE" | tr -d ' ')
  "$VELO_DISPATCH" "$issue" "$brief" >> "$LOG_FILE" 2>&1
  d_rc=$?
  if [[ $d_rc -ne 0 ]]; then
    d_why=$(tail -c "+$((d_from + 1))" "$LOG_FILE" | grep -v '^[[:space:]]*$' | tail -n 6 | tr '\n' ' ' | tail -c 400)
    if attention_append "$(dispatch_attempt_id dispatch-failed "$issue")" "dispatch-failed" "" "$issue" "$brief_sha256" \
         "velo-dispatch failed for #$issue (worker:$worker; exit $d_rc) — nothing was dispatched and the entry is already popped, so re-queue it after resolving. Its last output: ${d_why:-<none>}"; then
      log "ESCALATE dispatch-failed #$issue (exit $d_rc)"
    fi
  fi
}

# ---- wedge + STOP detection -------------------------------------------------------

step_wedge_and_stop() {
  local d issue
  for d in $WORKTREE_GLOB; do
    [[ -d "$d" ]] || continue
    repo_owns "$d" || continue
    issue="${d##*-}"
    [[ "$issue" =~ ^[0-9]+$ ]] || issue="$(basename "$d")"

    if wt_stop_fired "$d"; then
      local stamp; stamp=$(wt_agentlog_last "$d")
      if attention_append "stop:$issue:$stamp" "stop" "" "$issue" "$stamp" \
           "agent.log in $d recorded a STOP-trigger activation."; then
        log "ESCALATE stop #$issue"
      fi
      continue   # a STOPped worker is not also a wedge
    fi

    local pid; pid=$(orch_running_pid_for "$d")
    [[ -n "$pid" ]] || continue
    local age; age=$(wt_agentlog_age_min "$d")
    [[ -n "$age" ]] || continue
    [[ "$age" -ge "$WEDGE_GRACE_MINUTES" ]] || continue
    [[ "$age" -ge "$WEDGE_MINUTES" ]] || continue
    local bucket=$(( age / WEDGE_MINUTES ))
    if attention_append "wedge:$issue:$bucket" "wedge" "" "$issue" "$bucket" \
         "agent.log in $d has not grown for ${age}m (pid $pid still alive; threshold ${WEDGE_MINUTES}m, grace ${WEDGE_GRACE_MINUTES}m)."; then
      log "ESCALATE wedge #$issue age=${age}m"
    fi
  done
}

# ---- launchd install / uninstall / status ----------------------------------------

usage() {
  cat <<'EOF'
velo-orchestrd — the always-on, LLM-free orchestration checker (#2285 PR2).

  velo-orchestrd [tick]      run one idempotent tick (default)
  velo-orchestrd install     install the launchd agent (runs every 300s)
  velo-orchestrd uninstall   remove the launchd agent
  velo-orchestrd status      launchd status + tail of the daemon log

Kill switch: touch ~/.agents/state/orch/paused to stop every future tick;
remove it to resume. Unhandled events: velo-attention list / ack.
EOF
}

cmd_install() {
  mkdir -p "$(dirname "$PLIST_DST")" "$ORCH_DIR"
  [[ -f "$PLIST_SRC" ]] || { echo "ERROR: no plist source at $PLIST_SRC" >&2; return 1; }
  sed "s#__BIN__#$HOME/.agents/bin#g; s#__HOME_DIR__#$HOME#g; s#__LOG__#$ORCH_DIR/orchestrd.log#g; s#__ERRLOG__#$ORCH_DIR/orchestrd.err.log#g" \
    "$PLIST_SRC" > "$PLIST_DST"
  launchctl bootout "gui/$(id -u)/$PLIST_LABEL" >/dev/null 2>&1
  launchctl bootstrap "gui/$(id -u)" "$PLIST_DST" \
    && launchctl enable "gui/$(id -u)/$PLIST_LABEL" \
    && echo "installed: $PLIST_DST (every 300s, logs to $ORCH_DIR/orchestrd.log)"
}

cmd_uninstall() {
  launchctl bootout "gui/$(id -u)/$PLIST_LABEL" >/dev/null 2>&1
  rm -f "$PLIST_DST"
  echo "uninstalled: $PLIST_DST"
}

cmd_status() {
  launchctl print "gui/$(id -u)/$PLIST_LABEL" 2>&1 | head -20
  echo
  echo "-- last 10 lines of $LOG_FILE --"
  tail -10 "$LOG_FILE" 2>/dev/null || echo "(no log yet)"
}

cmd_tick() {
  if is_paused; then
    log "PAUSED ($PAUSE_FILE exists) — skipping tick"
    echo "paused — $PAUSE_FILE exists"
    return 0
  fi
  check_gh_auth || { echo "gh auth failed — escalated, skipping tick"; return 1; }

  if ! acquire_lock; then
    log "lock held by another tick — skipping"
    echo "another tick is already running — skipping"
    return 0
  fi
  trap release_lock EXIT

  rotate_log_if_needed
  log "TICK start"
  step_workers
  step_gates
  step_merge
  step_dispatch
  step_wedge_and_stop
  log "TICK end"
  echo "tick complete"
}

main() {
  local cmd="${1:-tick}"
  # The launchd agent is Velostream's: one label, and a plist with no VELO_REPO in its environment.
  case "$cmd" in install|uninstall|status)
    [[ $REPO_IS_DEFAULT -eq 1 ]] \
      || { echo "ERROR: $cmd manages Velostream's launchd agent, not $REPO's — run VELO_REPO=$REPO velo-orchestrd tick from your own scheduler" >&2; return 1; } ;;
  esac
  case "$cmd" in
    tick) cmd_tick ;;
    install) cmd_install ;;
    uninstall) cmd_uninstall ;;
    status) cmd_status ;;
    -h|--help) usage ;;
    *) usage >&2; return 1 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
