#!/bin/bash
# velo-dispatch — validate a ticket is dispatch-ready, prepare its worktree,
# assign it, and launch the right worker.
#
# Usage:
#   velo-dispatch <issue> <brief-file> [--branch <name>] [--dry-run] [--force]
#                                      [--resume]
#
# --resume continues an EXISTING worktree instead of cutting a fresh one: the
# tree, the branch and the commits on it are left exactly as they are and a new
# worker is dispatched into them. For a run that stopped part-way — a STOP
# condition, a timeout, a killed session — where the alternative was --force,
# which deletes the branch and the commits with it.
#
# Exits non-zero with a specific message when the ticket is NOT ready, so a
# caller never burns a worker run on an under-specified task.
#
# Worker selection comes from the issue's `worker:*` label:
#   worker:local     -> qwen3-coder-next-mlx@6bit via LM Studio   (free)
#   worker:deepseek  -> deepseek/deepseek-v4-flash-0731           (very cheap)
#   worker:glm       -> z-ai/glm-5.3-flash                        (pricier)

set -uo pipefail

REPO="velostreamai/velostream"
ROOT="$HOME/RustroverProjects/velostream"
WORKTREE_BASE="$HOME/RustroverProjects"
# See velo-pr-gate's header: worker logs live under ~/.agents/state, not /tmp.
VELO_STATE="${VELO_STATE:-$HOME/.agents/state}"
POLICY="$HOME/.agents/rules/velo-impl.md"
ASSIGNEE="bluemonk3y"
MIN_DISK_GB=40
LMSTUDIO_URL="${VELO_LMSTUDIO_URL:-http://192.168.1.193:1234/v1}"
MAX_TURNS=250
PROMPT_TIMEOUT=14400

# Every decision this script makes goes through ok/warn/die and NOWHERE else, so
# teeing these three is a complete audit trail without touching stdout wiring.
#
# Until now none of it was captured. The preflight prints what it validated —
# anchors, blast radius, brief-vs-reality, the worktree it cut, whether the
# discovery index was built — and all of it scrolled past into a terminal
# nobody kept. That is exactly how `could NOT exclude the discovery index —
# NOT building it` printed on EVERY dispatch for days without being noticed:
# the feature was dead and the evidence was ephemeral.
#
# DLOG is empty until the state directory exists (see below), so early usage
# failures still work; those lines simply predate the log.
DLOG=""
_audit() { [[ -n "$DLOG" ]] && printf '%s %s\n' "$(date -u +%FT%TZ)" "$1" >> "$DLOG"; return 0; }
die()  { _audit "DIE  $1"; printf '\n\033[31mNOT READY:\033[0m %s\n\n' "$1" >&2; exit 1; }
warn() { _audit "WARN $1"; printf '\033[33mwarn:\033[0m %s\n' "$1" >&2; }
ok()   { _audit "OK   $1"; printf '\033[32m  ok\033[0m %s\n' "$1"; }

ISSUE="${1:-}"; BRIEF="${2:-}"; shift 2 2>/dev/null || true
BRANCH=""; DRY=0; FORCE=0; RESUME=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --branch) BRANCH="$2"; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    --force) FORCE=1; shift ;;
    --resume) RESUME=1; shift ;;
    *) die "unknown flag: $1" ;;
  esac
done

[[ -n "$ISSUE" && -n "$BRIEF" ]] || die "usage: velo-dispatch <issue> <brief-file> [--branch N] [--dry-run] [--force] [--resume]"
[[ "$ISSUE" =~ ^[0-9]+$ ]] || die "issue must be a number, got '$ISSUE'"

# Open the audit log now: the issue number is validated, so the path is safe to
# build, and everything from here on is a decision worth keeping.
mkdir -p "$VELO_STATE/dispatch/${ISSUE}" 2>/dev/null || true
DLOG="$VELO_STATE/dispatch/${ISSUE}/dispatch-$(date -u +%Y%m%dT%H%M%SZ).log"
: >> "$DLOG" 2>/dev/null || DLOG=""
# $* is empty here — the flag loop above already shifted them away — so record
# the PARSED mode instead, which is what an audit actually wants: --force is the
# flag that bypasses the triage-needed guard, and a dry run explains why no
# worktree or worker followed.
_audit "START issue=$ISSUE brief=$BRIEF dry_run=$DRY force=$FORCE branch=${BRANCH:-<auto>}"
[[ -f "$BRIEF" ]] || die "brief file not found: $BRIEF"
[[ -s "$BRIEF" ]] || die "brief file is empty: $BRIEF"

echo "── validating #$ISSUE ─────────────────────────────────"

# ---- 1. issue exists and is open -------------------------------------------
META=$(gh issue view "$ISSUE" --repo "$REPO" --json state,title,labels,assignees 2>/dev/null) \
  || die "issue #$ISSUE not found in $REPO (or gh not authenticated)"

STATE=$(jq -r .state <<<"$META")
TITLE=$(jq -r .title <<<"$META")
LABELS=$(jq -r '[.labels[].name] | join(",")' <<<"$META")

[[ "$STATE" == "OPEN" ]] || die "issue #$ISSUE is $STATE — nothing to dispatch.
  \"$TITLE\""
ok "open: $TITLE"

# ---- 2. blocking labels -----------------------------------------------------
if [[ ",$LABELS," == *",needs-design,"* ]]; then
  die "#$ISSUE is labelled 'needs-design'.
  A worker must never choose between design options.
  Either pin the design on the issue and remove the label, or dispatch a
  READ-ONLY analysis brief that presents options and stops."
fi
if [[ ",$LABELS," == *",blocked,"* ]]; then
  die "#$ISSUE is labelled 'blocked'.
  Resolve or remove the dependency first — see the issue for what it waits on."
fi
if [[ ",$LABELS," == *",triage-needed,"* ]]; then
  if [[ $FORCE -eq 0 ]]; then
    die "#$ISSUE is labelled 'triage-needed' — its claims may not match master.
  FOUR issues in one session turned out already-fixed. Verify the issue's
  file:line anchors against current master, then remove the label.
  Re-run with --force only if you have just verified it."
  fi
  warn "triage-needed present, proceeding under --force"
fi
ok "no blocking labels"

# ---- 3. routing: reconcile the label and the spec --------------------------
#
# Routing used to come from the GitHub label ALONE, while `.agents/tasks/SCHEMA.md`
# documented a `worker:` spec field as "-> routing" that NOTHING read (#2085). A
# documented field that does nothing does not stay consistent, and it did not:
# 3 of 27 specs disagreed with their issue's label.
#
# One of those disagreements ran the wrong model. #2000's spec said `glm`, the
# label said `deepseek`, and `2000.result.jsonl` records deepseek executing
# twice. A cheaper, weaker model ran than the spec asked for, the tracked spec
# still claims glm, and nothing anywhere reported a conflict. The other two
# (#2026 `codex`, #2046 `claude`) had a spec worker and NO label, so dispatch
# refused outright while holding the answer.
#
# So: read both, use whichever exists, and DIE when both exist and disagree.
# Choosing a winner silently is how #2000 happened; refusing when only one source
# is present is how #2026 happened. Neither failure is acceptable and the fix for
# both is to stop having an unreconciled second source of truth.
WORKERS=$(tr ',' '\n' <<<"$LABELS" | grep '^worker:' || true)
COUNT=$(grep -c . <<<"$WORKERS" || true)
[[ "$COUNT" -le 1 ]] || die "#$ISSUE has $COUNT worker labels ($(tr '\n' ' ' <<<"$WORKERS"))— at most one."
LABEL_WORKER=""
[[ "$COUNT" -eq 1 ]] && LABEL_WORKER="${WORKERS#worker:}"

SPEC_WORKER=""
SPEC_PATH="$ROOT/.agents/tasks/${ISSUE}.json"
if [[ -f "$SPEC_PATH" ]]; then
  SPEC_WORKER=$(python3 -c "
import json,sys
try: print(json.load(open('$SPEC_PATH')).get('worker') or '')
except Exception: print('')
" 2>/dev/null)
fi

# The label OVERRIDES the spec. They are not two competing sources of truth —
# the spec's `worker` is the proposal written before dispatch, and the label is
# the operator's live control, changeable without editing a versioned file. That
# is what happened on #2000: the spec proposed `glm`, the label said `deepseek`,
# deepseek ran. Working as designed, not a defect.
#
# Refusing on disagreement (the first cut of this change) would have BROKEN the
# override: re-routing by editing a label would start requiring a matching spec
# edit. The override is the feature.
#
# It is logged rather than silent, because "which model actually ran and why"
# should not need archaeology through a result record to answer.
if [[ -n "$LABEL_WORKER" && -n "$SPEC_WORKER" && "$LABEL_WORKER" != "$SPEC_WORKER" ]]; then
  warn "label '$LABEL_WORKER' overrides spec proposal '$SPEC_WORKER' for #$ISSUE"
fi

ROUTE="$LABEL_WORKER"
[[ -n "$ROUTE" ]] || die "#$ISSUE has no 'worker:*' label — routing is undefined.
    Add one of:
      worker:local     free, local Qwen3-Coder. Scoped impl + audits, slower.
      worker:deepseek  very cheap. Fast scoped impl against a PINNED design.
      worker:glm       pricier. Multi-step reasoning / per-case judgement.
      worker:codex     most capable, most expensive. Architecture-weight work:
                       anything where a WRONG answer costs more than the run.
                       On #1988 it found 2 P1s that two local gates missed while
                       both returned approve; on #1967 every load-bearing claim
                       in its analysis survived independent verification. glm
                       produced ZERO code in 186 turns on #1747."

# Validated against the ROUTABLE set, not just the label vocabulary: #2046's spec
# says `worker: claude`, which is not a transport this script has. Unroutable
# values must fail here, loudly, rather than later or silently.
case "$ROUTE" in
  local)    NAME="velo-local"; LOGTAG="velo-local" ;;
  deepseek) NAME="velo-deepseek"; LOGTAG="deepseek" ;;
  glm)      NAME="velo-glm"; LOGTAG="glm" ;;
  codex)    NAME="codex"; LOGTAG="codex" ;;
  *) die "unroutable worker '$ROUTE' (from ${LABEL_WORKER:+label}${LABEL_WORKER:-spec}).
    Routable: local, deepseek, glm, codex. See #2062 for opus/fable." ;;
esac
ok "routed to $NAME (label='${LABEL_WORKER:-none}' spec='${SPEC_WORKER:-none}')"

# ---- 3a. fetch, so `origin/master` is current ------------------------------
#
# Everything below validates against the REF, never the working tree: anchors
# via `git show origin/master:<file>`, blast radius via `git grep origin/master`.
# That is the tree the worker's worktree is cut from, so it is the only one
# whose contents mean anything here.
#
# This used to read the local checkout, and then briefly REFUSED to run unless
# the checkout equalled origin/master — which fixed the correctness hole by
# handing the tool's job to the operator, and fired twice in one hour. Reading
# the ref removes the requirement instead of enforcing it: a stale, dirty, or
# mid-rebase checkout is now simply irrelevant to validation.
git -C "$ROOT" fetch -q origin || die "git fetch failed"
# A worktree directory removed by hand leaves its registration behind, and
# `git branch -D` then refuses forever — --force included (#2012 M4). Pruning is
# the documented fix and appeared nowhere in this script.
git -C "$ROOT" worktree prune 2>/dev/null || true
# Resolve ONCE. Every gate below used to re-resolve the symbolic ref, so a merge
# landing mid-validation gave the worker a tree the anchors never described —
# and the self-check compared against that same new ref, making the mismatch
# invisible in every output (#2012 M1). This is #1965 through a narrower window.
BASE_SHA=$(git -C "$ROOT" rev-parse origin/master) || die "cannot resolve origin/master"
ok "validating against origin/master (${BASE_SHA:0:9}) — pinned for this run"

# ---- 3b. task spec sidecar (authoritative when present) ---------------------
SPEC="$ROOT/.agents/tasks/${ISSUE}.json"
if [[ -f "$SPEC" ]]; then
  y() { python3 -c "
import json
d=json.load(open('$SPEC'))
for p in '$1'.split('.'):
    d = d.get(p) if isinstance(d,dict) else None
print('' if d is None else (json.dumps(d) if isinstance(d,(list,dict)) else d))
" 2>/dev/null; }

  [[ "$(y design)" == "pinned" ]] || die "spec: design is '$(y design)', must be 'pinned'.
  A worker never chooses between design options. Pin it on the issue first."

  EV=$(y evidence); AU=$(y audit)
  if [[ -n "$EV" && "$EV" != "code" ]]; then
    [[ "$AU" == done:* ]] || die "spec: evidence='$EV' (not a code read) and audit='$AU'.
  Claims sourced from a spec or another agent's report must be audited against
  code first — four issues in one session were stale for exactly this reason.
  Set audit: done:<sha> after auditing."
  fi

  DEPS=$(y depends_on)
  if [[ -n "$DEPS" && "$DEPS" != "null" ]]; then
    # `tr -d` already deletes the commas, so the old second `tr ',' ' '` split
    # nothing and [1956, 1958] collapsed to the single token 19561958 (#2012 M2).
    for d in $(python3 -c 'import json,sys; print(" ".join(str(x) for x in json.loads(sys.argv[1])))' "$DEPS" 2>/dev/null); do
      [[ -n "$d" ]] || continue
      DS=$(gh issue view "$d" --repo "$REPO" --json state --jq .state 2>/dev/null)
      [[ "$DS" == "CLOSED" ]] || die "spec: depends_on #$d is $DS — must be CLOSED before dispatch."
    done
    [[ -n "$(python3 -c 'import json,sys; print(len(json.loads(sys.argv[1])))' "$DEPS" 2>/dev/null)" ]] \
      || die "spec: depends_on is not valid JSON: $DEPS"
    ok "dependencies closed"
  fi

  # ---- REVIEW ATTESTATION + SPEC-vs-ISSUE DRIFT -----------------------------
  #
  # Every other check here asks "does the spec still match the CODE?". Neither
  # asked "does it still match the ISSUE?", nor "did anyone review it?".
  #
  # Both gaps are load-bearing. A spec is authored against an issue at a moment
  # in time; the issue then acquires a ruling, a correction, or a scope cut, and
  # the brief silently contradicts it. That happened repeatedly in one session:
  # a worker was briefed to "emit every legal spelling" hours after the issue
  # recorded that doing so IS the defect; another was briefed on a failure count
  # the issue had already corrected. Anchors were green both times, because the
  # code had not moved — the INTENT had.
  #
  # So: the spec must carry a `reviewed` block, and both halves are checked.
  #
  #   "reviewed": {
  #     "by":          "<who>",              # a name, not a role
  #     "at":          "2026-09-01T19:00:00Z",
  #     "brief_sha256": "<sha256 of the brief file>"
  #   }
  #
  # brief_sha256 pins the BRIEF, not just the spec: editing the brief after
  # review is the easiest way to smuggle unreviewed instructions to a worker,
  # and it is exactly what an orchestrator does mid-flight when it is in a hurry.
  REV=$(y reviewed.by); REV_AT=$(y reviewed.at); REV_SHA=$(y reviewed.brief_sha256)

  # `brief_sha256` is REQUIRED, not optional-if-present (#2012 H2). It used to be
  # guarded by `[[ -n "$REV_SHA" && … ]]`, so omitting the field — the fiddliest
  # one to write by hand — silently disabled brief-pinning while the ok line
  # below still announced "brief hash matches". A gate you can switch off by
  # leaving a field out, which then claims it ran, is worse than no gate.
  [[ -n "$REV" && -n "$REV_AT" && -n "$REV_SHA" ]] || die "spec: incomplete 'reviewed' block.
  All three fields are required — by/at attest that someone read the spec against
  the issue, brief_sha256 pins the BRIEF they read. Editing the brief after
  review is the easiest way to smuggle unreviewed instructions to a worker.

    \"reviewed\": { \"by\": \"<who>\", \"at\": \"$(date -u +%FT%TZ)\",
                  \"brief_sha256\": \"$(shasum -a 256 "$BRIEF" | cut -d" " -f1)\" }"

  BRIEF_NOW=$(shasum -a 256 "$BRIEF" | cut -d' ' -f1)
  if [[ "$REV_SHA" != "$BRIEF_NOW" ]]; then
    die "spec: THE BRIEF CHANGED SINCE REVIEW.
  reviewed.brief_sha256 = $REV_SHA
  actual                = $BRIEF_NOW
  Editing the brief after review sends a worker instructions nobody checked
  against the issue. Re-read it, then update reviewed.at and brief_sha256."
  fi
  ok "brief hash matches reviewed.brief_sha256"

  # Spec-vs-issue drift. `updatedAt` moves on edits AND on new comments, which
  # is what we want: a ruling posted as a comment is the commonest way a brief
  # goes stale, and it is invisible to every code-based check above.
  #
  # This must FAIL CLOSED (#2012 H3). `set -e` is off and stderr is discarded, so
  # a rate-limit, expired token or transient 5xx produced an empty string, the
  # `-n` guard skipped the comparison, and the ok line still reported "issue
  # unchanged since" — a rubber stamp on the exact failure this was built for.
  ISSUE_UPD=$(gh issue view "$ISSUE" --repo "$REPO" --json updatedAt --jq .updatedAt 2>/dev/null)
  [[ -n "$ISSUE_UPD" ]] || die "spec: could not re-read #$ISSUE to check for drift.
  gh returned nothing (rate limit, expired token, or network). Refusing rather
  than skipping: an unanswered drift check is not a passed one."
  if [[ "$ISSUE_UPD" > "$REV_AT" ]]; then
    die "spec: ISSUE MOVED AFTER REVIEW — the brief may contradict it.
  reviewed.at      = $REV_AT
  issue updatedAt  = $ISSUE_UPD
  #$ISSUE was edited or commented after this spec was reviewed. Read what
  changed (gh issue view $ISSUE --comments), reconcile the brief, then bump
  reviewed.at. Anchors passing means the CODE did not move; it says nothing
  about the intent.

  NOTE: a PREVIOUS dispatch of this issue bumps updatedAt by assigning it, so
  a re-dispatch can trip this on a change the tooling itself made (#2012 L3).
  Check the timeline before assuming someone edited the issue."
  fi
  ok "reviewed by $REV at $REV_AT; issue unchanged since"

  # Anchors: SYMBOLS re-verified against the tree. Line numbers rot; symbols do not.
  ANCH=$(y anchors)
  if [[ "$ANCH" != "[]" && -n "$ANCH" ]]; then
    STALE=$(python3 - "$ROOT" "$SPEC" "$BASE_SHA" <<'PYA'
import sys, json, subprocess
root, spec, base = sys.argv[1], sys.argv[2], sys.argv[3]

def at_origin(path):
    """File content as it exists at origin/master — NOT in the working tree.

    The worker's worktree is cut off origin/master, so that is the only tree
    whose contents matter. Reading the local checkout meant validation could
    describe code the worker would never see: a stale checkout once reported a
    test file MISSING and a blast radius short by 6, both of which looked like
    errors in the brief and were not."""
    r = subprocess.run(["git", "-C", root, "show", f"{base}:{path}"],
                       capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else None

bad=[]
for a in (json.load(open(spec)) or {}).get("anchors") or []:
    f, sym, exp = a.get("file"), a.get("symbol"), a.get("expect")
    # A comment is not an anchor. SCHEMA.md sells these as "SYMBOLS, never line
    # numbers", but the check is a substring count over raw file text, so a
    # comment left behind by a refactor keeps reporting "verified" for code that
    # moved (#2012 L1). Two of #1959's three anchors were comments.
    if sym and sym.lstrip().startswith(("//", "#", "/*", "*")):
        bad.append(f"{f}: anchor {sym[:40]!r} is a COMMENT, not a symbol — "
                   "a refactor can move the code and leave it behind")
        continue
    content = at_origin(f)
    if content is None:
        bad.append(f"{f}: FILE MISSING at origin/master"); continue
    n = content.count(sym)
    if n == 0:
        bad.append(f"{f}: symbol '{sym}' NOT FOUND at origin/master")
    elif exp is not None and n != exp:
        bad.append(f"{f}: '{sym}' found {n}x at origin/master, spec says {exp}x")
print("\n".join(bad))
PYA
)
    [[ -z "$STALE" ]] || die "spec: ANCHORS ARE STALE — the issue describes code that has moved.
$STALE
  Re-verify against master, update .agents/tasks/${ISSUE}.json, then retry."
    ok "anchors verified against origin/master"
  fi

  # Blast radius: COMPUTE it. An author's estimate produced '1 call site' for 66.
  BRP=$(y blast_radius.pattern); BRR=$(y blast_radius.refs); BRF=$(y blast_radius.files)
  if [[ -n "$BRP" && -n "$BRR" ]]; then
    # `git grep <ref>` reads the REF, so this measures the same tree the worker
    # gets rather than whatever happens to be checked out locally.
    # -o counts REFERENCES, not matching lines: -c undercounts any line using the
# symbol twice (#2012 M5).
    ACT=$(git -C "$ROOT" grep -F -o "$BRP" "$BASE_SHA" -- src tests examples 2>/dev/null | wc -l | tr -d ' ')
    DELTA=$(( ACT > BRR ? ACT - BRR : BRR - ACT ))
    LIM=$(( BRR / 10 + 2 ))
    [[ "$DELTA" -le "$LIM" ]] || die "spec: BLAST RADIUS MISMATCH for '$BRP'.
  declared $BRR refs, actually $ACT (git grep of origin/master over src/ tests/ examples/).
  A wrong estimate is how a worker burned its entire budget hand-editing 66
  call sites it was told was one. Re-measure and update the spec."
    # SCHEMA.md promises "computed refs/FILES vs declared -> refuse on mismatch"
    # and files was never read. Both live specs declared 0 and passed (#2012 M5).
    if [[ -n "$BRF" && "$BRF" != "null" ]]; then
      ACTF=$(git -C "$ROOT" grep -F -l "$BRP" "$BASE_SHA" -- src tests examples 2>/dev/null | wc -l | tr -d ' ')
      DELTAF=$(( ACTF > BRF ? ACTF - BRF : BRF - ACTF ))
      LIMF=$(( BRF / 10 + 2 ))
      [[ "$DELTAF" -le "$LIMF" ]] || die "spec: BLAST RADIUS FILE COUNT MISMATCH for '$BRP'.
  declared $BRF files, actually $ACTF.
  A declared 0 used to pass silently — SCHEMA.md says this is enforced."
      ok "blast radius: $ACT refs / $ACTF files (declared $BRR / $BRF)"
    else
      ok "blast radius: $ACT refs (declared $BRR); files not declared"
    fi
  fi


  # >>> velo-fail-to-pass (extracted verbatim by tests/test_fail_to_pass.sh)
  # ---- the acceptance gate must NAME TESTS THAT EXIST ------------------------
  #
  # `tests.fail_to_pass` is what decides whether a run worked. Every other check
  # here validated the WORK (anchors, blast radius, deps, brief shape) and
  # nothing validated the GATE — so a spec could name tests that do not exist and
  # dispatch would happily proceed.
  #
  # It did. #1958 declared `enforced_files_covers_every_executable_sql_doc` and
  # `ungated_block_register_matches_reality`; neither is defined anywhere in the
  # tree (`cargo nextest run <name>` matches zero tests). That dispatch LANDED
  # with 6 commits — a run reporting success while its acceptance gate named
  # nothing. A paid Codex spec review found it; this is a grep.
  #
  # Deliberately a NAME-EXISTENCE check, not a run: compiling the suite costs
  # minutes and the dispatch has not even cut a worktree yet. A name that matches
  # no `fn` is wrong regardless of whether it would pass — and that is the case
  # that actually occurred.
  FTP=$(y tests.fail_to_pass)
  if [[ -n "$FTP" && "$FTP" != "null" && "$FTP" != "[]" ]]; then
    FTP_MISSING=()
    FTP_COUNT=0
    while IFS= read -r tname; do
      [[ -n "$tname" ]] || continue
      FTP_COUNT=$((FTP_COUNT + 1))
      # Match the definition, not a mention: a name appearing only in a comment,
      # a spec file or another test's body is not a test. `git grep` against the
      # pinned BASE_SHA, like every other check here, so a dirty working tree
      # cannot make a missing test look present.
      if ! git -C "$ROOT" grep -qE "fn[[:space:]]+${tname}[[:space:]]*\(" "$BASE_SHA" -- tests src 2>/dev/null; then
        FTP_MISSING+=("$tname")
      fi
    done < <(python3 -c "
import json,sys
try:
    v=json.loads(sys.argv[1])
except Exception:
    sys.exit(0)
for t in (v if isinstance(v,list) else [v]):
    print(t)
" "$FTP" 2>/dev/null)

    if [[ ${#FTP_MISSING[@]} -gt 0 ]]; then
      die "spec: fail_to_pass NAMES TESTS THAT DO NOT EXIST at ${BASE_SHA:0:9}.
    missing: ${FTP_MISSING[*]}
    These are the tests that decide whether the run succeeded. A name matching no
    'fn <name>(' gates nothing: the worker can finish, the suite can pass, and the
    dispatch lands having proven nothing. #1958 landed 6 commits exactly that way.
    Fix the names in .agents/tasks/${ISSUE}.json, or add the tests first."
    fi
    ok "fail_to_pass: $FTP_COUNT test(s) exist at ${BASE_SHA:0:9}"
  fi
  # <<< velo-fail-to-pass

  BEHIND=$(git -C "$ROOT" rev-list --count "$(y verified_against)..origin/master" 2>/dev/null || echo "?")
  [[ "$BEHIND" == "0" || "$BEHIND" == "?" ]] && ok "spec verified at current master" \
    || warn "spec verified $BEHIND commits behind master (anchors still check out)"
else
  warn "no task spec at .agents/tasks/${ISSUE}.json — validating brief only.
       See .agents/tasks/SCHEMA.md; a spec enables anchor + blast-radius checks."
fi

# ---- 4. brief sanity — cheap checks against velo-brief-spec.md --------------
#
# The brief's own BRANCH:/WORKTREE: lines are MECHANICAL CLAIMS, and until #2004
# nothing compared them to what this script was about to cut. On #2000 the brief
# said `fix/2000-nullpad-union`, velo-dispatch cut `fix/2000-auto`, and all eight
# preflight checks passed — the mismatch printed two lines apart with nothing
# reading both. A worker that believes the brief commits to a branch velo-status
# and velo-merge never look at, and its self-report is TRUE while the dispatch
# branch sits empty.
[[ -n "$BRANCH" ]] || BRANCH="fix/${ISSUE}-auto"
WT="$WORKTREE_BASE/velostream-$ISSUE"

# Two declaration forms exist in this repo: `BRANCH: x` and a `## Branch`
# heading with the value on a following line. Read both (#2027 P1).
brief_field() {   # $1 = field name -> its declared value, or empty
  local f="$1"
  grep -iE "^[[:space:]]*${f}:" "$BRIEF" | head -1 \
    | sed -E "s/^[[:space:]]*${f}:[[:space:]]*//; s/[[:space:]]*\(.*//; s/[[:space:]]*\$//" | tr -d '`'
  }
brief_heading_line() {   # $1 = heading name -> first non-empty line beneath it
  awk -v f="$1" 'BEGIN{IGNORECASE=1}
    $0 ~ "^##+[[:space:]]*" f "[[:space:]]*$" {g=1; next}
    g && /^#/ {exit}
    g && NF { print; exit }' "$BRIEF"
}
# The heading form puts BOTH declarations on one prose line, e.g.
#   fix/1937-auto — worktree at ~/RustroverProjects/velostream-1937. Do NOT cd …
# Returning that whole line made all five heading-form briefs mismatch and, with
# the new hard-fail, undispatchable (#2027 re-review P1). Extract the TOKEN, not
# the sentence.
brief_heading_branch() {
  brief_heading_line Branch | sed -E 's/^[[:space:]]*[-*`]*[[:space:]]*//' \
    | awk '{print $1}' | tr -d '`' | sed -E 's/[.,;:]+$//'
}
path_token() {   # first ABSOLUTE path in a line
  # Anchored at a token boundary: unanchored, `~?/...` matched the slash INSIDE
  # a branch name (`fix/1934-x` -> `/1934-x`). Backtick and open-paren count as
  # boundaries because the real briefs write `~/RustroverProjects/...`.
  #
  # Only whitespace and backtick terminate the path. `,` and `)` are POSIX-legal
  # in a path (#2027 P2), so they are stripped only when TRAILING — which still
  # handles prose like "…/tree, then work in …" because the space ends the token.
  grep -oE '(^|[[:space:]]|`|\()~?/[^[:space:]`]+' <<<"$1" | head -1 \
    | sed -E 's/^[[:space:]`(]+//; s/[.,;:)]+$//' \
    | sed -E "s#^~#$HOME#"
}

path_token_count() {   # how many distinct absolute paths a line names
  grep -oE '(^|[[:space:]]|`|\()~?/[^[:space:]`]+' <<<"$1" \
    | sed -E 's/^[[:space:]`(]+//; s/[.,;:)]+$//' | sort -u | wc -l | tr -d ' '
}

brief_heading_worktree() {
  # A DECLARED `## Worktree` section wins absolutely. Concatenating both sections
  # let a path merely CITED in Branch prose beat a declared one (#2027 round-3).
  local line
  line=$(brief_heading_line Worktree)
  if [[ -n "$line" ]]; then
    path_token "$line"
    return 0
  fi
  # Fallback: the path lives in the Branch prose. If that prose names SEVERAL
  # paths we cannot tell which is the worktree, and guessing produces a false
  # refusal (#2027 P2). Return nothing and let the caller skip, not refuse.
  line=$(brief_heading_line Branch)
  [[ "$(path_token_count "$line")" -le 1 ]] || return 0
  path_token "$line"
}
BRIEF_BRANCH=$(brief_field BRANCH); [[ -n "$BRIEF_BRANCH" ]] || BRIEF_BRANCH=$(brief_heading_branch)
if [[ -n "$BRIEF_BRANCH" && "$BRIEF_BRANCH" != "$BRANCH" ]]; then
  die "brief BRANCH does not match the branch this dispatch will cut.
  brief says : $BRIEF_BRANCH
  will cut   : $BRANCH
  A worker that follows the brief commits somewhere velo-status and velo-merge
  do not look, and reports success truthfully while the dispatch branch is empty.
  Fix the brief, or pass --branch $BRIEF_BRANCH to cut what it names."
fi

BRIEF_WT=$(brief_field WORKTREE); [[ -n "$BRIEF_WT" ]] || BRIEF_WT=$(brief_heading_worktree)

# Absent is a FAILURE, not a skip. velo-brief-spec §1 requires both; treating an
# unparseable value as "nothing to check" is how the first cut passed every
# `## Branch` brief without comparing anything (#2027 P1).
[[ -n "$BRIEF_BRANCH" ]] || die "brief declares no BRANCH.
  velo-brief-spec §1 requires it, and without it nothing verifies the worker is
  sent to the branch this dispatch cuts. Add either form:
    BRANCH: $BRANCH        or        ## Branch\n$BRANCH"
if [[ -z "$BRIEF_WT" ]]; then
  # Order matters. A DECLARED worktree that yields no path is a MALFORMED brief
  # and must refuse — it must never reach the ambiguity skip below (#2027 round-5
  # P1). The skip exists only for the case where nothing was declared and the
  # Branch prose names several paths, which cannot be disambiguated.
  if [[ -n "$(brief_heading_line Worktree)" || -n "$(brief_field WORKTREE)" ]]; then
    die "brief declares a WORKTREE but no path could be read from it.
  Found the declaration, found no path in it. That is a malformed brief, not an
  ambiguous one — fix the declaration rather than removing it:
    WORKTREE: $WT"
  elif [[ "$(path_token_count "$(brief_heading_line Branch)")" -gt 1 ]]; then
    warn "brief WORKTREE not compared: nothing declares one, and the Branch line
       names several paths, which prose cannot disambiguate. Add an explicit
       '## Worktree' section or a 'WORKTREE:' line to have this checked."
  else
    die "brief declares no WORKTREE.
  velo-brief-spec §1 requires it — add 'WORKTREE: $WT' or a '## Worktree' section."
  fi
elif [[ "${BRIEF_WT%/}" != "${WT%/}" ]]; then
  # RESTORED (#2027 round-6 P1). The round-5 rewrite replaced this whole block to
  # reorder the empty-value cases and took the comparison out with it, so any
  # non-empty but WRONG worktree — `WORKTREE: /tmp/other` — sailed past and the
  # script printed "BRANCH/WORKTREE match what will be cut". The check this PR
  # exists to add, deleted by a fix to the check, while still claiming to pass.
  die "brief WORKTREE does not match the worktree this dispatch will use.
  brief says : $BRIEF_WT
  will use   : $WT
  Same failure as the BRANCH mismatch: the worker works somewhere nobody reads."
fi
ok "brief BRANCH/WORKTREE match what will be cut"

MISSING=()
grep -qi "worktree" "$BRIEF"                  || MISSING+=("no WORKTREE path (spec §1)")
grep -qiE "do not.*cd|don't.*cd" "$BRIEF"     || MISSING+=("no 'do NOT cd' instruction (spec §1)")
grep -qiE "STOP and report|STOP —|STOP if"    "$BRIEF" || MISSING+=("no STOP conditions (spec §5)")
grep -qiE "commit incrementally|commit after each" "$BRIEF" || MISSING+=("no incremental-commit rule (spec §12) — a timeout will lose all work")
grep -qiE "cargo (check|nextest)" "$BRIEF"    || MISSING+=("no validation commands (spec §7)")
grep -qiE "do not commit|may commit|commit and push|do not push|do not open a pr|authorized to (commit|push)" "$BRIEF" \
  || MISSING+=("no explicit commit/push authorization (spec §8) — the brief is the only thing telling a worker what it may do")
if grep -qiE "\.sql|SELECT .* FROM" "$BRIEF"; then
  grep -q "SQL_GRAMMAR_RULES\|PARSER_GRAMMAR" "$BRIEF" \
    || MISSING+=("brief writes SQL but cites no grammar reference (spec §6)")
fi
if [[ ${#MISSING[@]} -gt 0 ]]; then
  printf '\n\033[31mBRIEF INCOMPLETE:\033[0m %s\n' "$BRIEF" >&2
  printf '  - %s\n' "${MISSING[@]}" >&2
  printf '\nSee %s\n\n' "$HOME/.agents/rules/velo-brief-spec.md" >&2
  exit 1
fi
ok "brief satisfies the spec checklist"

# ---- 5. disk ----------------------------------------------------------------
AVAIL=$(df -g "$HOME" | awk 'NR==2 {print $4}')
[[ "$AVAIL" -ge "$MIN_DISK_GB" ]] || die "only ${AVAIL}GB free; each worktree target/ is ~20GB.
  A full disk kills workers with errors that look like compile bugs.
  Free space (rm -rf <merged-worktree>/target) then retry."
ok "disk: ${AVAIL}GB free"

# ---- 6. worktree ------------------------------------------------------------
[[ -n "$BRANCH" ]] || BRANCH="fix/${ISSUE}-auto"
WT="$WORKTREE_BASE/velostream-$ISSUE"

# (fetch already done in section 3a, before anchors were measured)
BASE="${BASE_SHA:0:9}"

if [[ $DRY -eq 1 ]]; then
  echo
  echo "DRY RUN — would do:"
  # A dry run that cannot describe the worktree it would use is the specific gap
  # #1914 names: it "reports a clean plan for a dispatch that would refuse (or
  # destroy) in reality". Say which of the three things will happen — resume,
  # cut fresh, or refuse — because those differ in whether commits survive.
  if [[ $RESUME -eq 1 ]]; then
    if [[ -d "$WT" ]]; then
      DR_BR=$(git -C "$WT" branch --show-current 2>/dev/null)
      DR_AHEAD=$(git -C "$WT" log --oneline "origin/master..HEAD" 2>/dev/null | wc -l | tr -d ' ')
      DR_DIRTY=$(git -C "$WT" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
      echo "  worktree : $WT  (RESUMED — kept as-is)"
      echo "             on '$DR_BR', $DR_AHEAD commit(s) ahead, $DR_DIRTY dirty; nothing reset"
      [[ "$DR_BR" == "$BRANCH" ]] \
        || echo "             WOULD REFUSE: on '$DR_BR', this dispatch targets '$BRANCH'"
    else
      echo "  worktree : $WT  (WOULD REFUSE — --resume but no worktree there)"
    fi
  elif [[ -d "$WT" ]]; then
    DR_AHEAD=$(git -C "$WT" log --oneline "origin/master..HEAD" 2>/dev/null | wc -l | tr -d ' ')
    DR_DIRTY=$(git -C "$WT" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    if [[ "$DR_AHEAD" != "0" || "$DR_DIRTY" != "0" ]]; then
      if [[ $FORCE -eq 1 ]]; then
        echo "  worktree : $WT  (--force: WOULD DESTROY $DR_AHEAD commit(s), $DR_DIRTY dirty)"
      else
        echo "  worktree : $WT  (WOULD REFUSE — has $DR_AHEAD commit(s), $DR_DIRTY dirty)"
        echo "             --resume to keep them, --force to discard them"
      fi
    else
      echo "  worktree : $WT  (branch $BRANCH off origin/master $BASE — existing tree is clean, recreated)"
    fi
  else
    echo "  worktree : $WT  (branch $BRANCH off origin/master $BASE)"
  fi
  echo "  assign   : #$ISSUE -> $ASSIGNEE"
  echo "  worker   : $NAME"
  echo "  brief    : $BRIEF"
  # The real run TIMESTAMPS this (see LOG= below) so a re-dispatch cannot
  # overwrite the log velo-record reads for the previous run's cost (#2012 M3).
  # This line printed the untimestamped name — a path that never exists. A dry
  # run telling the operator where to look, wrongly.
  echo "  log      : $VELO_STATE/dispatch/${ISSUE}/${LOGTAG}-<UTC timestamp>.log"
  exit 0
fi

# A worker's tree is CUT FROM THE FETCHED REF, never inherited from whatever is
# lying around on disk.
#
# This used to reuse an existing directory when it looked "clean" (no local
# edits, no commits of its own). But a worktree left by an EARLIER dispatch of
# the same issue scores exactly that — 0 dirty, 0 ahead — so it was
# indistinguishable from a fresh one, and #1965's worker was handed a tree 15
# commits behind master while the script printed "off origin/master <sha>". It
# never saw #1969 or #1988; its 21 failures were stale-base artefacts, and the
# brief written from them told it to preserve an escape hatch master had
# already deleted.
#
# Adding a "behind" check to the reuse path would only narrow that hole. The
# reuse path itself is the defect: there is no reason to inherit a tree when
# cutting a new one from `origin/master` costs a second and is unambiguous.
# `origin/master` here is the ref fetched in section 3a — the same ref every
# other gate (anchors, blast radius, spec drift) validates against, so the
# worker's tree and the validation now agree by construction.
if [[ $RESUME -eq 1 ]]; then
  # ---- resume: keep the tree, keep the branch, keep the commits --------------
  #
  # The refusal in the `elif` below used to tell the operator to "dispatch with
  # --worktree" — a flag this script has never accepted; its own parser answers
  # `unknown flag: --worktree`. So the documented way to KEEP work did not exist,
  # and the only flag that did work was --force, which deletes the branch and the
  # commits with it. That is the whole of #1914.
  #
  # Resume validates and then does NOTHING to the tree. Every check refuses
  # rather than repairs: a resume that quietly fixes up a tree is
  # indistinguishable from the --force it exists to replace.
  [[ $FORCE -eq 0 ]] || die "--resume and --force are opposites.
  --resume keeps the existing worktree and its commits; --force deletes them.
  Pick one."

  [[ -d "$WT" ]] || die "--resume needs an existing worktree at $WT, and there is none.
  Nothing to resume — dispatch normally and one will be cut from origin/master."

  RES_BRANCH=$(git -C "$WT" branch --show-current 2>/dev/null)
  [[ -n "$RES_BRANCH" ]] || die "worktree $WT is not on a branch (detached HEAD).
  Resuming would commit somewhere nothing tracks. Check it out on a branch first."
  if [[ "$RES_BRANCH" != "$BRANCH" ]]; then
    die "worktree $WT is on '$RES_BRANCH', but this dispatch targets '$BRANCH'.
  Resuming would put the worker on a branch velo-status and velo-merge are not
  watching for this issue. Either pass --branch $RES_BRANCH to resume that one,
  or check the worktree out on $BRANCH first."
  fi

  # A tree stopped mid-rebase or mid-merge has conflict markers in its files and
  # a HEAD that is not what anyone thinks. A worker dispatched into it edits
  # around the markers and commits the result.
  RES_GITDIR=$(git -C "$WT" rev-parse --git-dir 2>/dev/null)
  for state in rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD; do
    if [[ -e "$RES_GITDIR/$state" ]]; then
      die "worktree $WT is mid-${state}.
  Finish or abort it before resuming — a worker cannot tell a conflict marker
  from code."
    fi
  done

  RES_DIRTY=$(git -C "$WT" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  RES_AHEAD=$(git -C "$WT" log --oneline "origin/master..HEAD" 2>/dev/null | wc -l | tr -d ' ')
  RES_BEHIND=$(git -C "$WT" rev-list --count "HEAD..origin/master" 2>/dev/null || echo "?")
  ok "resuming $WT on $RES_BRANCH ($RES_AHEAD commit(s), $RES_DIRTY dirty, $RES_BEHIND behind origin/master)"

  # Unpushed commits are exactly what --force destroys, and the reason this flag
  # exists. Say so with the number, every time: pushing first makes the loss
  # impossible, and nothing else in this script will tell you.
  if git -C "$ROOT" rev-parse --verify --quiet "refs/remotes/origin/$BRANCH" >/dev/null 2>&1; then
    RES_UNPUSHED=$(git -C "$WT" log --oneline "origin/$BRANCH..HEAD" 2>/dev/null | wc -l | tr -d ' ')
  else
    RES_UNPUSHED="$RES_AHEAD"
  fi
  if [[ "$RES_UNPUSHED" != "0" ]]; then
    warn "$RES_UNPUSHED commit(s) on $BRANCH are NOT on origin."
    warn "  A --force dispatch on this branch would delete them, and this is the"
    warn "  work you are resuming. Make it durable first:"
    warn "    git -C $WT push -u origin $BRANCH"
  fi
  if [[ "$RES_BEHIND" != "0" && "$RES_BEHIND" != "?" ]]; then
    warn "the tree is $RES_BEHIND commit(s) behind origin/master."
    warn "  The anchors and blast radius validated above describe origin/master —"
    warn "  a tree the worker is NOT looking at. Rebase first if the brief depends"
    warn "  on anything that landed since."
  fi
elif [[ -d "$WT" ]]; then
  DIRTY=$(git -C "$WT" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  AHEAD=$(git -C "$WT" log --oneline origin/master..HEAD 2>/dev/null | wc -l | tr -d ' ')
  if [[ "$DIRTY" != "0" || "$AHEAD" != "0" ]]; then
    [[ $FORCE -eq 1 ]] || die "worktree $WT already exists and HAS WORK ($DIRTY dirty, $AHEAD commits).
  It will not be reused or reset silently — inspect it first.
    git -C $WT log --oneline origin/master..HEAD
  Keep it and continue the work:  re-run with --resume
  Discard it and start over:      re-run with --force"
    warn "discarding existing worktree with work ($DIRTY dirty, $AHEAD commits) — --force"
  fi
  # `agent.log` is git-IGNORED but MANDATED by the implementation policy as the
  # worker's append-only reasoning trail — the record of why a run did what it
  # did, and what a post-mortem reads. DIRTY counts tracked files only, so a
  # completed worktree carrying nothing but agent.log scores 0/0 and would be
  # removed here WITHOUT the caller passing --force. Preserve it first.
  if [[ -f "$WT/agent.log" ]]; then
    KEEP="$WORKTREE_BASE/agent-logs/${ISSUE}-$(date -u +%Y%m%dT%H%M%SZ).log"
    mkdir -p "$(dirname "$KEEP")"
    cp "$WT/agent.log" "$KEEP" 2>/dev/null \
      && warn "preserved worker reasoning trail: $KEEP"
  fi
  git -C "$ROOT" worktree remove "$WT" --force >/dev/null 2>&1 \
    || die "could not remove existing worktree $WT"
  ok "removed stale worktree $WT (recreating from origin/master)"
fi

# Everything from here to the behind-master assertion CUTS A FRESH TREE, so none
# of it may run on a resume: the branch-delete would refuse (or with --force,
# destroy the very commits being resumed), `worktree add` would fail because the
# worktree exists, and the assertion would fire because a resumed tree is behind
# origin/master by design.
if [[ $RESUME -eq 0 ]]; then

# The branch may also survive an earlier dispatch. Delete it only when it has no
# commits of its own; otherwise refuse rather than silently discard someone's work.
if git -C "$ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
  BR_AHEAD=$(git -C "$ROOT" rev-list --count "origin/master..$BRANCH" 2>/dev/null || echo 0)
  if [[ "$BR_AHEAD" != "0" ]]; then
    [[ $FORCE -eq 1 ]] || die "branch '$BRANCH' already exists with $BR_AHEAD commit(s) not on master.
  Cutting a fresh worktree would abandon them.
    git -C $ROOT log --oneline origin/master..$BRANCH
  Keep them:    re-run with --resume — continues this branch, destroys nothing.
  Discard them: re-run with --force, or use --branch fix/${ISSUE}-v2."
    warn "deleting branch $BRANCH with $BR_AHEAD commit(s) — --force"
  fi
  # `branch -D` prints "Deleted branch X (was <sha>)" — the easiest recovery path
# for work this flag just discarded. It was sent to /dev/null (#2012 L5).
DELETED=$(git -C "$ROOT" branch -D "$BRANCH" 2>&1) \
    || die "could not delete existing branch $BRANCH"
fi

git -C "$ROOT" worktree add "$WT" -b "$BRANCH" "$BASE_SHA" -q \
  || die "could not create worktree $WT on branch $BRANCH off origin/master"
ok "worktree cut from origin/master: $WT ($BRANCH @ $BASE)"

# Assert it, rather than trusting the command above — this is the dispatcher's
# one core promise and it is the thing that silently broke.
WT_BEHIND=$(git -C "$WT" rev-list --count HEAD..origin/master 2>/dev/null || echo "?")
[[ "$WT_BEHIND" == "0" ]] \
  || die "internal: freshly-cut worktree is $WT_BEHIND commits behind origin/master"

fi   # end: cut a fresh tree (skipped entirely by --resume)

# The state dir must exist before the FIRST consumer, which is the zg redirect
# below — not before LOG= further down. A redirect into a missing directory fails
# the whole subshell, so every dispatch would have reported
# "discovery index FAILED" no matter how healthy zg was.
mkdir -p "$VELO_STATE/dispatch/${ISSUE}"

# ---- 6b. discovery index (#2032) --------------------------------------------
#
# Workers have rg (text), ast-grep (structural, type-blind) and cargo check
# (type-aware, but only AFTER the write). None answers "where is the code that
# does X" when the symbol name is not known yet — the phase BEFORE a pattern can
# be written, where a worker otherwise burns turns grepping blind.
#
# Measured on this workspace: 35s, 0.10GB peak, 325MB on disk. For contrast,
# rust-analyzer is 22-39GB resident and its SCIP batch mode crashes here.
#
# Built SYNCHRONOUSLY and BEFORE the worker launches, deliberately. Backgrounding
# it would let the worker query a half-built index and get nothing — and "no
# results" is indistinguishable from "not ready yet". That ambiguity is exactly
# what made a stale LSP silently degrade an agent to grep-based rewriting. 35s on
# a run measured in hours is noise; an unanswerable query is not.
#
# Non-fatal: a worker without an index still has rg, ast-grep and cargo check.
# Skipped entirely with VELO_SKIP_INDEX=1.
#
# The ignore rule is written to the repo's git EXCLUDE file, not relied on from
# the tracked .gitignore, because the tracked file only protects branches that
# CONTAIN it. This PR adds `.zvec-grep/` to .gitignore, but every worktree cut
# before it merges — 1928, 1958, 1965, 1987, 1994, 2000, 2006 as of writing — is
# on a branch without that line. On those, the 325MB index is simply untracked:
#
#   $ git status --porcelain
#   ?? .zvec-grep/
#   $ git add -A --dry-run
#   add '.zvec-grep/db/index.bin'
#
# and `velo_runner_lib.salvage_on_failure()` runs exactly `git add -A` before
# committing. A run that times out would therefore commit the whole index. The
# failure path we added to PRESERVE work would be the one that poisons the branch.
#
# info/exclude lives in the git COMMON dir, so one write covers every worktree
# including the ones already on disk, it is untracked so it cannot appear in a
# diff, and it does not depend on which branch is checked out. Idempotent.
# >>> velo-index-exclude (extracted verbatim by tests/test_index_exclude.sh)
GIT_COMMON=$(git -C "$WT" rev-parse --git-common-dir 2>/dev/null)
if [[ -n "$GIT_COMMON" ]]; then
  [[ "$GIT_COMMON" = /* ]] || GIT_COMMON="$WT/$GIT_COMMON"
  mkdir -p "$GIT_COMMON/info" 2>/dev/null
  for PAT in '.zvec-grep/' 'graphify-out/'; do
    # Braces so the 2>/dev/null covers the REDIRECTION failure, which the shell
    # reports, not printf's own stderr. Without them a read-only exclude printed
    # a raw "Permission denied" above the warn that explains it properly.
    { grep -qxF "$PAT" "$GIT_COMMON/info/exclude" \
      || printf '%s\n' "$PAT" >> "$GIT_COMMON/info/exclude"; } 2>/dev/null
  done
fi

# Verify the exclusion TOOK EFFECT; do not infer it from having written the file.
#
# The first cut of this printed success as long as the redirect did not crash the
# script. With `info/exclude` symlinked to /dev/null, or read-only, the append
# silently fails and `git status` still shows `?? .zvec-grep/` — so the dispatcher
# announced the index was safe and then built a 325MB index that salvage's
# `git add -A` could commit. Writing the guard is not the same as the guard
# holding, which is the whole failure mode this section exists to close.
#
# Asking git is the only authority: it accounts for symlinks, permissions, the
# common dir, core.excludesFile and .gitignore together.
INDEX_SAFE=0
# The TRAILING SLASH is load-bearing. The pattern written above is `.zvec-grep/`,
# which is directory-only, and at this point the directory does NOT exist yet —
# it is built below. Asked about `.zvec-grep`, git cannot know the path is a
# directory, so a directory-only pattern does not match and check-ignore reports
# NOT ignored. That made this guard refuse on EVERY fresh worktree and the
# discovery index was never built at all: a fail-closed check that closed
# permanently, on exactly the path it exists to protect.
if git -C "$WT" check-ignore -q .zvec-grep/ 2>/dev/null; then
  INDEX_SAFE=1
  ok "discovery index excluded from git on every worktree (verified via check-ignore)"
else
  warn "could NOT exclude the discovery index from git — NOT building it."
  warn "  git check-ignore says .zvec-grep/ is still trackable in $WT."
  warn "  Cause is usually $GIT_COMMON/info/exclude being read-only or a symlink."
  warn "  Refusing to build: an unignorable 325MB index is one failed run away"
  warn "  from being committed by salvage's 'git add -A'. Workers keep rg +"
  warn "  ast-grep, which is a smaller loss than a poisoned branch."
fi
INDEX_STATE="refused"     # overwritten below unless the guard refused
# <<< velo-index-exclude

INDEX_READY=0
if [[ "$INDEX_SAFE" == "1" ]] \
   && [[ "${VELO_SKIP_INDEX:-0}" != "1" ]] && [[ -x "$HOME/.agents/bin/zg" ]]; then
  printf '  .. building discovery index (~35s, skip with VELO_SKIP_INDEX=1)\n'
  if ( cd "$WT" && timeout 300 "$HOME/.agents/bin/zg" index \
         --embedding local/potion-code-16m-v2 ) >"$VELO_STATE/dispatch/${ISSUE}/zg-index.log" 2>&1; then
    INDEX_READY=1
    INDEX_STATE="built"
    ok "discovery index built ($(du -sh "$WT/.zvec-grep" 2>/dev/null | cut -f1)) — worker can run: zg query \"...\""
  else
    INDEX_STATE="failed"
    warn "discovery index FAILED (see $VELO_STATE/dispatch/${ISSUE}/zg-index.log) — worker falls back to rg + ast-grep"
  fi
else
  [[ "$INDEX_SAFE" == "1" ]] && INDEX_STATE="skipped"
  warn "discovery index skipped — worker has rg + ast-grep only"
fi

# ---- 7. assign (only now that work is actually starting) --------------------
gh issue edit "$ISSUE" --repo "$REPO" --add-assignee "$ASSIGNEE" >/dev/null 2>&1 \
  && ok "assigned to $ASSIGNEE" || warn "could not assign (non-fatal)"

# ---- 8. launch --------------------------------------------------------------
# Timestamped: this used to be deterministic per (worker, issue) and opened with
# `>`, so a re-dispatch truncated the log the PREVIOUS record cites — and
# velo-record derives turns, status, leaked calls and the whole cost block from
# it, so a post-mortem silently read the newer run's numbers (#2012 M3).
LOG="$VELO_STATE/dispatch/${ISSUE}/${LOGTAG}-$(date -u +%Y%m%dT%H%M%SZ).log"
# Tell the worker whether the index EXISTS for this run.
#
# Without this the worker learns by failing: it runs `zg query`, gets
# WORKSPACE_INDEX_NOT_FOUND, and burns a turn. Worse, zg's own error carries an
# `agent_prompt` telling the agent to "Ask the user whether this workspace should
# be indexed" — there is no user on a dispatched run, and re-indexing is not the
# worker's job. Stating the state up front removes both the wasted turn and the
# contradictory instruction.
if [[ "${INDEX_READY:-0}" == "1" ]]; then
  INDEX_NOTE="Discovery index: AVAILABLE for this worktree. \`zg query \"<plain english>\"\` works from your worktree root. It is a snapshot taken before you started — never use it to verify your own edits."
else
  INDEX_NOTE="Discovery index: NOT AVAILABLE for this run. \`zg query\` will fail with WORKSPACE_INDEX_NOT_FOUND. Do NOT run \`zg index\` and do NOT ask anyone whether to build one — there is nobody to ask. Use \`zg query --rg\`, \`rg\` and \`ast-grep\`, which is the documented fallback and is sufficient."
fi
TASK="$(cat "$BRIEF")

---
$INDEX_NOTE"
STARTED=$(date -u +%FT%TZ)

# Recorded turn cap defaults to the real one; the codex route clears it because
# it has none, and a fabricated cap is the same class of lie as a fabricated
# cost (#2012 L2).
RECORD_MAX_TURNS="$MAX_TURNS"

# The runner command is BUILT, not launched, because the supervisor wrapper
# below must be identical for every worker. Four inline launches would be four
# places for the outcome recording to be silently missing from one of them.
case "$NAME" in
  codex)
    # `codex exec` takes the brief as its prompt argument and runs
    # non-interactively. --dangerously-bypass-approvals-and-sandbox is required
    # for an IMPLEMENTATION run: the worker must compile and run tests. A
    # read-only ANALYSIS task should be dispatched with a brief that forbids
    # writes and verified after (`git status --porcelain` must be empty),
    # because nothing here enforces it.
    command -v codex >/dev/null 2>&1 \
      || die "worker:codex but the codex CLI is not on PATH.
  Do NOT silently substitute a local model — that is what produced a green
  report over two P1s on #1988. Install codex or relabel the issue."
    MODEL_ID='codex'
    # codex writes no TOTALS line, so its record carries cost source
    # "unavailable" rather than a zero. A fabricated zero on the MOST expensive
    # worker would invert every cost comparison the record exists to support.
    #
    # The SDK routes below splice velo-impl.md into the system prompt via
    # `--policy`. codex has no such flag, and this route passed the brief ALONE
    # (#2012 H1) — so the only worker running with the sandbox bypassed was also
    # the only one that never saw "never delete a test", "never swallow errors",
    # "never commit unless the brief authorizes it", or the STOP-trigger list.
    # Verified those reach it through no other path: zero occurrences in the
    # worktree's CLAUDE.md or AGENTS.md. The risk ordering was exactly inverted.
    #
    # Prepend the policy to the prompt, which is the only channel codex has.
    [[ -r "$POLICY" ]] || die "worker:codex needs the policy at $POLICY — not readable.
  The SDK routes fail closed on this (--policy is required=True); this route
  must too, or codex runs unconstrained."
    CODEX_PROMPT=$(printf '%s\n\n%s\n\n---\n\n%s\n' \
      "The following implementation policy is authoritative and mandatory for this task." \
      "$(cat "$POLICY")" "$TASK")
    # And a wall-clock bound: codex takes no --prompt-timeout, so without this
    # the "unattended for up to N hours" limit simply does not exist here.
    CMD=( timeout "$PROMPT_TIMEOUT" codex exec --dangerously-bypass-approvals-and-sandbox
          --cd "$WT" "$CODEX_PROMPT" )
    # No --max-turns on this route, so do not let the record claim one (#2012 L2).
    RECORD_MAX_TURNS=""
    ;;
  velo-local)
    MODEL_ID='qwen3-coder-next-mlx@6bit'
    # Through the WRAPPER, like every other delegated route. This used to exec
    # velo-lmstudio-agent-sdk.py directly, so VELO_AGENT_BACKEND governed the
    # OpenRouter workers and silently did NOT govern this one. A switch that
    # covers some routes is worse than no switch: the fleet then runs two
    # runtimes and nothing says which is which.
    CMD=( "$HOME/.agents/bin/velo-openrouter-agent"
          --model "$MODEL_ID" --base-url "$LMSTUDIO_URL"
          --policy "$POLICY" --max-turns "$MAX_TURNS" --prompt-timeout "$PROMPT_TIMEOUT"
          --cwd "$WT" --task "$TASK" )
    ;;
  velo-deepseek)
    MODEL_ID='deepseek/deepseek-v4-flash-0731'
    CMD=( "$HOME/.agents/bin/velo-openrouter-agent" --model "$MODEL_ID"
          --policy "$POLICY" --max-turns "$MAX_TURNS" --prompt-timeout "$PROMPT_TIMEOUT"
          --cwd "$WT" --task "$TASK" )
    ;;
  velo-glm)
    MODEL_ID='z-ai/glm-5.3-flash'
    CMD=( "$HOME/.agents/bin/velo-openrouter-agent" --model "$MODEL_ID"
          --policy "$POLICY" --max-turns "$MAX_TURNS" --prompt-timeout "$PROMPT_TIMEOUT"
          --cwd "$WT" --task "$TASK" )
    ;;
esac

# Supervisor: run the worker, then record the outcome (#1992 Phase 1).
#
# This script used to background the runner and return, printing "Detached — no
# completion event" — exactly true, and the reason nothing was ever written down
# about what a dispatch produced. The wrapper waits on the runner and hands its
# exit code to velo-record, so a crash, a timeout and a clean finish all leave a
# row. The failures are the rows worth having.
#
# velo-record is observational and always exits 0; it can never fail a run that
# has already finished. The `|| true` is belt and braces on that promise.
nohup bash -c '
  LOGF="$1"; RI="$2"; RWT="$3"; RNAME="$4"; RMODEL="$5"
  RBRIEF="$6"; RSTART="$7"; RMT="$8"; RBASE="$9"
  # $10 would parse as $1 followed by a literal 0, silently passing the log path
  # as the index state, so take it after a shift instead of using ${10}.
  shift 9; RIDX="$1"; shift 1
  "$@" > "$LOGF" 2>&1
  rc=$?
  "$HOME/.agents/bin/velo-record" "$RI" --index "$RIDX" --worktree "$RWT" --worker "$RNAME" \
    --model "$RMODEL" --brief "$RBRIEF" --log "$LOGF" --started "$RSTART" \
    --rc "$rc" --max-turns "$RMT" --base "$RBASE" >> "$LOGF" 2>&1 || true
' _ "$LOG" "$ISSUE" "$WT" "$NAME" "$MODEL_ID" "$BRIEF" "$STARTED" "$RECORD_MAX_TURNS" "$BASE" \
  "${INDEX_STATE:-unknown}" "${CMD[@]}" > /dev/null 2>&1 &
PID=$!

echo
echo "── dispatched ─────────────────────────────────────────"
echo "  #$ISSUE  $TITLE"
echo "  worker : $NAME   supervisor pid $PID"
echo "  branch : $BRANCH  (off origin/master $BASE)"
echo "  log    : $LOG"
echo "  record : .agents/tasks/${ISSUE}.result.jsonl  (appended on exit)"
echo
echo "  poll:   tail -3 $LOG"
echo "  result: git -C $WT log --oneline origin/master..HEAD"
echo
echo "  Detached. The supervisor records the outcome when the worker exits,"
echo "  including on crash or timeout. Still verify from git and the tests,"
echo "  never from the worker's self-report."
