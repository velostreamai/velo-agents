#!/bin/bash
# velo-dispatch — validate a ticket is dispatch-ready, prepare its worktree,
# assign it, and launch the right worker.
#
# Usage:
#   velo-dispatch <issue> <brief-file> [--branch <name>] [--dry-run] [--force]
#
# Exits non-zero with a specific message when the ticket is NOT ready, so a
# caller never burns a worker run on an under-specified task.
#
# Worker selection comes from the issue's `worker:*` label:
#   worker:local     -> qwen3-coder-next-mlx@6bit via LM Studio   (free)
#   worker:deepseek  -> deepseek/deepseek-v4-flash-0731           (very cheap)
#   worker:glm       -> z-ai/glm-5.3-flash                        (pricier)

set -uo pipefail

REPO="velostreamai/velostream"
ROOT="$HOME/RustroverProjects/velostream"
WORKTREE_BASE="$HOME/RustroverProjects"
POLICY="$HOME/.agents/rules/velo-impl.md"
ASSIGNEE="bluemonk3y"
MIN_DISK_GB=40
LMSTUDIO_URL="${VELO_LMSTUDIO_URL:-http://192.168.1.193:1234/v1}"
MAX_TURNS=250
PROMPT_TIMEOUT=14400

die()  { printf '\n\033[31mNOT READY:\033[0m %s\n\n' "$1" >&2; exit 1; }
warn() { printf '\033[33mwarn:\033[0m %s\n' "$1" >&2; }
ok()   { printf '\033[32m  ok\033[0m %s\n' "$1"; }

ISSUE="${1:-}"; BRIEF="${2:-}"; shift 2 2>/dev/null || true
BRANCH=""; DRY=0; FORCE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --branch) BRANCH="$2"; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    --force) FORCE=1; shift ;;
    *) die "unknown flag: $1" ;;
  esac
done

[[ -n "$ISSUE" && -n "$BRIEF" ]] || die "usage: velo-dispatch <issue> <brief-file> [--branch N] [--dry-run] [--force]"
[[ "$ISSUE" =~ ^[0-9]+$ ]] || die "issue must be a number, got '$ISSUE'"
[[ -f "$BRIEF" ]] || die "brief file not found: $BRIEF"
[[ -s "$BRIEF" ]] || die "brief file is empty: $BRIEF"

echo "── validating #$ISSUE ─────────────────────────────────"

# ---- 1. issue exists and is open -------------------------------------------
META=$(gh issue view "$ISSUE" --repo "$REPO" --json state,title,labels,assignees 2>/dev/null) \
  || die "issue #$ISSUE not found in $REPO (or gh not authenticated)"

STATE=$(jq -r .state <<<"$META")
TITLE=$(jq -r .title <<<"$META")
LABELS=$(jq -r '[.labels[].name] | join(",")' <<<"$META")

[[ "$STATE" == "OPEN" ]] || die "issue #$ISSUE is $STATE — nothing to dispatch.
  \"$TITLE\""
ok "open: $TITLE"

# ---- 2. blocking labels -----------------------------------------------------
if [[ ",$LABELS," == *",needs-design,"* ]]; then
  die "#$ISSUE is labelled 'needs-design'.
  A worker must never choose between design options.
  Either pin the design on the issue and remove the label, or dispatch a
  READ-ONLY analysis brief that presents options and stops."
fi
if [[ ",$LABELS," == *",blocked,"* ]]; then
  die "#$ISSUE is labelled 'blocked'.
  Resolve or remove the dependency first — see the issue for what it waits on."
fi
if [[ ",$LABELS," == *",triage-needed,"* ]]; then
  if [[ $FORCE -eq 0 ]]; then
    die "#$ISSUE is labelled 'triage-needed' — its claims may not match master.
  FOUR issues in one session turned out already-fixed. Verify the issue's
  file:line anchors against current master, then remove the label.
  Re-run with --force only if you have just verified it."
  fi
  warn "triage-needed present, proceeding under --force"
fi
ok "no blocking labels"

# ---- 3. exactly one worker label -------------------------------------------
WORKERS=$(tr ',' '\n' <<<"$LABELS" | grep '^worker:' || true)
COUNT=$(grep -c . <<<"$WORKERS" || true)
[[ "$COUNT" -ne 0 ]] || die "#$ISSUE has no 'worker:*' label — routing is undefined.
  Add one of:
    worker:local     free, local Qwen3-Coder. Scoped impl + audits, slower.
    worker:deepseek  very cheap. Fast scoped impl against a PINNED design.
    worker:glm       pricier. Multi-step reasoning / per-case judgement.
    worker:codex     most capable, most expensive. Architecture-weight work:
                     anything where a WRONG answer costs more than the run.
                     On #1988 it found 2 P1s that two local gates missed while
                     both returned approve; on #1967 every load-bearing claim
                     in its analysis survived independent verification. glm
                     produced ZERO code in 186 turns on #1747."
[[ "$COUNT" -eq 1 ]] || die "#$ISSUE has $COUNT worker labels ($(tr '\n' ' ' <<<"$WORKERS"))— exactly one required."

case "$WORKERS" in
  worker:local)    NAME="velo-local"; LOGTAG="velo-local" ;;
  worker:deepseek) NAME="velo-deepseek"; LOGTAG="deepseek" ;;
  worker:glm)      NAME="velo-glm"; LOGTAG="glm" ;;
  worker:codex)    NAME="codex"; LOGTAG="codex" ;;
  *) die "unrecognised worker label: $WORKERS" ;;
esac
ok "routed to $NAME"

# ---- 3a. fetch, so `origin/master` is current ------------------------------
#
# Everything below validates against the REF, never the working tree: anchors
# via `git show origin/master:<file>`, blast radius via `git grep origin/master`.
# That is the tree the worker's worktree is cut from, so it is the only one
# whose contents mean anything here.
#
# This used to read the local checkout, and then briefly REFUSED to run unless
# the checkout equalled origin/master — which fixed the correctness hole by
# handing the tool's job to the operator, and fired twice in one hour. Reading
# the ref removes the requirement instead of enforcing it: a stale, dirty, or
# mid-rebase checkout is now simply irrelevant to validation.
git -C "$ROOT" fetch -q origin || die "git fetch failed"
# A worktree directory removed by hand leaves its registration behind, and
# `git branch -D` then refuses forever — --force included (#2012 M4). Pruning is
# the documented fix and appeared nowhere in this script.
git -C "$ROOT" worktree prune 2>/dev/null || true
# Resolve ONCE. Every gate below used to re-resolve the symbolic ref, so a merge
# landing mid-validation gave the worker a tree the anchors never described —
# and the self-check compared against that same new ref, making the mismatch
# invisible in every output (#2012 M1). This is #1965 through a narrower window.
BASE_SHA=$(git -C "$ROOT" rev-parse origin/master) || die "cannot resolve origin/master"
ok "validating against origin/master (${BASE_SHA:0:9}) — pinned for this run"

# ---- 3b. task spec sidecar (authoritative when present) ---------------------
SPEC="$ROOT/.agents/tasks/${ISSUE}.json"
if [[ -f "$SPEC" ]]; then
  y() { python3 -c "
import json
d=json.load(open('$SPEC'))
for p in '$1'.split('.'):
    d = d.get(p) if isinstance(d,dict) else None
print('' if d is None else (json.dumps(d) if isinstance(d,(list,dict)) else d))
" 2>/dev/null; }

  [[ "$(y design)" == "pinned" ]] || die "spec: design is '$(y design)', must be 'pinned'.
  A worker never chooses between design options. Pin it on the issue first."

  EV=$(y evidence); AU=$(y audit)
  if [[ -n "$EV" && "$EV" != "code" ]]; then
    [[ "$AU" == done:* ]] || die "spec: evidence='$EV' (not a code read) and audit='$AU'.
  Claims sourced from a spec or another agent's report must be audited against
  code first — four issues in one session were stale for exactly this reason.
  Set audit: done:<sha> after auditing."
  fi

  DEPS=$(y depends_on)
  if [[ -n "$DEPS" && "$DEPS" != "null" ]]; then
    # `tr -d` already deletes the commas, so the old second `tr ',' ' '` split
    # nothing and [1956, 1958] collapsed to the single token 19561958 (#2012 M2).
    for d in $(python3 -c 'import json,sys; print(" ".join(str(x) for x in json.loads(sys.argv[1])))' "$DEPS" 2>/dev/null); do
      [[ -n "$d" ]] || continue
      DS=$(gh issue view "$d" --repo "$REPO" --json state --jq .state 2>/dev/null)
      [[ "$DS" == "CLOSED" ]] || die "spec: depends_on #$d is $DS — must be CLOSED before dispatch."
    done
    [[ -n "$(python3 -c 'import json,sys; print(len(json.loads(sys.argv[1])))' "$DEPS" 2>/dev/null)" ]] \
      || die "spec: depends_on is not valid JSON: $DEPS"
    ok "dependencies closed"
  fi

  # ---- REVIEW ATTESTATION + SPEC-vs-ISSUE DRIFT -----------------------------
  #
  # Every other check here asks "does the spec still match the CODE?". Neither
  # asked "does it still match the ISSUE?", nor "did anyone review it?".
  #
  # Both gaps are load-bearing. A spec is authored against an issue at a moment
  # in time; the issue then acquires a ruling, a correction, or a scope cut, and
  # the brief silently contradicts it. That happened repeatedly in one session:
  # a worker was briefed to "emit every legal spelling" hours after the issue
  # recorded that doing so IS the defect; another was briefed on a failure count
  # the issue had already corrected. Anchors were green both times, because the
  # code had not moved — the INTENT had.
  #
  # So: the spec must carry a `reviewed` block, and both halves are checked.
  #
  #   "reviewed": {
  #     "by":          "<who>",              # a name, not a role
  #     "at":          "2026-09-01T19:00:00Z",
  #     "brief_sha256": "<sha256 of the brief file>"
  #   }
  #
  # brief_sha256 pins the BRIEF, not just the spec: editing the brief after
  # review is the easiest way to smuggle unreviewed instructions to a worker,
  # and it is exactly what an orchestrator does mid-flight when it is in a hurry.
  REV=$(y reviewed.by); REV_AT=$(y reviewed.at); REV_SHA=$(y reviewed.brief_sha256)

  # `brief_sha256` is REQUIRED, not optional-if-present (#2012 H2). It used to be
  # guarded by `[[ -n "$REV_SHA" && … ]]`, so omitting the field — the fiddliest
  # one to write by hand — silently disabled brief-pinning while the ok line
  # below still announced "brief hash matches". A gate you can switch off by
  # leaving a field out, which then claims it ran, is worse than no gate.
  [[ -n "$REV" && -n "$REV_AT" && -n "$REV_SHA" ]] || die "spec: incomplete 'reviewed' block.
  All three fields are required — by/at attest that someone read the spec against
  the issue, brief_sha256 pins the BRIEF they read. Editing the brief after
  review is the easiest way to smuggle unreviewed instructions to a worker.

    \"reviewed\": { \"by\": \"<who>\", \"at\": \"$(date -u +%FT%TZ)\",
                  \"brief_sha256\": \"$(shasum -a 256 "$BRIEF" | cut -d" " -f1)\" }"

  BRIEF_NOW=$(shasum -a 256 "$BRIEF" | cut -d' ' -f1)
  if [[ "$REV_SHA" != "$BRIEF_NOW" ]]; then
    die "spec: THE BRIEF CHANGED SINCE REVIEW.
  reviewed.brief_sha256 = $REV_SHA
  actual                = $BRIEF_NOW
  Editing the brief after review sends a worker instructions nobody checked
  against the issue. Re-read it, then update reviewed.at and brief_sha256."
  fi
  ok "brief hash matches reviewed.brief_sha256"

  # Spec-vs-issue drift. `updatedAt` moves on edits AND on new comments, which
  # is what we want: a ruling posted as a comment is the commonest way a brief
  # goes stale, and it is invisible to every code-based check above.
  #
  # This must FAIL CLOSED (#2012 H3). `set -e` is off and stderr is discarded, so
  # a rate-limit, expired token or transient 5xx produced an empty string, the
  # `-n` guard skipped the comparison, and the ok line still reported "issue
  # unchanged since" — a rubber stamp on the exact failure this was built for.
  ISSUE_UPD=$(gh issue view "$ISSUE" --repo "$REPO" --json updatedAt --jq .updatedAt 2>/dev/null)
  [[ -n "$ISSUE_UPD" ]] || die "spec: could not re-read #$ISSUE to check for drift.
  gh returned nothing (rate limit, expired token, or network). Refusing rather
  than skipping: an unanswered drift check is not a passed one."
  if [[ "$ISSUE_UPD" > "$REV_AT" ]]; then
    die "spec: ISSUE MOVED AFTER REVIEW — the brief may contradict it.
  reviewed.at      = $REV_AT
  issue updatedAt  = $ISSUE_UPD
  #$ISSUE was edited or commented after this spec was reviewed. Read what
  changed (gh issue view $ISSUE --comments), reconcile the brief, then bump
  reviewed.at. Anchors passing means the CODE did not move; it says nothing
  about the intent.

  NOTE: a PREVIOUS dispatch of this issue bumps updatedAt by assigning it, so
  a re-dispatch can trip this on a change the tooling itself made (#2012 L3).
  Check the timeline before assuming someone edited the issue."
  fi
  ok "reviewed by $REV at $REV_AT; issue unchanged since"

  # Anchors: SYMBOLS re-verified against the tree. Line numbers rot; symbols do not.
  ANCH=$(y anchors)
  if [[ "$ANCH" != "[]" && -n "$ANCH" ]]; then
    STALE=$(python3 - "$ROOT" "$SPEC" "$BASE_SHA" <<'PYA'
import sys, json, subprocess
root, spec, base = sys.argv[1], sys.argv[2], sys.argv[3]

def at_origin(path):
    """File content as it exists at origin/master — NOT in the working tree.

    The worker's worktree is cut off origin/master, so that is the only tree
    whose contents matter. Reading the local checkout meant validation could
    describe code the worker would never see: a stale checkout once reported a
    test file MISSING and a blast radius short by 6, both of which looked like
    errors in the brief and were not."""
    r = subprocess.run(["git", "-C", root, "show", f"{base}:{path}"],
                       capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else None

bad=[]
for a in (json.load(open(spec)) or {}).get("anchors") or []:
    f, sym, exp = a.get("file"), a.get("symbol"), a.get("expect")
    # A comment is not an anchor. SCHEMA.md sells these as "SYMBOLS, never line
    # numbers", but the check is a substring count over raw file text, so a
    # comment left behind by a refactor keeps reporting "verified" for code that
    # moved (#2012 L1). Two of #1959's three anchors were comments.
    if sym and sym.lstrip().startswith(("//", "#", "/*", "*")):
        bad.append(f"{f}: anchor {sym[:40]!r} is a COMMENT, not a symbol — "
                   "a refactor can move the code and leave it behind")
        continue
    content = at_origin(f)
    if content is None:
        bad.append(f"{f}: FILE MISSING at origin/master"); continue
    n = content.count(sym)
    if n == 0:
        bad.append(f"{f}: symbol '{sym}' NOT FOUND at origin/master")
    elif exp is not None and n != exp:
        bad.append(f"{f}: '{sym}' found {n}x at origin/master, spec says {exp}x")
print("\n".join(bad))
PYA
)
    [[ -z "$STALE" ]] || die "spec: ANCHORS ARE STALE — the issue describes code that has moved.
$STALE
  Re-verify against master, update .agents/tasks/${ISSUE}.json, then retry."
    ok "anchors verified against origin/master"
  fi

  # Blast radius: COMPUTE it. An author's estimate produced '1 call site' for 66.
  BRP=$(y blast_radius.pattern); BRR=$(y blast_radius.refs); BRF=$(y blast_radius.files)
  if [[ -n "$BRP" && -n "$BRR" ]]; then
    # `git grep <ref>` reads the REF, so this measures the same tree the worker
    # gets rather than whatever happens to be checked out locally.
    # -o counts REFERENCES, not matching lines: -c undercounts any line using the
# symbol twice (#2012 M5).
    ACT=$(git -C "$ROOT" grep -F -o "$BRP" "$BASE_SHA" -- src tests examples 2>/dev/null | wc -l | tr -d ' ')
    DELTA=$(( ACT > BRR ? ACT - BRR : BRR - ACT ))
    LIM=$(( BRR / 10 + 2 ))
    [[ "$DELTA" -le "$LIM" ]] || die "spec: BLAST RADIUS MISMATCH for '$BRP'.
  declared $BRR refs, actually $ACT (git grep of origin/master over src/ tests/ examples/).
  A wrong estimate is how a worker burned its entire budget hand-editing 66
  call sites it was told was one. Re-measure and update the spec."
    # SCHEMA.md promises "computed refs/FILES vs declared -> refuse on mismatch"
    # and files was never read. Both live specs declared 0 and passed (#2012 M5).
    if [[ -n "$BRF" && "$BRF" != "null" ]]; then
      ACTF=$(git -C "$ROOT" grep -F -l "$BRP" "$BASE_SHA" -- src tests examples 2>/dev/null | wc -l | tr -d ' ')
      DELTAF=$(( ACTF > BRF ? ACTF - BRF : BRF - ACTF ))
      LIMF=$(( BRF / 10 + 2 ))
      [[ "$DELTAF" -le "$LIMF" ]] || die "spec: BLAST RADIUS FILE COUNT MISMATCH for '$BRP'.
  declared $BRF files, actually $ACTF.
  A declared 0 used to pass silently — SCHEMA.md says this is enforced."
      ok "blast radius: $ACT refs / $ACTF files (declared $BRR / $BRF)"
    else
      ok "blast radius: $ACT refs (declared $BRR); files not declared"
    fi
  fi

  BEHIND=$(git -C "$ROOT" rev-list --count "$(y verified_against)..origin/master" 2>/dev/null || echo "?")
  [[ "$BEHIND" == "0" || "$BEHIND" == "?" ]] && ok "spec verified at current master" \
    || warn "spec verified $BEHIND commits behind master (anchors still check out)"
else
  warn "no task spec at .agents/tasks/${ISSUE}.json — validating brief only.
       See .agents/tasks/SCHEMA.md; a spec enables anchor + blast-radius checks."
fi

# ---- 4. brief sanity — cheap checks against velo-brief-spec.md --------------
MISSING=()
grep -qi "worktree" "$BRIEF"                  || MISSING+=("no WORKTREE path (spec §1)")
grep -qiE "do not.*cd|don't.*cd" "$BRIEF"     || MISSING+=("no 'do NOT cd' instruction (spec §1)")
grep -qiE "STOP and report|STOP —|STOP if"    "$BRIEF" || MISSING+=("no STOP conditions (spec §5)")
grep -qiE "commit incrementally|commit after each" "$BRIEF" || MISSING+=("no incremental-commit rule (spec §12) — a timeout will lose all work")
grep -qiE "cargo (check|nextest)" "$BRIEF"    || MISSING+=("no validation commands (spec §7)")
grep -qiE "do not commit|may commit|commit and push|do not push|do not open a pr|authorized to (commit|push)" "$BRIEF" \
  || MISSING+=("no explicit commit/push authorization (spec §8) — the brief is the only thing telling a worker what it may do")
if grep -qiE "\.sql|SELECT .* FROM" "$BRIEF"; then
  grep -q "SQL_GRAMMAR_RULES\|PARSER_GRAMMAR" "$BRIEF" \
    || MISSING+=("brief writes SQL but cites no grammar reference (spec §6)")
fi
if [[ ${#MISSING[@]} -gt 0 ]]; then
  printf '\n\033[31mBRIEF INCOMPLETE:\033[0m %s\n' "$BRIEF" >&2
  printf '  - %s\n' "${MISSING[@]}" >&2
  printf '\nSee %s\n\n' "$HOME/.agents/rules/velo-brief-spec.md" >&2
  exit 1
fi
ok "brief satisfies the spec checklist"

# ---- 5. disk ----------------------------------------------------------------
AVAIL=$(df -g "$HOME" | awk 'NR==2 {print $4}')
[[ "$AVAIL" -ge "$MIN_DISK_GB" ]] || die "only ${AVAIL}GB free; each worktree target/ is ~20GB.
  A full disk kills workers with errors that look like compile bugs.
  Free space (rm -rf <merged-worktree>/target) then retry."
ok "disk: ${AVAIL}GB free"

# ---- 6. worktree ------------------------------------------------------------
[[ -n "$BRANCH" ]] || BRANCH="fix/${ISSUE}-auto"
WT="$WORKTREE_BASE/velostream-$ISSUE"

# (fetch already done in section 3a, before anchors were measured)
BASE="${BASE_SHA:0:9}"

if [[ $DRY -eq 1 ]]; then
  echo
  echo "DRY RUN — would do:"
  echo "  worktree : $WT  (branch $BRANCH off origin/master $BASE)"
  echo "  assign   : #$ISSUE -> $ASSIGNEE"
  echo "  worker   : $NAME"
  echo "  brief    : $BRIEF"
  echo "  log      : /tmp/${LOGTAG}-${ISSUE}.log"
  exit 0
fi

# A worker's tree is CUT FROM THE FETCHED REF, never inherited from whatever is
# lying around on disk.
#
# This used to reuse an existing directory when it looked "clean" (no local
# edits, no commits of its own). But a worktree left by an EARLIER dispatch of
# the same issue scores exactly that — 0 dirty, 0 ahead — so it was
# indistinguishable from a fresh one, and #1965's worker was handed a tree 15
# commits behind master while the script printed "off origin/master <sha>". It
# never saw #1969 or #1988; its 21 failures were stale-base artefacts, and the
# brief written from them told it to preserve an escape hatch master had
# already deleted.
#
# Adding a "behind" check to the reuse path would only narrow that hole. The
# reuse path itself is the defect: there is no reason to inherit a tree when
# cutting a new one from `origin/master` costs a second and is unambiguous.
# `origin/master` here is the ref fetched in section 3a — the same ref every
# other gate (anchors, blast radius, spec drift) validates against, so the
# worker's tree and the validation now agree by construction.
if [[ -d "$WT" ]]; then
  DIRTY=$(git -C "$WT" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  AHEAD=$(git -C "$WT" log --oneline origin/master..HEAD 2>/dev/null | wc -l | tr -d ' ')
  if [[ "$DIRTY" != "0" || "$AHEAD" != "0" ]]; then
    [[ $FORCE -eq 1 ]] || die "worktree $WT already exists and HAS WORK ($DIRTY dirty, $AHEAD commits).
  It will not be reused or reset silently — inspect it first.
    git -C $WT log --oneline origin/master..HEAD
  Then either keep it (rebase onto origin/master and dispatch with --worktree),
  or discard it and re-run with --force."
    warn "discarding existing worktree with work ($DIRTY dirty, $AHEAD commits) — --force"
  fi
  # `agent.log` is git-IGNORED but MANDATED by the implementation policy as the
  # worker's append-only reasoning trail — the record of why a run did what it
  # did, and what a post-mortem reads. DIRTY counts tracked files only, so a
  # completed worktree carrying nothing but agent.log scores 0/0 and would be
  # removed here WITHOUT the caller passing --force. Preserve it first.
  if [[ -f "$WT/agent.log" ]]; then
    KEEP="$WORKTREE_BASE/agent-logs/${ISSUE}-$(date -u +%Y%m%dT%H%M%SZ).log"
    mkdir -p "$(dirname "$KEEP")"
    cp "$WT/agent.log" "$KEEP" 2>/dev/null \
      && warn "preserved worker reasoning trail: $KEEP"
  fi
  git -C "$ROOT" worktree remove "$WT" --force >/dev/null 2>&1 \
    || die "could not remove existing worktree $WT"
  ok "removed stale worktree $WT (recreating from origin/master)"
fi

# The branch may also survive an earlier dispatch. Delete it only when it has no
# commits of its own; otherwise refuse rather than silently discard someone's work.
if git -C "$ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
  BR_AHEAD=$(git -C "$ROOT" rev-list --count "origin/master..$BRANCH" 2>/dev/null || echo 0)
  if [[ "$BR_AHEAD" != "0" ]]; then
    [[ $FORCE -eq 1 ]] || die "branch '$BRANCH' already exists with $BR_AHEAD commit(s) not on master.
  Cutting a fresh worktree would abandon them.
    git -C $ROOT log --oneline origin/master..$BRANCH
  Keep them: rebase onto origin/master, then dispatch with --worktree <path>.
  Discard them: re-run with --force, or use --branch fix/${ISSUE}-v2."
    warn "deleting branch $BRANCH with $BR_AHEAD commit(s) — --force"
  fi
  # `branch -D` prints "Deleted branch X (was <sha>)" — the easiest recovery path
# for work this flag just discarded. It was sent to /dev/null (#2012 L5).
DELETED=$(git -C "$ROOT" branch -D "$BRANCH" 2>&1) \
    || die "could not delete existing branch $BRANCH"
fi

git -C "$ROOT" worktree add "$WT" -b "$BRANCH" "$BASE_SHA" -q \
  || die "could not create worktree $WT on branch $BRANCH off origin/master"
ok "worktree cut from origin/master: $WT ($BRANCH @ $BASE)"

# Assert it, rather than trusting the command above — this is the dispatcher's
# one core promise and it is the thing that silently broke.
WT_BEHIND=$(git -C "$WT" rev-list --count HEAD..origin/master 2>/dev/null || echo "?")
[[ "$WT_BEHIND" == "0" ]] \
  || die "internal: freshly-cut worktree is $WT_BEHIND commits behind origin/master"

# ---- 7. assign (only now that work is actually starting) --------------------
gh issue edit "$ISSUE" --repo "$REPO" --add-assignee "$ASSIGNEE" >/dev/null 2>&1 \
  && ok "assigned to $ASSIGNEE" || warn "could not assign (non-fatal)"

# ---- 8. launch --------------------------------------------------------------
# Timestamped: this used to be deterministic per (worker, issue) and opened with
# `>`, so a re-dispatch truncated the log the PREVIOUS record cites — and
# velo-record derives turns, status, leaked calls and the whole cost block from
# it, so a post-mortem silently read the newer run's numbers (#2012 M3).
LOG="/tmp/${LOGTAG}-${ISSUE}-$(date -u +%Y%m%dT%H%M%SZ).log"
TASK=$(cat "$BRIEF")
STARTED=$(date -u +%FT%TZ)

# Recorded turn cap defaults to the real one; the codex route clears it because
# it has none, and a fabricated cap is the same class of lie as a fabricated
# cost (#2012 L2).
RECORD_MAX_TURNS="$MAX_TURNS"

# The runner command is BUILT, not launched, because the supervisor wrapper
# below must be identical for every worker. Four inline launches would be four
# places for the outcome recording to be silently missing from one of them.
case "$NAME" in
  codex)
    # `codex exec` takes the brief as its prompt argument and runs
    # non-interactively. --dangerously-bypass-approvals-and-sandbox is required
    # for an IMPLEMENTATION run: the worker must compile and run tests. A
    # read-only ANALYSIS task should be dispatched with a brief that forbids
    # writes and verified after (`git status --porcelain` must be empty),
    # because nothing here enforces it.
    command -v codex >/dev/null 2>&1 \
      || die "worker:codex but the codex CLI is not on PATH.
  Do NOT silently substitute a local model — that is what produced a green
  report over two P1s on #1988. Install codex or relabel the issue."
    MODEL_ID='codex'
    # codex writes no TOTALS line, so its record carries cost source
    # "unavailable" rather than a zero. A fabricated zero on the MOST expensive
    # worker would invert every cost comparison the record exists to support.
    #
    # The SDK routes below splice velo-impl.md into the system prompt via
    # `--policy`. codex has no such flag, and this route passed the brief ALONE
    # (#2012 H1) — so the only worker running with the sandbox bypassed was also
    # the only one that never saw "never delete a test", "never swallow errors",
    # "never commit unless the brief authorizes it", or the STOP-trigger list.
    # Verified those reach it through no other path: zero occurrences in the
    # worktree's CLAUDE.md or AGENTS.md. The risk ordering was exactly inverted.
    #
    # Prepend the policy to the prompt, which is the only channel codex has.
    [[ -r "$POLICY" ]] || die "worker:codex needs the policy at $POLICY — not readable.
  The SDK routes fail closed on this (--policy is required=True); this route
  must too, or codex runs unconstrained."
    CODEX_PROMPT=$(printf '%s\n\n%s\n\n---\n\n%s\n' \
      "The following implementation policy is authoritative and mandatory for this task." \
      "$(cat "$POLICY")" "$TASK")
    # And a wall-clock bound: codex takes no --prompt-timeout, so without this
    # the "unattended for up to N hours" limit simply does not exist here.
    CMD=( timeout "$PROMPT_TIMEOUT" codex exec --dangerously-bypass-approvals-and-sandbox
          --cd "$WT" "$CODEX_PROMPT" )
    # No --max-turns on this route, so do not let the record claim one (#2012 L2).
    RECORD_MAX_TURNS=""
    ;;
  velo-local)
    MODEL_ID='qwen3-coder-next-mlx@6bit'
    CMD=( "$HOME/.venvs/velo-openrouter-agent/bin/python"
          "$HOME/.agents/bin/velo-lmstudio-agent-sdk.py"
          --model "$MODEL_ID" --base-url "$LMSTUDIO_URL"
          --policy "$POLICY" --max-turns "$MAX_TURNS" --prompt-timeout "$PROMPT_TIMEOUT"
          --cwd "$WT" --task "$TASK" )
    ;;
  velo-deepseek)
    MODEL_ID='deepseek/deepseek-v4-flash-0731'
    CMD=( "$HOME/.agents/bin/velo-openrouter-agent" --model "$MODEL_ID"
          --policy "$POLICY" --max-turns "$MAX_TURNS" --prompt-timeout "$PROMPT_TIMEOUT"
          --cwd "$WT" --task "$TASK" )
    ;;
  velo-glm)
    MODEL_ID='z-ai/glm-5.3-flash'
    CMD=( "$HOME/.agents/bin/velo-openrouter-agent" --model "$MODEL_ID"
          --policy "$POLICY" --max-turns "$MAX_TURNS" --prompt-timeout "$PROMPT_TIMEOUT"
          --cwd "$WT" --task "$TASK" )
    ;;
esac

# Supervisor: run the worker, then record the outcome (#1992 Phase 1).
#
# This script used to background the runner and return, printing "Detached — no
# completion event" — exactly true, and the reason nothing was ever written down
# about what a dispatch produced. The wrapper waits on the runner and hands its
# exit code to velo-record, so a crash, a timeout and a clean finish all leave a
# row. The failures are the rows worth having.
#
# velo-record is observational and always exits 0; it can never fail a run that
# has already finished. The `|| true` is belt and braces on that promise.
nohup bash -c '
  LOGF="$1"; RI="$2"; RWT="$3"; RNAME="$4"; RMODEL="$5"
  RBRIEF="$6"; RSTART="$7"; RMT="$8"; RBASE="$9"
  shift 9
  "$@" > "$LOGF" 2>&1
  rc=$?
  "$HOME/.agents/bin/velo-record" "$RI" --worktree "$RWT" --worker "$RNAME" \
    --model "$RMODEL" --brief "$RBRIEF" --log "$LOGF" --started "$RSTART" \
    --rc "$rc" --max-turns "$RMT" --base "$RBASE" >> "$LOGF" 2>&1 || true
' _ "$LOG" "$ISSUE" "$WT" "$NAME" "$MODEL_ID" "$BRIEF" "$STARTED" "$RECORD_MAX_TURNS" "$BASE" \
  "${CMD[@]}" > /dev/null 2>&1 &
PID=$!

echo
echo "── dispatched ─────────────────────────────────────────"
echo "  #$ISSUE  $TITLE"
echo "  worker : $NAME   supervisor pid $PID"
echo "  branch : $BRANCH  (off origin/master $BASE)"
echo "  log    : $LOG"
echo "  record : .agents/tasks/${ISSUE}.result.jsonl  (appended on exit)"
echo
echo "  poll:   tail -3 $LOG"
echo "  result: git -C $WT log --oneline origin/master..HEAD"
echo
echo "  Detached. The supervisor records the outcome when the worker exits,"
echo "  including on crash or timeout. Still verify from git and the tests,"
echo "  never from the worker's self-report."
