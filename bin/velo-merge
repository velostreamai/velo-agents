#!/bin/bash
# velo-merge — merge a PR only if it has been gated against its CURRENT head.
#
#   velo-merge <pr> [--force]
#
# This is the enforcement point. Everything else records state; this refuses to
# act on bad state. Three things must hold:
#
#   1. the PR carries `gate:passed`
#   2. the recorded `gate: <name> @ <sha>` matches the current head
#   3. CI is green against that same head
#
# (2) is the one that is easy to get wrong by hand: a PR once reported green
# CI against a commit that had already been replaced, so "green and mergeable"
# described code that was no longer there.
#
# Docs/tooling-only PRs (no src/ or tests/ changes) skip the gate requirement
# but still require green CI.

set -uo pipefail
REPO="velostreamai/velostream"
die()  { printf '\n\033[31mREFUSING TO MERGE:\033[0m %s\n\n' "$1" >&2; exit 1; }
ok()   { printf '\033[32m  ok\033[0m %s\n' "$1"; }
warn() { printf '\033[33mwarn:\033[0m %s\n' "$1" >&2; }

PR="${1:-}"; FORCE=0
[[ "${2:-}" == "--force" ]] && FORCE=1
[[ "$PR" =~ ^[0-9]+$ ]] || die "usage: velo-merge <pr> [--force]"

M=$(gh pr view "$PR" --repo "$REPO" \
     --json headRefOid,labels,files,state,title,mergeable,statusCheckRollup 2>/dev/null) \
  || die "PR #$PR not found"

STATE=$(jq -r .state <<<"$M")
[[ "$STATE" == "OPEN" ]] || die "PR #$PR is $STATE"
TITLE=$(jq -r .title <<<"$M")
HEAD=$(jq -r .headRefOid <<<"$M"); SHORT="${HEAD:0:9}"
MERGEABLE=$(jq -r .mergeable <<<"$M")
# Evaluate ALL checks, not just the first. Optional lanes report SKIPPED and
# can sort first, which would otherwise mask a green required build.
FAILED=$(jq -r '[.statusCheckRollup[]?|select(.conclusion=="FAILURE" or .conclusion=="CANCELLED" or .conclusion=="TIMED_OUT")|.name]|unique|join(", ")' <<<"$M")
PASSED=$(jq -r '[.statusCheckRollup[]?|select(.conclusion=="SUCCESS")|.name]|unique|join(", ")' <<<"$M")
PENDING=$(jq -r '[.statusCheckRollup[]?|select(.conclusion==null)|.name]|unique|join(", ")' <<<"$M")
if   [[ -n "$FAILED"  ]]; then CI="FAILING"
elif [[ -n "$PENDING" ]]; then CI="pending"
elif [[ -n "$PASSED"  ]]; then CI="SUCCESS"
else CI="none"; fi
LABELS=$(jq -r '[.labels[].name]|join(",")' <<<"$M")
FILES=$(jq -r '[.files[].path]|join("\n")' <<<"$M")
# Orchestration counts as CODE for gating purposes. `.agents/` has no src/ or
# tests/ path, so the old sum scored it 0 and this script printed
# "docs/tooling only — gate not required" for a change to the very scripts that
# decide what every other gate does. velo-gate --plan was fixed to REQUIRE
# review for these paths; without the same rule here, the requirement was
# unenforceable at the merge boundary — the PR that fixed --plan had exactly
# this shape.
#
# Scope matches velo-gate: executables and policy under bin/ and rules/, plus
# the inputs dispatch actually READS (tasks/*.json sidecars carry design
# pinning, review attestation, anchors and blast radius) and the skills injected
# as worker instructions, and the installers that put any of it in place.
CODE=$(( $(grep -c '^src/' <<<"$FILES" || true) \
        + $(grep -c '^tests/' <<<"$FILES" || true) \
        + $(grep -cE '^\.agents/(bin|rules|skills|tasks)/' <<<"$FILES" || true) \
        + $(grep -cE '^\.agents/(install|update)\.sh$' <<<"$FILES" || true) ))

echo "── #$PR $TITLE"
echo "   head $SHORT   mergeable=$MERGEABLE"

[[ "$MERGEABLE" == "MERGEABLE" ]] || die "mergeable=$MERGEABLE — resolve conflicts first."
case "$CI" in
  SUCCESS) ok "CI green on current head: $PASSED" ;;
  FAILING) die "CI FAILING against $SHORT: $FAILED" ;;
  pending) die "CI still pending against $SHORT: $PENDING" ;;
  none)
    # No lane ran. For a docs/tooling-only PR that is BY DESIGN — ci.yml carries
    # `paths-ignore: ['docs/**', '*.md', …]`, so a docs change triggers nothing
    # and this guard could never be satisfied. Dying here made docs PRs
    # permanently unmergeable through this tool, which just pushes people to
    # merge by hand and skip every other check as well.
    #
    # Code changes still die: there, "no CI" means something is wrong.
    if [[ "$CODE" -eq 0 ]]; then
      warn "no CI checks — expected for a docs/tooling-only PR (ci.yml paths-ignore). Nothing automated has verified this; the PR body must say what did."
    else
      die "no CI checks reported against $SHORT — nothing has verified this build."
    fi
    ;;
esac

if [[ "$CODE" -eq 0 ]]; then
  ok "docs only — no code, no orchestration; gate not required"
else
  if [[ ",$LABELS," == *",gate:passed,"* ]]; then
    # `gate:passed` is one label, but a src/ PR runs MORE THAN ONE gate. The
    # printed handoff only ever named code-review, so a check-code finding could
    # be dropped and nothing would notice — the label would still say passed.
    # Require a recorded comment per gate the plan demanded.
    # FAIL CLOSED. `velo-gate --plan` dies with no stdout on a gh failure, so an
    # empty NEEDED used to mean "nothing demanded" and merged silently — the
    # exact check this block adds, skipped on the very transient failure it
    # should be most careful about.
    PLAN_OUT=$(~/.agents/bin/velo-gate "$PR" --plan 2>/dev/null)
    if [[ -z "$PLAN_OUT" ]]; then
      [[ $FORCE -eq 1 ]] || die "could not read the gate plan for #$PR (velo-gate --plan returned nothing).
  Refusing rather than assuming no gates were required — that assumption is
  indistinguishable from a correctly-gated PR."
      warn "gate plan unreadable — proceeding under --force"
      PLAN_OUT=""
    fi
    NEEDED=$(grep -oE '^ *- (code-review|check-code|check-spec)' <<<"$PLAN_OUT" | awk '{print $2}')
    # PLAN_OUT non-empty but NEEDED empty means the plan PARSED to nothing —
    # a --plan format change (indentation, bullet char, JSON) would silently
    # reproduce the vacuous check this block exists to prevent. Guard the
    # variable the invariant is actually about, not just its input.
    if [[ -z "$NEEDED" ]]; then
      [[ $FORCE -eq 1 ]] || die "read the gate plan for #$PR but parsed NO gate names from it.
  velo-gate --plan's output format has probably changed. Refusing rather than
  treating an unparsed plan as 'no gates required'.
  Plan output was:
$PLAN_OUT"
      warn "gate plan parsed to nothing — proceeding under --force"
    fi
    RECORDED=$(gh pr view "$PR" --repo "$REPO" --json comments \
      --jq '[.comments[].body | capture("gate: *(?<n>[a-z0-9-]+) *@")] | map(.n) | unique | join(" ")' 2>/dev/null)
    MISSING=""
    for g in $NEEDED; do
      # Match the gate FAMILY, not the exact string. A review is legitimately
      # recorded as `codex-review` (the README's own worked example) or under
      # any `<who>-review` name when a reviewer is substituted. velo-pr-gate's
      # GSHA regex already learned this — it matches `[a-z0-9-]*review` — and a
      # literal `code-review` test here would refuse a fully-gated PR.
      case "$g" in
        code-review)
          # An explicit allowlist, NOT a bare `*review*` substring. The
          # substring form accepted the intended `codex-review` but would also
          # accept `self-review`, `pre-review`, or any invented `*review` name —
          # a false ACCEPT, which is worse than the false refuse it replaced.
          # Names are only ever minted by velo-gate-post/velo-pr-gate today;
          # this keeps that true by construction rather than by convention.
          MATCHED=0
          for alias in code-review codex-review opus-review sonnet-review; do
            [[ " $RECORDED " == *" $alias "* ]] && { MATCHED=1; break; }
          done
          [[ $MATCHED -eq 1 ]] || MISSING="$MISSING $g"
          ;;
        *) [[ " $RECORDED " == *" $g "* ]] || MISSING="$MISSING $g" ;;
      esac
    done
    if [[ -n "$MISSING" ]]; then
      [[ $FORCE -eq 1 ]] || die "#$PR is gate:passed but has NO recorded report for:$MISSING
  A gate whose result never reached the PR is indistinguishable from one that
  never ran. Post it:
    velo-gate-post $PR <gate-name> <report-file>
  Recorded so far: ${RECORDED:-none}"
      warn "missing gate reports:$MISSING — proceeding under --force"
    fi
    if [[ -n "$MISSING" ]]; then
      warn "gate:passed label present, but the cross-check was BYPASSED (--force)"
    else
      ok "gate:passed (reports recorded:${RECORDED:+ $RECORDED})"
    fi
  else
    CUR=$(tr ',' '\n' <<<"$LABELS" | grep '^gate:' | head -1); [[ -n "$CUR" ]] || CUR="gate:none"
    [[ $FORCE -eq 1 ]] || die "#$PR touches $CODE code file(s) and is '$CUR', not gate:passed.
  Run the gate, then: velo-gate $PR --pass
  Verifying it yourself is not the gate — that is how an ungated PR gets
  described as ready."
  fi

  # The stale-gate check: a gate result is only valid for the commit it ran on.
  GSHA=$(gh pr view "$PR" --repo "$REPO" --json comments \
          --jq '[.comments[].body | capture("gate: *(?<n>[a-z-]+) *@ *(?<s>[0-9a-f]{7,40})")] | last | .s' 2>/dev/null)
  [[ "$GSHA" == "null" ]] && GSHA=""
  if [[ -z "$GSHA" ]]; then
    [[ $FORCE -eq 1 ]] || die "no 'gate: <name> @ <sha>' comment on #$PR.
  Gate comments must name the commit they ran against, else staleness is
  unverifiable."
  elif [[ "$HEAD" != "$GSHA"* ]]; then
    [[ $FORCE -eq 1 ]] || die "STALE GATE — reviewed at $GSHA, head is now $SHORT.
  Commits landed after the review. Re-gate against the current head:
    velo-gate $PR --running   # then re-run the reviewers
  This is the exact case where a PR looked green against code that had
  already been replaced."
  else
    ok "gate ran against current head ($GSHA)"
  fi
fi

[[ $FORCE -eq 1 ]] && printf '\033[33mwarn:\033[0m --force: overriding the checks above\n' >&2

echo
gh pr merge "$PR" --repo "$REPO" --squash --delete-branch \
  && ok "merged #$PR" || die "gh pr merge failed"
