#!/bin/bash
# velo-gate-post — post a reviewer's report to a PR on its behalf.
#
#   velo-gate-post <pr> <gate-name> <report-file> [--sha <sha>]
#   <something producing a report> | velo-gate-post <pr> <gate-name> -
#
# Why this exists: a reviewer that cannot reach the GitHub API produces a
# perfectly good report and then silently fails to deliver it. A gate whose
# result never reaches the PR is indistinguishable from a gate that never ran —
# so the orchestrator must own delivery, not the reviewer.
#
# It stamps the mandatory `gate: <name> @ <sha>` header (defaulting to the PR's
# CURRENT head), so the result is bound to the commit it applies to and
# `velo-merge` can detect staleness.

set -uo pipefail
REPO="velostreamai/velostream"
die() { printf '\n\033[31mERROR:\033[0m %s\n\n' "$1" >&2; exit 1; }
ok()  { printf '\033[32m  ok\033[0m %s\n' "$1"; }

PR="${1:-}"; NAME="${2:-}"; FILE="${3:-}"; shift 3 2>/dev/null || true
SHA=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --sha) SHA="$2"; shift 2 ;;
    *) die "unknown flag: $1" ;;
  esac
done

[[ "$PR" =~ ^[0-9]+$ ]] || die "usage: velo-gate-post <pr> <gate-name> <report-file|-> [--sha <sha>]"
[[ "$NAME" =~ ^[a-z0-9-]+$ ]] || die "gate name must be lowercase-kebab (e.g. codex-review), got '$NAME'"
[[ -n "$FILE" ]] || die "report file required ('-' to read stdin)"

if [[ "$FILE" == "-" ]]; then BODY=$(cat); else
  [[ -f "$FILE" ]] || die "report file not found: $FILE"
  BODY=$(cat "$FILE")
fi
[[ -n "${BODY// }" ]] || die "report is empty — refusing to post a gate result with no content"

# ---- is this a REPORT, or the brief it was supposed to overwrite? -----------
#
# Same defect as #2107's cost provenance, one tool along: that stamps
# source="openrouter-billed" over a usd it never received; this stamps
# `gate: <name> @ <sha>` over a report whose leg never ran.
#
# Hit for real on PR #2170 round 3. velo-pr-gate passed a flag the current codex
# CLI rejects (#2171), so the review leg died at launch and its log held only
# the unfilled brief template. Zero findings was read as a clean review, a
# summary claiming "all five attacks were run" was written by hand, and this
# script accepted it without objection. The PR then carried a
# `gate: code-review @ a43c3aabe` stamp for a review that never happened.
#
# velo-pr-gate's own gate_health_check DID catch it and printed "a dispatched
# gate died before doing any work" — but nothing downstream consults that
# verdict, and a human relaying a report by hand bypasses it entirely. That
# hand-relay is exactly the path that needs this check, not the one that should
# skip it.
#
# These markers cannot appear in a real report: a reviewer that produced output
# wrote OVER them.
TEMPLATE_MARKERS=(
  '<<< FILL THIS IN'
  '<!-- velo-gate-brief'
  '**Verdict:** approve | approve-with-findings | blocked'
)
for _m in "${TEMPLATE_MARKERS[@]}"; do
  if grep -qF -- "$_m" <<<"$BODY"; then
    die "refusing to post — this is the BRIEF TEMPLATE, not a report.

  Found an unfilled template marker:
    $_m

  A reviewer that ran would have written over it. Its presence means the leg
  died at launch (or was never dispatched) and the log still holds the brief.

  This is what put a 'gate: code-review' stamp on PR #2170 for a review that
  never ran. Check the leg's log before posting:
    tail -40 <gate-dir>/review.log

  If the leg really did die, re-dispatch it — do not hand-write a verdict for
  it."
  fi
done

# A CLI that refused to start leaves its usage text where the report should be.
if grep -qE '^(error|Usage): ' <<<"$BODY"; then
  die "refusing to post — the report contains a CLI usage/error line, so the
  gate process failed to start rather than producing findings:

$(grep -m3 -E '^(error|Usage): ' <<<"$BODY" | sed 's/^/    /')

  Fix the launch, re-run the gate, then post its real output."
fi

HEAD=$(gh pr view "$PR" --repo "$REPO" --json headRefOid --jq .headRefOid 2>/dev/null) \
  || die "PR #$PR not found"

if [[ -z "$SHA" ]]; then
  # Defaulting to HEAD is right only if the gate ran against HEAD. When the
  # report predates the current head — the usual case after fixing findings and
  # committing before posting — this default silently stamps coverage the gate
  # never had, which is the exact failure the `gate: <name> @ <sha>` convention
  # exists to prevent. Caught on PR #2141, where a code-review that ran at
  # bb1a36fba was stamped @ 206aa76f6, two commits later.
  #
  # So: if the report file is OLDER than the head commit, refuse and make the
  # caller say which sha it reviewed. Comparing mtimes is crude but it fails
  # closed, and the fix is one flag.
  if [[ "$FILE" != "-" && -f "$FILE" ]]; then
    HEAD_CT=$(git log -1 --format=%ct "$HEAD" 2>/dev/null || echo 0)
    FILE_MT=$(stat -f %m "$FILE" 2>/dev/null || stat -c %Y "$FILE" 2>/dev/null || echo 0)
    if [[ "$HEAD_CT" -gt 0 && "$FILE_MT" -gt 0 && "$FILE_MT" -lt "$HEAD_CT" ]]; then
      die "refusing to stamp this report against HEAD (${HEAD:0:9}).

  The report file is OLDER than the head commit, so the gate ran against an
  earlier one and stamping HEAD would claim coverage it does not have. A gate
  result is only valid for the commit it ran against.

    report mtime : $(date -u -r "$FILE_MT" +%FT%TZ 2>/dev/null || echo "$FILE_MT")
    HEAD commit  : $(date -u -r "$HEAD_CT" +%FT%TZ 2>/dev/null || echo "$HEAD_CT")

  Pass the sha the gate actually reviewed:
    velo-gate-post $PR $NAME $FILE --sha <sha>"
    fi
  fi
  SHA="$HEAD"
else
  # An explicit --sha is how you record a review of an OLDER head honestly,
  # rather than back-dating it onto the current one.
  [[ "$HEAD" == "$SHA"* ]] || printf '\033[33mwarn:\033[0m recording against %s, but head is now %s — this will read as STALE, which is correct if the review predates the newer commits.\n' "$SHA" "${HEAD:0:9}" >&2
fi

HDR="gate: $NAME @ ${SHA:0:9}"
# Do not double-stamp a report that already carries the header.
if grep -qiE "^gate: *$NAME *@" <<<"$BODY"; then
  FULL="$BODY"
  ok "report already carries its gate header"
else
  FULL="$HDR"$'\n\n'"$BODY"
fi

URL=$(gh pr comment "$PR" --repo "$REPO" --body "$FULL" 2>&1 | tail -1) \
  || die "could not post to #$PR: $URL"

ok "posted '$NAME' to #$PR @ ${SHA:0:9}"
echo "   $URL"
echo
echo "   Next: record the VERDICT — a comment says a gate RAN, the label says what it FOUND:"
echo "     velo-gate $PR --pass    # or --block"
