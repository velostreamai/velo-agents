#!/bin/bash
# velo-task - detached-work coordination on a pinned, hash-locked Vanth (docs/velo-task-spec.md). Vanth is the only state.
#   velo-task install-vanth    build the pinned venv from requirements/vanth.lock
#   velo-task ensure-daemon    adopt the daemon velo-task launched, or launch one (private, allowlisted environment)
#   velo-task restart-daemon   SIGTERM the validated daemon pid, then a clean launch
#   velo-task run <id> --timeout S [--issue N] [--stage ST] [--rerun] -- cmd...   start a job, print its job_id
#   velo-task status <id> | --job <job_id>   print `<id> <verdict>`: ok, failed(n), timeout, killed, lost or in-flight
#   velo-task wait <id>... [--any|--all] [--timeout S]   one `<id> <verdict>` line per id; exit 0 iff ok, 3 on timeout, 2 unknown id
#   velo-task cancel <id> | --job <job_id>   vanth stop, then the verdict (killed)
#   velo-task stop-override --reason <text>   let the current session end once although jobs are in flight (audited)
# <id> is the job's name in Vanth; the newest job of that exact name is meant. Exit codes: 0 ok, 1 error, 2 usage/unknown id, 3 timeout,
# 5 idempotency conflict, 6 daemon refused/down. The functions live in velo-task-lib.sh; nothing in the library is a subcommand.
set -euo pipefail

SELF_SRC="${BASH_SOURCE[0]}"
SELF_DIR="${SELF_SRC%/*}"; [ "$SELF_DIR" != "$SELF_SRC" ] || SELF_DIR=.
SELF="$(cd "$SELF_DIR" && pwd)/${SELF_SRC##*/}"
. "${SELF%/*}/velo-task-lib.sh"

usage() { /usr/bin/sed -n '2,/^set -euo/p' "$SELF" | /usr/bin/sed '$d; s/^# \{0,1\}//'; }
sub="${1:-}"; [ "$#" -eq 0 ] || shift
case "$sub" in
  install-vanth|ensure-daemon|restart-daemon)
    [ "$#" -eq 0 ] || die 2 "$sub takes no arguments"
    "cmd_${sub//-/_}" ;;
  run|status|wait|cancel|stop-override) "cmd_${sub//-/_}" "$@" ;;
  -h|--help|help|'') usage ;;
  *) die 2 "unknown subcommand '$sub' (available: install-vanth, ensure-daemon, restart-daemon, run, status, wait, cancel, stop-override)" ;;
esac
