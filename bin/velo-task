#!/bin/bash
# velo-task - detached-work coordination on a pinned, hash-locked Vanth (docs/velo-task-spec.md).
#
# M1 (foundation) implements only the install and daemon lifecycle:
#   velo-task install-vanth    build the pinned venv from requirements/vanth.lock (R11, R12)
#   velo-task ensure-daemon    adopt the daemon velo-task launched, or launch one (R6, R11, R18)
#   velo-task restart-daemon   SIGTERM the validated daemon pid, then a clean launch (R7, R18)
#   velo-task doctor           read-only report on install, allowlist, modes, provenance, schema
# Every other subcommand exits 2 ("not implemented in M1").
#
# Layout (VELO_TASK_HOME defaults to ${VELO_STATE:-~/.agents/state}/velo-task; tests override it):
#   venv/               pinned Vanth install      vanth/              VANTH_HOME = AGENT_BG_HOME
#   vanth.env.allow     secret NAMES the daemon may inherit (one per line)
#   daemon.provenance   pid, start time, launch digest, incarnation of the daemon WE launched
#   lock/daemon         per-home lock             daemon.launch.log   vanthd stdout/stderr
# VELO_TASK_PORT (default 48217) sets the daemon port. Tunables: VELO_TASK_START_WAIT,
# VELO_TASK_STOP_WAIT, VELO_TASK_LOCK_WAIT (seconds). Exit codes: 0 ok, 1 error, 2 usage,
# 6 daemon refused/down/misconfigured.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SELF="$HERE/${BASH_SOURCE[0]##*/}"
STATE_SCRIPT="$HERE/velo-task-state"
LOCKFILE="$HERE/../requirements/vanth.lock"
VELO_TASK_HOME="${VELO_TASK_HOME:-${VELO_STATE:-$HOME/.agents/state}/velo-task}"
export VELO_TASK_HOME
VENV="$VELO_TASK_HOME/venv"
PY="$VENV/bin/python"
VANTHD="$VENV/bin/vanthd"
VANTH="$VENV/bin/vanth"
MARKER="$VENV/.velo-task-installed"
VH="$VELO_TASK_HOME/vanth"
PORT="${VELO_TASK_PORT:-48217}"
ALLOW="$VELO_TASK_HOME/vanth.env.allow"
PROV="$VELO_TASK_HOME/daemon.provenance"
LAUNCH_LOG="$VELO_TASK_HOME/daemon.launch.log"
# Jobs inherit the daemon's environment: a fixed PATH, HOME, Vanth's own variables, allowlisted names.
JOB_PATH="$HOME/.agents/bin:$HOME/.local/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
NAME_RE='^[A-Z][A-Z0-9_]*$'
ALLOW_NAMES=""
PROV_WHY=""

die() { local code="$1"; shift; printf 'velo-task: %s\n' "$*" >&2; exit "$code"; }
st() { "$PY" "$STATE_SCRIPT" "$@"; }

case "$VELO_TASK_HOME" in /*) ;; *) die 2 "VELO_TASK_HOME must be an absolute path: $VELO_TASK_HOME" ;; esac
case "$PORT" in ''|*[!0-9]*) die 2 "VELO_TASK_PORT must be a number: $PORT" ;; esac

# ---- process identity (R11(d), R18): the start time is always rendered LC_ALL=C TZ=UTC ----------
ps_lstart() {  # <pid> -> start time, empty when no such process
  LC_ALL=C TZ=UTC /bin/ps -o lstart= -p "$1" 2>/dev/null | sed -e 's/  */ /g; s/^ //; s/ $//' || true
}
epoch_of_lstart() { LC_ALL=C date -j -u -f '%a %b %d %H:%M:%S %Y' "$1" +%s 2>/dev/null || true; }
epoch_of_iso() { date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s 2>/dev/null || true; }
djson() { jq -r ".$1 // empty" "$VH/daemon.json" 2>/dev/null || true; }
prov_get() { sed -n "s/^$1=//p" "$PROV" 2>/dev/null | head -n 1 || true; }
within_5s() {  # <epoch> <epoch>
  [ -n "$1" ] && [ -n "$2" ] && [ $(( $1 > $2 ? $1 - $2 : $2 - $1 )) -le 5 ]
}
signal_validated() {  # <signal> <pid> <expected lstart>: re-checks pid AND start time right before signalling
  local now
  now=$(ps_lstart "$2")
  [ -n "$now" ] && [ "$now" = "$3" ] || die 6 "refusing to signal pid $2: start time is '${now:-gone}', expected '$3'"
  kill "-$1" "$2"
}

# ---- allowlist (R11): names only, validated; reserved prefixes can never be passed on -------------
validate_allowlist() {
  ALLOW_NAMES=""
  [ -e "$ALLOW" ] || return 0
  [ -f "$ALLOW" ] || { echo "velo-task: $ALLOW is not a regular file" >&2; return 1; }
  local line key n=0 bad=0 p
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    key="${line#"${line%%[![:space:]]*}"}"
    key="${key%"${key##*[![:space:]]}"}"
    case "$key" in ''|'#'*) continue ;; esac
    if ! printf '%s\n' "$key" | LC_ALL=C grep -Eq "$NAME_RE"; then
      echo "velo-task: $ALLOW line $n: not a valid variable name (value not shown)" >&2; bad=1; continue
    fi
    for p in PATH HOME IFS ENV BASH_ENV SHELLOPTS PYTHON DYLD_ LD_ VANTH_ VELO_TASK_ AGENT_BG_ TMPDIR; do
      case "$key" in "$p"*) echo "velo-task: $ALLOW line $n: $key is not allowed (reserved: $p)" >&2; bad=1; continue 2 ;; esac
    done
    ALLOW_NAMES="$ALLOW_NAMES$key"$'\n'
  done < "$ALLOW"
  ALLOW_NAMES=$(printf '%s' "$ALLOW_NAMES" | LC_ALL=C sort -u)
  [ "$bad" -eq 0 ]
}
need_allowlist() { validate_allowlist || die 6 "allowlist rejected, nothing was started; fix $ALLOW"; }

need_install() {
  [ -f "$MARKER" ] && [ -x "$PY" ] && [ -x "$VANTHD" ] && [ -x "$VANTH" ] \
    || die 6 "Vanth is not installed in $VENV; run: velo-task install-vanth"
}

# ---- probe, launch digest, provenance, modes ----------------------------------------------------
vanth_env() { /usr/bin/env -i PATH="$JOB_PATH" HOME="$HOME" VANTH_HOME="$VH" AGENT_BG_HOME="$VH" VANTH_DAEMON_PORT="$PORT" "$@"; }
probe_up() {  # bare `vanth --json status` is the health probe: it never autostarts a daemon (R6)
  local out
  out=$(vanth_env "$VANTH" --json status 2>/dev/null) || true
  [ "$(printf '%s' "$out" | jq -r '.up // false' 2>/dev/null || true)" = true ]
}
launch_spec() {  # the launch command with allowlisted NAMES only: values are never recorded
  printf 'velo-task-launch-v1\numask=077\nvanthd=%s\nPATH=%s\nHOME=%s\nVANTH_HOME=%s\nAGENT_BG_HOME=%s\n' \
    "$VANTHD" "$JOB_PATH" "$HOME" "$VH" "$VH"
  printf 'VANTH_DAEMON_PORT=%s\nVANTH_RETENTION_SECONDS=0\n' "$PORT"
  [ -z "$ALLOW_NAMES" ] || printf 'allow=%s\n' $ALLOW_NAMES
}
launch_digest() { launch_spec | st sha256; }
prov_valid() {  # sets PROV_WHY when the running daemon is not provably the one we launched
  local pid recorded dj live
  PROV_WHY=""
  [ -f "$PROV" ] || { PROV_WHY="no $PROV: this daemon was not launched by velo-task"; return 1; }
  pid=$(prov_get pid); recorded=$(prov_get lstart)
  { [ -n "$pid" ] && [ -n "$recorded" ] && [ -n "$(prov_get digest)" ] && [ -n "$(prov_get incarnation)" ]; } \
    || { PROV_WHY="$PROV is incomplete"; return 1; }
  dj=$(djson pid)
  [ "$dj" = "$pid" ] || { PROV_WHY="daemon.json pid '$dj' differs from provenance pid '$pid'"; return 1; }
  live=$(ps_lstart "$pid")
  [ -n "$live" ] || { PROV_WHY="provenance pid $pid is not running"; return 1; }
  [ "$live" = "$recorded" ] || { PROV_WHY="pid $pid started '$live', provenance says '$recorded' (stale provenance or reused pid)"; return 1; }
  within_5s "$(epoch_of_lstart "$recorded")" "$(epoch_of_iso "$(djson started_at)")" \
    || { PROV_WHY="daemon.json started_at is not within 5 s of the provenance start time"; return 1; }
  [ "$(prov_get digest)" = "$(launch_digest)" ] \
    || { PROV_WHY="launch digest differs from the current configuration (port, retention, allowlist or paths)"; return 1; }
}
modes_problem() {  # prints the first mode looser than 0700 (home) / 0600 (files), else nothing
  local f m
  m=$(/usr/bin/stat -f %Lp "$VH")
  [ $(( 8#$m & 8#077 )) -eq 0 ] || { echo "$VH has mode $m, must be 700"; return 0; }
  for f in jobs.sqlite daemon.json token; do
    [ -e "$VH/$f" ] || continue
    m=$(/usr/bin/stat -f %Lp "$VH/$f")
    [ $(( 8#$m & 8#077 )) -eq 0 ] || { echo "$VH/$f has mode $m, must be 600"; return 0; }
  done
}
need_modes() {
  local p
  p=$(modes_problem)
  [ -z "$p" ] || die 6 "$p; refusing. A clean launch tightens it: velo-task restart-daemon"
}
refuse_unproven() {
  die 6 "a daemon answers on port $PORT but is not provably the one velo-task launched ($PROV_WHY); refusing to adopt it. Run: velo-task restart-daemon"
}

launch_daemon() {  # caller holds the daemon lock
  local args k pid started
  mkdir -p -m 700 "$VH"
  /bin/chmod -R go-rwx "$VH"  # new files are 0600 via umask; files an earlier loose daemon made are tightened
  args=(PATH="$JOB_PATH" HOME="$HOME" VANTH_HOME="$VH" AGENT_BG_HOME="$VH" VANTH_DAEMON_PORT="$PORT" VANTH_RETENTION_SECONDS=0)
  for k in $ALLOW_NAMES; do
    if [ "${!k+set}" = set ]; then args[${#args[@]}]="$k=${!k}"; fi
  done
  rm -f "$PROV"
  # env -i: jobs see exactly the lines above and nothing else from the caller (R11(b)). The values
  # sit in env's argv only until it execs vanthd. umask 077 makes jobs.sqlite, logs/, events/ and
  # daemon.json private (R11(c)). Own process group, stdio detached from the caller.
  set -m
  ( umask 077; exec /usr/bin/env -i "${args[@]}" "$VANTHD" </dev/null >"$LAUNCH_LOG" 2>&1 ) &
  pid=$!
  set +m
  started=$(ps_lstart "$pid")
  local i=0 limit=$(( ${VELO_TASK_START_WAIT:-20} * 5 ))
  while [ "$i" -lt "$limit" ]; do
    kill -0 "$pid" 2>/dev/null || break
    if probe_up && [ "$(djson pid)" = "$pid" ]; then break; fi
    sleep 0.2; i=$((i + 1))
  done
  if ! { kill -0 "$pid" 2>/dev/null && probe_up && [ "$(djson pid)" = "$pid" ]; }; then
    if kill -0 "$pid" 2>/dev/null && [ -n "$started" ]; then signal_validated TERM "$pid" "$started"; fi
    die 6 "vanthd did not become ready on port $PORT; see $LAUNCH_LOG: $(tail -n 3 "$LAUNCH_LOG" 2>/dev/null | tr '\n' ' ')"
  fi
  [ "$(ps_lstart "$pid")" = "$started" ] || die 6 "vanthd pid $pid changed identity during launch"
  ( umask 077; printf 'pid=%s\nlstart=%s\ndigest=%s\nincarnation=%s\n' "$pid" "$started" "$(launch_digest)" \
    "$(/usr/bin/uuidgen)" > "$PROV.tmp.$$" )
  st publish "$PROV" "$PROV.tmp.$$"  # R17: fsync, no-clobber link, fsync dir; $PROV was removed above, so it is free
  need_modes
  printf 'daemon up pid=%s port=%s (started)\n' "$pid" "$PORT"
}

run_locked() {  # <internal subcommand>: re-run this script holding the per-home daemon lock
  local rc=0
  st lock --timeout "${VELO_TASK_LOCK_WAIT:-60}" "$VELO_TASK_HOME/lock/daemon" -- "$SELF" "$1" || rc=$?
  case "$rc" in 0) ;; 75) die 6 "timed out waiting for the daemon lock $VELO_TASK_HOME/lock/daemon" ;; *) exit "$rc" ;; esac
}

cmd_ensure_daemon() {
  need_install; need_allowlist
  if probe_up && prov_valid; then
    need_modes
    printf 'daemon up pid=%s port=%s (adopted)\n' "$(djson pid)" "$PORT"
    return 0
  fi
  run_locked _locked-ensure
}
locked_ensure() {  # R18: re-probe now that we hold the lock; another caller may have started it
  need_install; need_allowlist
  if probe_up; then
    prov_valid || refuse_unproven
    need_modes
    printf 'daemon up pid=%s port=%s (adopted)\n' "$(djson pid)" "$PORT"
  else
    st failpoint daemon.lock.held  # between the probe and the launch: where a missing lock would race
    launch_daemon
  fi
}

cmd_restart_daemon() { need_install; need_allowlist; run_locked _locked-restart; }
locked_restart() {
  need_install; need_allowlist
  st failpoint daemon.lock.held
  local pid live cmd recorded
  pid=$(djson pid)
  if [ -z "$pid" ]; then
    ! probe_up || die 6 "a daemon answers on port $PORT but $VH/daemon.json is missing; its pid cannot be identified, stop it by hand"
  else
    live=$(ps_lstart "$pid")
    if [ -n "$live" ]; then
      # Identity before any signal: the pid must be the process that wrote daemon.json (start time within
      # 5 s of started_at), must be a vanthd, and when our provenance names this pid it must agree.
      within_5s "$(epoch_of_lstart "$live")" "$(epoch_of_iso "$(djson started_at)")" \
        || die 6 "pid $pid started '$live', not within 5 s of daemon.json started_at: reused pid, not signalled"
      cmd=$(/bin/ps -o command= -p "$pid" 2>/dev/null || true)
      case "$cmd" in *vanthd*|*vanth.daemon*) ;; *) die 6 "pid $pid is not a vanthd ($cmd): not signalled" ;; esac
      recorded=$(prov_get lstart)
      if [ "$(prov_get pid)" = "$pid" ] && [ "$recorded" != "$live" ]; then
        die 6 "pid $pid start time differs from the provenance record: reused pid, not signalled"
      fi
      signal_validated TERM "$pid" "$live"
      local i=0 limit=$(( ${VELO_TASK_STOP_WAIT:-20} * 5 ))
      while kill -0 "$pid" 2>/dev/null && [ "$i" -lt "$limit" ]; do sleep 0.2; i=$((i + 1)); done
      ! kill -0 "$pid" 2>/dev/null || die 6 "vanthd pid $pid still running ${VELO_TASK_STOP_WAIT:-20}s after SIGTERM; not escalating"
    fi
  fi
  launch_daemon
}

# ---- install-vanth (R11, R12, B23): lock + --require-hashes + wheels only, then assert -------------
norm_names() { awk -F'==' '{ n = tolower($1); gsub(/[-_.]+/, "-", n); print n "==" $2 }'; }
venv_in_use() { [ -x "$VANTH" ] && probe_up; }  # a daemon answers while this venv holds the code it runs
fail_install() {
  ! venv_in_use || die 6 "install-vanth: $*; a daemon is running from $VENV, so the venv was left in place. Stop the daemon first (SIGTERM the pid in $VH/daemon.json), then re-run install-vanth"
  rm -rf "$VENV"; die 1 "install-vanth failed, $VENV removed: $*"
}
verify_install() {
  local site tmp locked installed
  locked=$(sed -n 's/^\([A-Za-z0-9._-]*==[^ ]*\).*/\1/p' "$LOCKFILE" | norm_names | LC_ALL=C sort -u)
  installed=$(uv pip freeze --no-config --python "$PY" | norm_names | LC_ALL=C sort -u) || fail_install "uv pip freeze"
  [ "$locked" = "$installed" ] \
    || fail_install "installed distributions differ from the lock: $(diff <(echo "$locked") <(echo "$installed") | tr '\n' ' ')"
  site=$("$PY" -c 'import os, vanth; print(os.path.dirname(vanth.__file__))') || fail_install "vanth is not importable"
  grep -rqF --include='*.py' 'trigger parent reached an incompatible terminal status' "$site" \
    || fail_install "the pinned trigger-parent stop reason is absent from the installed Vanth (R1)"
  tmp=$(mktemp -d "$VENV/schema.XXXXXX")  # inside the venv: fail_install removes it with the venv
  "$PY" -c 'import sqlite3, sys; from vanth.migrations import migrate; db = sqlite3.connect(sys.argv[1] + "/jobs.sqlite"); migrate(db, sys.argv[1]); db.close()' "$tmp" \
    || fail_install "the installed Vanth could not create its schema"
  st jobs-ro "$tmp/jobs.sqlite" 'SELECT 1 AS ok' >/dev/null || fail_install "the installed Vanth schema lacks columns the spec reads (R8)"
  rm -rf "$tmp"
}
cmd_install_vanth() {
  [ -f "$LOCKFILE" ] || die 1 "lock file not found: $LOCKFILE"
  mkdir -p -m 700 "$VELO_TASK_HOME"
  local want
  if [ -x "$PY" ] && [ -f "$MARKER" ]; then
    want=$(st sha256 "$LOCKFILE")
    if [ "$(cat "$MARKER")" = "$want" ]; then
      verify_install
      echo "install-vanth: already installed from the current lock"
      return 0
    fi
  fi
  if venv_in_use; then
    die 6 "a daemon is running from $VENV; stop it before replacing the venv (SIGTERM the pid in $VH/daemon.json)"
  fi
  rm -f "$MARKER"
  uv venv --no-config --python 3.12 --clear "$VENV" || fail_install "uv venv"
  uv pip install --no-config --python "$PY" --default-index https://pypi.org/simple \
    --require-hashes --only-binary :all: -r "$LOCKFILE" || fail_install "uv pip install"
  verify_install
  st sha256 "$LOCKFILE" > "$MARKER"
  echo "install-vanth: installed $(sed -n 's/^vanth==\([^ ]*\).*/\1/p' "$LOCKFILE") into $VENV"
}

# ---- doctor: read-only; never starts, signals or modifies anything -------------------------------
cmd_doctor() {
  local rc=0 p
  ok() { printf 'ok   %s\n' "$*"; }
  bad() { printf 'FAIL %s\n' "$*"; rc=1; }
  if [ -f "$MARKER" ] && [ -x "$PY" ] && [ -x "$VANTHD" ] && [ -x "$VANTH" ]; then
    if [ "$(cat "$MARKER")" = "$(st sha256 "$LOCKFILE")" ]; then ok "install: $VENV matches the lock"
    else bad "install: $VENV was built from a different lock; run velo-task install-vanth, then restart-daemon"; fi
  else
    bad "install: no complete venv at $VENV; run velo-task install-vanth"; return "$rc"
  fi
  if validate_allowlist 2>/dev/null; then ok "allowlist: $(printf '%s' "$ALLOW_NAMES" | grep -c . || true) key(s)"
  else bad "allowlist: rejected (see: velo-task ensure-daemon)"; fi
  if [ ! -d "$VH" ]; then ok "daemon: never started (home $VH absent)"
  elif probe_up; then
    ok "daemon: up on port $PORT (pid $(djson pid))"
    if prov_valid; then ok "provenance: valid"; else bad "provenance: $PROV_WHY (run: velo-task restart-daemon)"; fi
    case "$(djson url)" in http://127.0.0.1:*) ok "bind: 127.0.0.1" ;; *) bad "bind: daemon.json url is '$(djson url)', expected 127.0.0.1" ;; esac
    p=$(modes_problem); if [ -z "$p" ]; then ok "modes: private"; else bad "modes: $p"; fi
  else
    ok "daemon: down (ensure-daemon starts it)"
  fi
  if [ -f "$VH/jobs.sqlite" ]; then
    if st jobs-ro "$VH/jobs.sqlite" 'SELECT 1 AS ok' >/dev/null; then ok "schema: matches the spec's columns"
    else bad "schema: jobs-ro exit $? (4 locked, 5 mismatch)"; fi
  fi
  return "$rc"
}

usage() { sed -n '2,/^set -euo/p' "$SELF" | sed '$d; s/^# \{0,1\}//'; }
sub="${1:-}"; [ "$#" -eq 0 ] || shift
case "$sub" in
  install-vanth|ensure-daemon|restart-daemon|doctor)
    [ "$#" -eq 0 ] || die 2 "$sub takes no arguments"
    "cmd_${sub//-/_}" ;;
  _locked-ensure) locked_ensure ;;
  _locked-restart) locked_restart ;;
  -h|--help|help|'') usage ;;
  *) die 2 "'$sub' is not implemented in M1 (available: install-vanth, ensure-daemon, restart-daemon, doctor)" ;;
esac
