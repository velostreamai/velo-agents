#!/bin/bash
# velo-gate — record and enforce a PR's review-gate state.
#
#   velo-gate <pr>                 show gate state (and whether it is stale)
#   velo-gate <pr> --plan          print which gates this PR needs, and why
#   velo-gate <pr> --running       mark gates dispatched (sets gate:running)
#   velo-gate <pr> --pass          record a clean gate  (sets gate:passed)
#   velo-gate <pr> --block         record a blocked gate (sets gate:blocked)
#
# Gate state lives in a LABEL, not in someone's memory, so "not gated" is
# visible rather than merely absent. A gate result is bound to the commit it
# ran against: if the head moves, the label goes stale and `velo-merge`
# refuses. That is the failure this exists to prevent — a PR once reported
# green CI against a commit that had already been replaced.
#
# --pass compares EVERY gate's freshest comment to head, and refuses when the comments
# cannot be read at all. --show says so rather than "nothing has been recorded" and exits 1
# (see read_gate_comments). Likewise --plan does not print a plan it could not complete: a
# linked issue that cannot be read is not one with no acceptance bars (see gh_read).

set -uo pipefail
REPO="velostreamai/velostream"
VELO_STATE="${VELO_STATE:-$HOME/.agents/state}"
die()  { printf '\n\033[31m%s\033[0m %s\n\n' "ERROR:" "$1" >&2; exit 1; }
ok()   { printf '\033[32m  ok\033[0m %s\n' "$1"; }
warn() { printf '\033[33mwarn:\033[0m %s\n' "$1" >&2; }

# A gh read whose FAILURE is told apart from an empty answer. Every guard below keys on a
# value being empty or not, and a failed read comes back empty: a caller that cannot tell
# the two apart skips the guard exactly when gh is unwell. stderr is kept (gh's first line
# is the reason), the status is the function's, and a scratch dir that cannot be written
# costs the message, not the check.
#   -> $GH_OUT (stdout), $GH_ERR (set on failure), return 0 / 1
GH_OUT=""; GH_ERR=""
gh_read() {   # <gh args...>
  local errf rc
  GH_OUT=""; GH_ERR=""
  if errf=$(mktemp "${TMPDIR:-/tmp}/velo-gate-err.XXXXXX"); then
    GH_OUT=$(gh "$@" 2>"$errf"); rc=$?
    GH_ERR=$(head -1 "$errf" 2>/dev/null); rm -f "$errf"
  else
    GH_OUT=$(gh "$@" 2>/dev/null); rc=$?
    GH_ERR="(gh's own message was not captured: could not create a scratch file in ${TMPDIR:-/tmp})"
  fi
  if [[ $rc -ne 0 ]]; then
    GH_ERR="${GH_ERR:-gh exited $rc with no message}"
    return 1
  fi
  GH_ERR=""
}

PR="${1:-}"; MODE="${2:---show}"
[[ "$PR" =~ ^[0-9]+$ ]] || die "usage: velo-gate <pr> [--plan|--running|--pass|--block]"

META=$(gh pr view "$PR" --repo "$REPO" --json headRefOid,labels,files,state,title,body 2>/dev/null) \
  || die "PR #$PR not found"

HEAD=$(jq -r .headRefOid <<<"$META")
SHORT="${HEAD:0:9}"
STATE=$(jq -r .state <<<"$META")
TITLE=$(jq -r .title <<<"$META")
LABELS=$(jq -r '[.labels[].name]|join(",")' <<<"$META")
# The gate's verdict is ONE label, read from MANY: a PR can carry several `gate:*` labels at once
# (a `--remove-label` that failed, or one added by hand in the UI). Two of them are no verdict, and
# naming either as THE label is a guess — so they are counted, and more than one is reported as
# exactly that. velo-merge reads the same labels the same way.
GATE_LABELS=$(tr ',' '\n' <<<"$LABELS" | grep '^gate:' || true)
GATE_AMBIGUOUS=""
case "$(grep -c . <<<"$GATE_LABELS" || true)" in
  0) CUR="gate:none" ;;
  1) CUR="$GATE_LABELS" ;;
  *) GATE_AMBIGUOUS=$(tr '\n' ' ' <<<"$GATE_LABELS" | sed 's/ $//')
     CUR="$GATE_AMBIGUOUS  (AMBIGUOUS: a PR has one gate label)" ;;
esac

# Who ran check-code for this PR's current gate run: velo-pr-gate records the
# route in gate/<pr>/check-code.by. A substituted reviewer must never be silent,
# so every mode that reports gate state repeats it — otherwise the label reads as
# an opus:high result that never happened. velo-gate-post puts the same
# declaration on the posted comment.
CC_BY=""
[[ -f "$VELO_STATE/gate/$PR/check-code.by" ]] && CC_BY=$(tr -d '[:space:]' < "$VELO_STATE/gate/$PR/check-code.by")
SUBST=""; SUBST_SHOW=""
case "$CC_BY" in
  sonnet)
    SUBST=" [check-code: SUBSTITUTED reviewer, a read-only Sonnet agent and not opus:high; declared in the gate comment]"
    SUBST_SHOW="run by a SUBSTITUTED reviewer (read-only Sonnet agent, not opus:high) — declared in the gate comment" ;;
  deepseek|haiku|glm|free)
    # #2350: the OpenRouter routes are advisory, never a gating verdict.
    SUBST=" [check-code: ADVISORY, run by $CC_BY on OpenRouter and not a Claude reviewer; Codex code-review is the gating leg; declared in the gate comment]"
    SUBST_SHOW="ADVISORY — run by $CC_BY on OpenRouter, not a Claude reviewer; Codex code-review is the gating leg — declared in the gate comment" ;;
esac

# --- which gates does this PR need? ------------------------------------------
FILES=$(jq -r '[.files[].path]|join("\n")' <<<"$META")
TOUCHES_SRC=$(grep -c '^src/' <<<"$FILES" || true)
TOUCHES_TEST=$(grep -c '^tests/' <<<"$FILES" || true)
NFILES=$(grep -c . <<<"$FILES" || true)
# A linked issue with several acceptance bullets warrants check-spec. EVERY issue the body closes
# is linked: GitHub closes them all on merge, so each one's bars are this PR's business — scanning
# for the first alone dropped check-spec for a PR whose second issue carried the bars. The
# keywords are GitHub's own (close / fix / resolve and their inflections, any case, an optional
# colon), matched as whole words, each issue once, in ascending order.
ISSUES=$(jq -r '(.body // "")
                | [scan("\\b(?:close[sd]?|fix(?:es|ed)?|resolve[sd]?):?\\s+#([0-9]+)"; "i") | .[0] | tonumber]
                | unique | .[]' <<<"$META") \
  || die "could not read the body of #$PR to find the issues it closes"
BARS=0; SPEC_BULLET=""; BARS_ERR=""; BARS_UNREADABLE=""
# An issue that cannot be READ is not an issue with no acceptance bullets. Counted as 0 it
# silently dropped check-spec from the plan — the failure the rules below were first written
# for — so the read is checked, and the plan is not printed without it. Only --plan and --show
# print a plan, so only they read the issues.
bars_of() {   # <issue> -> BARS ; returns 1 (GH_ERR set) when the issue cannot be read
  BARS=0
  if ! gh_read issue view "$1" --repo "$REPO" --json body --jq .body; then
    return 1
  fi
  BARS=$(awk '
             # Close only on a heading at the SAME OR SHALLOWER depth than the
             # one that opened the range. The previous regex closed on ANY
             # heading, so bars under a subsection were never counted:
             #   ## Acceptance
             #   ### Parser        <- closed the range here, count 0
             #   - parses A
             # Fenced blocks are skipped: an example "# Acceptance" inside one cannot
             # open a bogus range, and a "# comment" line in a shell block cannot close
             # the real one. CommonMark rules, the same grammar velo-dispatch
             # brief_prose and velo-gate-run extract_attack read (test_fence_parity.py
             # drives all three): an opener is up to three SPACES of indent then 3+
             # backticks or tildes (a backtick opener cannot carry a backtick in its info
             # string); only a line of the same character, at least as long, followed by
             # nothing but spaces, tabs (and a CR) closes it; an unclosed fence runs to
             # the end. A TAB in the leading whitespace reaches column 4 at once, so such
             # a line is indented code, never an opener or a closer. The old toggle on
             # any line starting with three backticks missed every indented fence (as
             # inside a list item), every tilde fence, and closed on an info-string line.
             {
               ind = 0
               while (substr($0, ind + 1, 1) == " ") ind++
               rest = substr($0, ind + 1)
               ch = substr(rest, 1, 1)
               run = 0
               if (ind <= 3 && (ch == "`" || ch == "~"))
                 while (substr(rest, run + 1, 1) == ch) run++
               if (fch == "") {
                 if (run >= 3 && (ch == "~" || index(substr(rest, run + 1), "`") == 0)) { fch = ch; flen = run; next }
               } else {
                 if (ch == fch && run >= flen && substr(rest, run + 1) ~ /^[ \t\r]*$/) fch = ""
                 next
               }
             }
             /^#+[ \t]*Acceptance/ && !inrange { inrange=1; depth=index($0," ")-1; next }
             inrange && /^#+[ \t]/ {
               d=index($0," ")-1
               if (d <= depth) { inrange=0; next }
             }
             inrange && /^[ \t]*[-*][ \t]/ { n++ }
             END { print n+0 }' <<<"$GH_OUT")
}

# Every closed issue is read, so that one that cannot be is named together with the others that
# cannot, and a PR is as demanding as its most demanding issue.
#   -> SPEC_BULLET   the issues that warrant check-spec ("#12 has 4 acceptance bars, ...");
#                    empty when none does
#   returns 1        some issue could not be read: BARS_UNREADABLE names it (or them) and
#                    BARS_ERR says why (gh's own message, per issue when there are several)
count_acceptance_bars() {
  local n bad="" errs="" lone="" nbad=0 hit=""
  SPEC_BULLET=""; BARS_ERR=""; BARS_UNREADABLE=""
  for n in $ISSUES; do
    if bars_of "$n"; then
      [[ "$BARS" -ge 3 ]] && hit="${hit:+$hit, }#$n has $BARS acceptance bars"
    else
      nbad=$((nbad + 1)); bad="${bad:+$bad, }#$n"; lone="$GH_ERR"; errs="${errs:+$errs; }#$n: $GH_ERR"
    fi
  done
  SPEC_BULLET="$hit"
  if [[ $nbad -eq 1 ]]; then
    BARS_UNREADABLE="issue $bad"; BARS_ERR="$lone"; return 1
  elif [[ $nbad -gt 1 ]]; then
    BARS_UNREADABLE="issues $bad"; BARS_ERR="$errs"; return 1
  fi
}

# The orchestration scripts are not "just tooling": they are what GUARANTEES
# every other gate's premise. velo-dispatch decides the tree a worker starts
# from; velo-gate decides which gates run at all; velo-pr-gate decides who runs
# them. A defect there is systemic — it does not fail loudly in one PR, it
# silently weakens every run after it.
#
# Measured, in one session: velo-gate's acceptance-bar regex matched prose and
# silently skipped check-spec entirely; velo-dispatch reused a worktree 15
# commits behind master while printing "off origin/master <sha>", costing a full
# worker run and producing a brief that instructed the worker to reinstate an
# escape hatch master had already deleted. All the fixes were authored and
# merged with NO independent review, because this function classified them as
# "no buildable code".
#
# Compilability was never the right test. Blast radius is.
# bin/ and rules/ are the executables and policy. tasks/ and skills/ are read
# AS INPUT by those executables — a task sidecar carries the design pinning,
# review attestation, anchors and blast radius dispatch validates against, and a
# skill IS the instruction text a worker runs on. install/update.sh put any of
# it in place. Weakening a sidecar constraint or swapping an installed policy is
# a change to how every run behaves, and scored 0 under a bin|rules-only rule.
TOUCHES_ORCH=$(( $(grep -cE '^\.agents/(bin|rules|skills|tasks)/' <<<"$FILES" || true) \
               + $(grep -cE '^\.agents/(install|update)\.sh$' <<<"$FILES" || true) ))

NEED=()
build_need() {   # -> NEED; returns 1 (BARS_UNREADABLE / BARS_ERR set) when a linked issue could not be read
  NEED=()
  if [[ "$TOUCHES_ORCH" -gt 0 ]]; then
    NEED+=("code-review  (orchestration: $TOUCHES_ORCH file(s) under .agents/ — governs every other run)")
    [[ "$TOUCHES_SRC" -gt 0 ]] && NEED+=("check-code   (src/ touched: $TOUCHES_SRC files)")
  elif [[ "$TOUCHES_SRC" -eq 0 && "$TOUCHES_TEST" -eq 0 ]]; then
    NEED+=("none — docs only, no buildable code and no orchestration")
  else
    NEED+=("code-review  (independent reviewer)")
    [[ "$TOUCHES_SRC" -gt 0 ]] && NEED+=("check-code   (src/ touched: $TOUCHES_SRC files)")
    if [[ -n "$ISSUES" ]]; then
      count_acceptance_bars || return 1
      [[ -n "$SPEC_BULLET" ]] && NEED+=("check-spec   ($SPEC_BULLET)")
    fi
  fi
  return 0
}

# --- the recorded gate SHAs, from the gate comments ----------------------------
#
# ONE state is derived from MANY comments, so it is reduced conservatively: the FRESHEST
# comment per gate name (a gate that was re-run posts a second comment, and the old one must
# not condemn it), and the PR is current only if EVERY name's freshest sha is the head. This
# used to read the newest comment alone (`| last | .s`), so a check-code result for a commit
# that no longer existed passed whenever a later code-review comment named the head — the
# failure velo-merge's stale-gate check was fixed for, in the same shape.
#
# A read that FAILS is not "no gate comment". With nothing recorded there is nothing to
# compare, and --pass has nothing to refuse on; a failed read (network down, API 5xx, an
# expired token) taken as empty used to skip the guard and label a stale head gate:passed.
# The states stay apart:
#   gh failed, or printed something that is not a gate list   read_gate_comments returns 1;
#                                                             GATES_ERR says why
#   gh answered, no `gate: <name> @ <sha>` comment            GATES is empty
#   gh answered                                               GATES: "<name> <sha>" per gate
# Only --pass and --show use it, so only they read it.
GATES=""; GATES_ERR=""; STALE_GATES=""
# The grammar velo-merge reads the same comments by: a gate name is `[a-z0-9-]+` (what
# velo-gate-post mints), and a header with no readable sha is a gate that names no commit — `-`,
# never "no comment", or a `check-code @ pending` posted over a good one is invisible here while
# velo-merge counts the gate as recorded.
GATE_LINE_RE='^[a-z0-9-]+ ([0-9a-f]{7,40}|-)$'
# Comments arrive oldest-first, so a later comment for the same name replaces the earlier.
GATE_JQ='[.comments[].body | capture("gate: *(?<n>[a-z0-9-]+) *@ *(?<s>[0-9a-f]{7,40})?")]
         | reduce .[] as $g ({}; .[$g.n] = ($g.s // "-")) | to_entries[] | "\(.key) \(.value)"'
read_gate_comments() {
  local line
  GATES=""; GATES_ERR=""
  if ! gh_read pr view "$PR" --repo "$REPO" --json comments --jq "$GATE_JQ"; then
    GATES_ERR="$GH_ERR"
    return 1
  fi
  while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    if [[ ! "$line" =~ $GATE_LINE_RE ]]; then
      GATES_ERR="gh answered with something that is not a gate list: '${line:0:60}'"
      return 1
    fi
  done <<<"$GH_OUT"
  GATES_ERR=""; GATES="$GH_OUT"
}
# One "<name> ran at <sha>" line per gate whose freshest comment is not the head, and one
# "<name> names no commit" line per gate whose freshest comment carries no readable sha.
stale_gates() {
  local gname gsha
  STALE_GATES=""
  while read -r gname gsha; do
    [[ -z "$gname" ]] && continue
    if [[ "$gsha" == "-" ]]; then
      STALE_GATES="$STALE_GATES
    $gname names no commit (its 'gate: $gname @' header carries no readable sha, so it cannot be compared to head)"
    elif [[ "$HEAD" != "$gsha"* ]]; then
      STALE_GATES="$STALE_GATES
    $gname ran at $gsha"
    fi
  done <<<"$GATES"
}

SHOW_RC=0
case "$MODE" in
  --plan)
    build_need \
      || die "could not read $BARS_UNREADABLE, which #$PR closes, to count its acceptance bars: $BARS_ERR
  Refusing to print a gate plan that may be missing check-spec."
    echo "#$PR  $TITLE"
    echo "  files: $NFILES (src=$TOUCHES_SRC tests=$TOUCHES_TEST)"
    echo "  gates needed:"; printf '    - %s\n' "${NEED[@]}"
    ;;
  --running|--pass|--block)
    NEW="gate:running"; [[ "$MODE" == "--pass" ]] && NEW="gate:passed"
    [[ "$MODE" == "--block" ]] && NEW="gate:blocked"
    if [[ "$MODE" == "--pass" ]]; then
      read_gate_comments \
        || die "could not read the gate comments for #$PR: $GATES_ERR
  Refusing to mark passed: without them there is no telling whether a gate ran against a
  commit other than head ($SHORT), and a stale gate would pass. Nothing was changed."
      stale_gates
      [[ -z "$STALE_GATES" ]] \
        || die "refusing to mark passed: head is $SHORT, but:$STALE_GATES
  Re-run the gate against the current head."
    fi
    # The old verdict label is removed BEFORE the new one is added, and a removal that fails stops
    # the run: adding beside a label that could not be removed would leave two gate labels, a PR
    # with no verdict. Only labels that are on the PR are removed (the read at the top is the
    # list), so no failure here is one that is expected and safe to ignore.
    for l in gate:none gate:running gate:passed gate:blocked; do
      [[ "$l" == "$NEW" ]] && continue
      [[ ",$LABELS," == *",$l,"* ]] || continue
      gh pr edit "$PR" --repo "$REPO" --remove-label "$l" >/dev/null 2>&1 \
        || die "could not set $NEW: the old label $l could not be removed from #$PR first, and adding $NEW
  beside it would leave two gate labels — a PR with no verdict. Nothing was added; $l is still on it."
    done
    gh pr edit "$PR" --repo "$REPO" --add-label "$NEW" >/dev/null 2>&1 \
      && ok "#$PR -> $NEW (head $SHORT)$SUBST" || die "could not set $NEW"
    ;;
  --show)
    echo "#$PR  $TITLE"
    echo "  head       : $SHORT"
    echo "  gate label : $CUR"
    [[ -n "$SUBST_SHOW" ]] && echo "  check-code : $SUBST_SHOW"
    if [[ -n "$GATE_AMBIGUOUS" ]]; then
      warn "ambiguous gate labels ($GATE_AMBIGUOUS) — the label is the gate's verdict, and two of them is no verdict.
       One is stale (a label that could not be removed, or one added by hand). Re-record it, which
       replaces them: velo-gate $PR --pass | --block"
      SHOW_RC=1
    fi
    if ! read_gate_comments; then
      # Not "nothing has been recorded": the read failed, so nothing is known.
      warn "could not read the gate comments for #$PR: $GATES_ERR
       Cannot say whether the gate is current — this is not 'no gate comment'."
      SHOW_RC=1
    else
      stale_gates
      if [[ -z "$GATES" ]]; then
        warn "no 'gate: <name> @ <sha>' comment found — nothing has been recorded"
      elif [[ -n "$STALE_GATES" ]]; then
        warn "STALE — head is now $SHORT, but:$STALE_GATES
       Re-gate before merging."
      elif [[ "$CUR" == "gate:passed" ]]; then
        ok "every gate comment matches the current head"
      else
        warn "every gate comment names the current head, but the label is '$CUR'.
       A comment records that a gate RAN; only the label records its VERDICT.
       Set it once the reviewers report: velo-gate $PR --pass | --block"
      fi
    fi
    if ! build_need; then
      warn "could not read $BARS_UNREADABLE, which #$PR closes, to count its acceptance bars: $BARS_ERR
       The plan below is INCOMPLETE: whether check-spec is needed is unknown, not 'no'."
      SHOW_RC=1
    fi
    echo "  gates needed:"; printf '    - %s\n' "${NEED[@]}"
    [[ "$STATE" == "OPEN" ]] || warn "PR is $STATE"
    ;;
  *) die "unknown mode: $MODE" ;;
esac
exit "$SHOW_RC"
