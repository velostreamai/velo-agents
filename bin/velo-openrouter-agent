#!/bin/zsh
set -euo pipefail

# The vendored SDK, not the abandoned upstream.
#
# Until now this pointed at ~/.venvs/velo-openrouter-agent, which installs
# codeany-ai/open-agent-sdk-python from git at ab068156 — a repository that was
# pushed twice, on 2026-04-01 and 04-03, and abandoned. There is no upgrade path:
# PyPI's `open-agent-sdk` is a DIFFERENT project (slb350/open-agent-sdk) sharing
# the name and the 0.1.0 version string, so `pip install -U` would silently swap
# a full agent runtime for an unrelated five-file client.
#
# ~/.venvs/velo-agent-sdk installs velostreamai/velo-agent-sdk: the same code,
# vendored with its history and MIT licence intact, plus the #2010 crash fixed at
# SOURCE rather than monkey-patched. The patch fixed it by wrapping
# _convert_response and returned False + CONTINUED if it could not apply, so a
# change underneath it would have silently restored the crash.
#
# ROLLBACK: set this back to
#   $HOME/.venvs/velo-openrouter-agent/bin/python
# and re-run .agents/install.sh. The old venv is left in place untouched, and the
# monkey-patches are still applied by velo_worker_runner, so the old path is
# still fully patched. That rollback stays available ONLY while
# install_tool_input_normalisation remains in velo_sdk_patches.py — deleting it
# is what makes this switch one-way.
SDK_PY="${VELO_AGENT_SDK_PY:-$HOME/.venvs/velo-agent-sdk/bin/python}"

# #2079: resolve the runner NEXT TO THIS SCRIPT, not at an absolute installed
# path. This line used to read
#     SDK_AGENT="$HOME/.agents/bin/velo-openrouter-agent-sdk.py"
# which meant a worktree copy of .agents/bin still exec'd the INSTALLED runner —
# so every `.agents/bin` change tested through this wrapper from a worktree was
# silently testing the wrong file. Verifying the tool-argument logging in #2074,
# the first live run printed `names=Grep` with no arguments and looked exactly
# like a feature that did not work. It worked; the run was old code. That
# failure mode invites debugging the wrong thing.
#
# VELO_AGENTS_BIN overrides it for the deliberate "run the installed one" case.
# $0, not ${BASH_SOURCE[0]} — this script is #!/bin/zsh, where BASH_SOURCE does
# not exist. Under `set -u` the first cut died on it; without `set -u` it would
# have expanded to empty and resolved the runner against the CURRENT DIRECTORY,
# silently exec'ing whatever happened to sit there. That is the same
# silent-wrong-resolution class this fix exists to remove, so the test pins it.
HERE="$(cd "$(dirname "$0")" && pwd)"
BIN="${VELO_AGENTS_BIN:-$HERE}"

# VELO_AGENT_BACKEND picks the runtime. Default is `openai-agents`; set it to
# `open-agent` to go back to the incumbent. One variable, both directions.
#
# Why a second runner rather than one runner behind an abstraction: measured on
# an 18-turn audit, 3 rounds each, same model/gateway/pin/tools — correctness
# 3/3 both, but openai-agents was 1.73x cheaper and 4.2x faster in wall clock.
# That is worth acting on, and is NOT worth refactoring 1,260 working lines at 9
# coupling points to find out. Both runners take the same flags and emit the same
# log lines, so velo-record, the gates and the tests read either one unchanged.
#
# Two runners is the deliberate, temporary cost of that choice. Whichever loses
# gets DELETED, not maintained — a permanent dual path is the thing this repo's
# no-silent-fallback rule exists to prevent.
case "${VELO_AGENT_BACKEND:-openai-agents}" in
    open-agent)
        SDK_AGENT="$BIN/velo-openrouter-agent-sdk.py"
        ;;
    openai-agents)
        SDK_AGENT="$BIN/velo-openai-agents-runner.py"
        # Its OWN venv. The incumbent's interpreter has no `agents` module, so
        # reusing SDK_PY would exec the new runner with a Python that cannot
        # import its SDK — a ModuleNotFoundError mid-dispatch, after the worktree
        # is cut and the issue assigned.
        SDK_PY="${VELO_OAI_PY:-$HOME/.venvs/velo-openai-agents/bin/python}"
        if [ ! -x "$SDK_PY" ]; then
            echo "[velo-openrouter-agent] no interpreter at $SDK_PY" >&2
            echo "[velo-openrouter-agent] create it:" >&2
            echo "    uv venv --python 3.13 ~/.venvs/velo-openai-agents" >&2
            echo "    VIRTUAL_ENV=~/.venvs/velo-openai-agents uv pip install 'openai-agents==0.22.2'" >&2
            echo "[velo-openrouter-agent] or: VELO_AGENT_BACKEND=open-agent to use the incumbent" >&2
            exit 1
        fi
        # Checked, not assumed: an interpreter can exist with the SDK missing,
        # and that failure would otherwise appear as a traceback from the runner
        # rather than as a setup problem the operator can act on.
        if ! "$SDK_PY" -c 'import agents' 2>/dev/null; then
            echo "[velo-openrouter-agent] $SDK_PY cannot import 'agents'" >&2
            echo "[velo-openrouter-agent] VIRTUAL_ENV=~/.venvs/velo-openai-agents uv pip install 'openai-agents==0.22.2'" >&2
            exit 1
        fi
        ;;
    vercel)
        # SPIKE (#2075). Not a route anyone is dispatched to by default — it
        # exists to answer one question the other two cannot: this SDK's
        # `prepareStep` sets `activeTools` PER STEP, so a tool can be made
        # ABSENT from the model's view for a step rather than merely
        # discouraged. Everything we tried that only biases selection failed to
        # replicate (bash 0-8 on identical conditions), so a by-construction
        # guarantee is the only remaining lever worth testing.
        SDK_AGENT="$BIN/velo-vercel-runner.mjs"
        SDK_PY="${VELO_NODE:-$(command -v node)}"
        if [ -z "$SDK_PY" ] || [ ! -x "$SDK_PY" ]; then
            echo "[velo-openrouter-agent] node not found; needed for backend=vercel" >&2
            exit 1
        fi
        # Same reasoning as the openai-agents arm: an interpreter present with
        # its SDK missing would surface as a traceback mid-dispatch, after the
        # worktree is cut and the issue assigned.
        if ! "$SDK_PY" -e 'require(require("path").join(process.env.HOME,".agents/node/node_modules/ai/package.json"))' 2>/dev/null; then
            echo "[velo-openrouter-agent] the 'ai' package is missing from ~/.agents/node" >&2
            echo "[velo-openrouter-agent] mkdir -p ~/.agents/node && cd ~/.agents/node && npm init -y" >&2
            echo "[velo-openrouter-agent] npm i ai @openrouter/ai-sdk-provider zod" >&2
            exit 1
        fi
        ;;
    *)
        echo "[velo-openrouter-agent] unknown VELO_AGENT_BACKEND='$VELO_AGENT_BACKEND'" >&2
        echo "[velo-openrouter-agent] expected: open-agent | openai-agents | vercel" >&2
        exit 1
        ;;
esac

if [ ! -f "$SDK_AGENT" ]; then
    echo "[velo-openrouter-agent] runner not found: $SDK_AGENT" >&2
    echo "[velo-openrouter-agent] set VELO_AGENTS_BIN to the directory holding it" >&2
    exit 1
fi

# The `VELO_AGENT_IMPL=legacy` escape hatch was REMOVED — it could not work.
#
# It exec'd `velo-openrouter-agent.py`, a pre-SDK runner that is untracked and
# whose first act is `from velo_context import ...`. That module lives in
# `~/.claude/lib/`, which is not on the runner's import path, so the branch
# died with `ModuleNotFoundError: No module named 'velo_context'` — verified by
# running it. Both worker skills also instruct "Do not set VELO_AGENT_IMPL".
#
# So it was a fallback that was documented as forbidden AND broken if used:
# someone hitting an SDK problem would set it expecting relief and get a
# confusing import error instead. A fallback that cannot run is worse than no
# fallback. One path, per the project's no-silent-fallback rule.
# Which runner ran is part of the run's evidence (#2076): an operator debugging
# "my change didn't take" must be able to see which file was executed.
echo "[velo-openrouter-agent] backend=${VELO_AGENT_BACKEND:-openai-agents} runner=$SDK_AGENT" >&2
exec "$SDK_PY" "$SDK_AGENT" "$@"
