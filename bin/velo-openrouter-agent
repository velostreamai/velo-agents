#!/bin/zsh
set -euo pipefail

# The vendored SDK, not the abandoned upstream.
#
# Until now this pointed at ~/.venvs/velo-openrouter-agent, which installs
# codeany-ai/open-agent-sdk-python from git at ab068156 — a repository that was
# pushed twice, on 2026-04-01 and 04-03, and abandoned. There is no upgrade path:
# PyPI's `open-agent-sdk` is a DIFFERENT project (slb350/open-agent-sdk) sharing
# the name and the 0.1.0 version string, so `pip install -U` would silently swap
# a full agent runtime for an unrelated five-file client.
#
# ~/.venvs/velo-agent-sdk installs velostreamai/velo-agent-sdk: the same code,
# vendored with its history and MIT licence intact, plus the #2010 crash fixed at
# SOURCE rather than monkey-patched. The patch fixed it by wrapping
# _convert_response and returned False + CONTINUED if it could not apply, so a
# change underneath it would have silently restored the crash.
#
# ROLLBACK: set this back to
#   /Users/neilavery/.venvs/velo-openrouter-agent/bin/python
# and re-run .agents/install.sh. The old venv is left in place untouched, and the
# monkey-patches are still applied by velo_worker_runner, so the old path is
# still fully patched. That rollback stays available ONLY while
# install_tool_input_normalisation remains in velo_sdk_patches.py — deleting it
# is what makes this switch one-way.
SDK_PY="/Users/neilavery/.venvs/velo-agent-sdk/bin/python"

# #2079: resolve the runner NEXT TO THIS SCRIPT, not at an absolute installed
# path. This line used to read
#     SDK_AGENT="/Users/neilavery/.agents/bin/velo-openrouter-agent-sdk.py"
# which meant a worktree copy of .agents/bin still exec'd the INSTALLED runner —
# so every `.agents/bin` change tested through this wrapper from a worktree was
# silently testing the wrong file. Verifying the tool-argument logging in #2074,
# the first live run printed `names=Grep` with no arguments and looked exactly
# like a feature that did not work. It worked; the run was old code. That
# failure mode invites debugging the wrong thing.
#
# VELO_AGENTS_BIN overrides it for the deliberate "run the installed one" case.
# $0, not ${BASH_SOURCE[0]} — this script is #!/bin/zsh, where BASH_SOURCE does
# not exist. Under `set -u` the first cut died on it; without `set -u` it would
# have expanded to empty and resolved the runner against the CURRENT DIRECTORY,
# silently exec'ing whatever happened to sit there. That is the same
# silent-wrong-resolution class this fix exists to remove, so the test pins it.
HERE="$(cd "$(dirname "$0")" && pwd)"
SDK_AGENT="${VELO_AGENTS_BIN:-$HERE}/velo-openrouter-agent-sdk.py"

if [ ! -f "$SDK_AGENT" ]; then
    echo "[velo-openrouter-agent] runner not found: $SDK_AGENT" >&2
    echo "[velo-openrouter-agent] set VELO_AGENTS_BIN to the directory holding it" >&2
    exit 1
fi

# The `VELO_AGENT_IMPL=legacy` escape hatch was REMOVED — it could not work.
#
# It exec'd `velo-openrouter-agent.py`, a pre-SDK runner that is untracked and
# whose first act is `from velo_context import ...`. That module lives in
# `~/.claude/lib/`, which is not on the runner's import path, so the branch
# died with `ModuleNotFoundError: No module named 'velo_context'` — verified by
# running it. Both worker skills also instruct "Do not set VELO_AGENT_IMPL".
#
# So it was a fallback that was documented as forbidden AND broken if used:
# someone hitting an SDK problem would set it expecting relief and get a
# confusing import error instead. A fallback that cannot run is worse than no
# fallback. One path, per the project's no-silent-fallback rule.
# Which runner ran is part of the run's evidence (#2076): an operator debugging
# "my change didn't take" must be able to see which file was executed.
echo "[velo-openrouter-agent] implementation=sdk runner=$SDK_AGENT" >&2
exec "$SDK_PY" "$SDK_AGENT" "$@"
