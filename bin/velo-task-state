#!/usr/bin/env python3
"""velo-task-state: what bash 3.2 cannot do for velo-task and Vanth does not do for it (stdlib only, Python >= 3.9).

  json-get <file|-> <key>                    top-level JSON value as text (string raw, true/false, number); empty when absent
  jobs-ro [--cols a,b] <db> <sql> [param...] read-only SQLite on Vanth's jobs.sqlite: a JSON array, or with --cols one line a row (JSON-quoted if not one word)
  verdict-of [--db P] [--job J] [--name N] [--label L]   the verdict of the status object on stdin, `<label> <verdict>`; 2: not that job, 6: not an object
  launch <program> [name...]                 exec <program> with ONLY the named variables of this environment
  override-write <home> <reason>             the one-shot Stop override (temp + fsync + rename; a stale entry is replaced), logged in overrides.log
  override-take <home>                       consume a VALID override (private regular file of yours, `<time> uid=<n> reason=<text>`): 0, else 3
  session-read <home>                        the token the state dir keeps, only if dir and file are private, ours, no link, token-shaped
  inflight <db> <session> [--others]         the session's in-flight jobs (verdict_of rule; tags_json must be an array of strings), or --others: a count

Exit codes: 0 ok, 1 error, 2 usage, 3 override-take: none, 4 jobs-ro: locked more than 2 s, 5 jobs-ro: schema mismatch, 6 verdict-of: not an object.
"""
import json
import os
import re
import signal
import sqlite3
import stat
import sys
import time
from urllib.parse import quote

# sqlite3 action codes (SQLITE_READ, SQLITE_SELECT, SQLITE_FUNCTION) are fixed by SQLite's C API; the module only exports them from 3.11.
SQLITE_READ, SQLITE_SELECT, SQLITE_FUNCTION = 20, 21, 31
# Columns velo-task reads from Vanth's database; install-vanth and every read check them.
JOB_COLUMNS = ("job_id", "name", "status", "exit_code", "stop_actor", "stop_reason", "created_at", "policy_state_json", "tags_json")
# The one in-flight predicate (every component uses it, the Stop guard included): Vanth's non-terminal statuses.
IN_FLIGHT = frozenset(("queued", "launching", "running", "paused", "retrying", "stopping"))


def die(code, msg):
    sys.stderr.write("velo-task-state: %s\n" % msg)
    sys.exit(code)


def usage(msg):
    die(2, msg + "\n" + __doc__.split("\n\n")[1])


def cmd_json_get(args):
    """Print one top-level value of a JSON object the way `jq -r` would: strings raw, booleans true/false, numbers as written, nested
    values as compact JSON, nothing for a missing or null key. A missing file has no value; anything that is not a JSON object is an error."""
    if len(args) != 2:
        usage("json-get: expected <file|-> <key>")
    src, key = args
    if src == "-":
        raw = sys.stdin.buffer.read().decode("utf-8")
    else:
        try:
            with open(src, encoding="utf-8") as fh:
                raw = fh.read()
        except FileNotFoundError:
            return 0
    doc = json.loads(raw)
    if not isinstance(doc, dict):
        die(1, "json-get: %s does not hold a JSON object" % ("stdin" if src == "-" else src))
    value = doc.get(key)
    if value is None:
        return 0
    sys.stdout.reconfigure(encoding="utf-8")
    if isinstance(value, bool):
        print("true" if value else "false")
    elif isinstance(value, str):
        print(value)
    else:
        print(json.dumps(value, separators=(",", ":")))
    return 0


def read_only_authorizer(action, arg1, arg2, db_name, source):
    """Allow only what a plain SELECT needs: no ATTACH (which can create a file), DDL, DML, PRAGMA, transaction or load_extension."""
    if action == SQLITE_FUNCTION and str(arg2).lower() == "load_extension":
        return sqlite3.SQLITE_DENY
    return sqlite3.SQLITE_OK if action in (SQLITE_READ, SQLITE_SELECT, SQLITE_FUNCTION) else sqlite3.SQLITE_DENY


def query_ro(db, sql, params=()):
    """The rows (as dicts) of one SELECT on a Vanth database, read-only: mode=ro, query_only, and an authorizer that denies all but SELECT."""
    try:
        con = sqlite3.connect("file:%s?mode=ro" % quote(os.path.abspath(db)), uri=True, timeout=2.0)
        con.execute("PRAGMA query_only=ON")
        have = {r[1] for r in con.execute("PRAGMA table_info(jobs)")}
        missing = [c for c in JOB_COLUMNS if c not in have]
        if missing:
            die(5, "jobs-ro: schema mismatch, missing jobs.%s" % ", jobs.".join(missing))
        con.row_factory = sqlite3.Row
        con.set_authorizer(read_only_authorizer)
        return [dict(r) for r in con.execute(sql, params)]
    except sqlite3.OperationalError as exc:
        die(4 if "locked" in str(exc) else 1, "jobs-ro: %s" % exc)
    except sqlite3.DatabaseError as exc:
        die(1, "jobs-ro: %s" % exc)


def tok(text):
    """A field of a line: as it is when it is one printable word with no double quote, else JSON-quoted, so a name any tool may set cannot add a line."""
    text = str(text)
    return text if re.fullmatch(r"[\x21\x23-\x7e]+", text) else json.dumps(text)


def cmd_jobs_ro(args):
    cols = None
    if args[:1] == ["--cols"] and len(args) > 1:
        cols, args = args[1].split(","), args[2:]
    if len(args) < 2:
        usage("jobs-ro: expected [--cols a,b] <db> <sql> [param...]")
    rows = query_ro(args[0], args[1], tuple(args[2:]))
    if cols is None:
        sys.stdout.write(json.dumps(rows, separators=(",", ":"), default=str) + "\n")
    else:
        for row in rows:
            print(" ".join(tok(row.get(c, "")) for c in cols))
    return 0


def json_field(row, name):
    """A JSON column of a jobs.sqlite row is text, the same field of a status object is already a value; None when absent or empty."""
    value = row.get(name)
    return (json.loads(value) if value.strip() else None) if isinstance(value, str) else value


def restart_pending(row):
    """Whether a restart policy has a relaunch pending (restart_after, or pending_restart_after while it is being claimed)."""
    state = json_field(row, "policy_state_json")
    if state is not None and not isinstance(state, dict):
        raise ValueError("policy_state_json is not an object")
    return bool(state and (state.get("restart_after") or state.get("pending_restart_after")))


def verdict_of(row):
    """The one place a verdict is computed: a `vanth --json status` object or a jobs.sqlite row in; ok, failed(n), timeout, killed, lost or
    in-flight out. Total: whatever it cannot classify is `lost`, never `ok`."""
    if not isinstance(row, dict) or not isinstance(row.get("status"), str):
        return "lost"
    status = row["status"]
    if status in IN_FLIGHT:
        return "in-flight"
    try:
        if status in ("failed", "orphaned") and restart_pending(row):
            return "in-flight"  # a policy relaunch is coming: the status is not final
    except (ValueError, RecursionError):  # a policy column that is not JSON, or nested deeper than json can read
        return "lost"
    if status == "completed":
        return "ok"
    if status == "timeout":
        return "timeout"
    if status == "failed":
        code = row.get("exit_code")
        return "failed(%d)" % code if isinstance(code, int) and not isinstance(code, bool) else "lost"
    if status == "cancelled" and row.get("stop_actor") == "user":
        return "killed"
    return "lost"  # orphaned, any other cancelled, a status outside both sets


def cmd_verdict_of(args):
    opts, i = {}, 0
    while i < len(args):
        if args[i] in ("--db", "--job", "--name", "--label") and i + 1 < len(args):
            opts[args[i][2:]], i = args[i + 1], i + 2
        else:
            usage("verdict-of: unexpected argument %r" % args[i])
    try:
        row = json.loads(sys.stdin.buffer.read().decode("utf-8"))
    except (ValueError, RecursionError) as exc:  # not JSON, not UTF-8, or nested deeper than this interpreter can read
        die(6, "verdict-of: the status is not JSON: %s" % exc)
    if not isinstance(row, dict):
        die(6, "verdict-of: the status is not a JSON object (%s)" % type(row).__name__)
    for key, field in (("job", "job_id"), ("name", "name")):  # a status for another job or name is never reported as the job asked about
        if key in opts and row.get(field) != opts[key]:
            die(2, "verdict-of: the status is for %s %r, not %r; refusing to report it for the job asked about" % (field, row.get(field), opts[key]))
    job = opts.get("job")
    if opts.get("db") and job and "policy_state_json" not in row and row.get("status") in ("failed", "orphaned"):
        found = query_ro(opts["db"], "SELECT policy_state_json FROM jobs WHERE job_id = ?", (job,))  # `vanth status` omits it: a restart may be pending
        row["policy_state_json"] = found[0]["policy_state_json"] if found else None
    verdict = verdict_of(row)
    label = opts.get("label") or job or "-"
    print("%s %s" % (label, verdict))
    return 0


def cmd_launch(args):
    """The process that becomes vanthd gets exactly the named variables of this environment and nothing else: the allowlisted secrets
    reach it by name, so no value is ever in an argv, which ps shows to everyone."""
    if not args:
        usage("launch: expected <program> [name...]")
    program, names = args[0], args[1:]
    missing = [n for n in names if n not in os.environ]
    if missing:
        die(1, "launch: not set in the environment: %s" % " ".join(missing))
    for sig in (signal.SIGPIPE, signal.SIGXFSZ):  # Python ignores these; vanthd gets the dispositions a plain exec would have given it
        signal.signal(sig, signal.SIG_DFL)
    os.execve(program, [program], {n: os.environ[n] for n in names})


OVERRIDE_LINE = re.compile(r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ uid=(\d+) reason=\S.*\n\Z")


def read_private(path, limit):
    """The text of a regular file of ours that group and other cannot touch, opened without following a link, at most `limit` bytes; else None."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)  # absent, or a symlink: not ours
    except OSError:
        return None
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid() or info.st_mode & 0o077 or info.st_size > limit:
            return None
        return os.read(fd, limit + 1).decode("utf-8", "replace")
    finally:
        os.close(fd)


def valid_override(path):
    """A pending override holds one `<time> uid=<n> reason=<text>` line of ours."""
    match = OVERRIDE_LINE.match(read_private(path, 4096) or "")
    return bool(match) and int(match.group(1)) == os.getuid()


def append_log(home, text):
    log = os.open(os.path.join(home, "overrides.log"), os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    with os.fdopen(log, "a") as fh:
        fh.write(text)


def cmd_override_write(args):
    """Publish <home>/stop-override atomically (private temp, fsync, rename). A stale entry that is not a valid override (a symlink, an
    empty or partial file) is replaced; a valid one already pending is an error."""
    if len(args) != 2 or not args[1].strip() or "\n" in args[1] or "\0" in args[1]:
        usage("override-write: expected <home> <one-line reason>")
    home, reason = args
    path = os.path.join(home, "stop-override")
    if valid_override(path):
        die(1, "override-write: a stop-override is already pending")
    line = "%s uid=%d reason=%s\n" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), os.getuid(), reason)
    tmp = "%s.%d" % (path, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "w") as fh:
            fh.write(line)
            fh.flush()
            os.fsync(fh.fileno())
        try:
            os.rename(tmp, path)  # replaces a stale file or symlink itself, never what it points at
        except IsADirectoryError:
            os.rmdir(path)  # an empty stale directory; a full one fails loudly
            os.rename(tmp, path)
    except BaseException:
        if os.path.lexists(tmp):
            os.unlink(tmp)
        raise
    append_log(home, "set " + line)
    return 0


def cmd_override_take(args):
    """Consume a VALID override (exit 0); anything else is left alone and is exit 3."""
    if len(args) != 1:
        usage("override-take: expected <home>")
    path = os.path.join(args[0], "stop-override")
    if not valid_override(path):
        return 3
    os.unlink(path)
    append_log(args[0], "used %s uid=%d\n" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), os.getuid()))
    return 0


def job_tags(row):
    """The tags of a jobs.sqlite row: tags_json must parse to an array of strings, else this fails (the Stop guard then blocks)."""
    try:
        tags = json.loads(row.get("tags_json") or "")
    except (ValueError, RecursionError, TypeError) as exc:
        raise ValueError("job %s: tags_json is not JSON (%s)" % (row.get("job_id"), exc))
    if not isinstance(tags, list) or not all(isinstance(t, str) for t in tags):
        raise ValueError("job %s: tags_json is not an array of strings" % row.get("job_id"))
    return tags


def cmd_session_read(args):
    """session-read <home>: the session token this state dir keeps, only if the dir and the file are private and ours, the file is no link,
    and its content is exactly 16 lowercase hex digits (what velo-task generates)."""
    if len(args) != 1:
        usage("session-read: expected <home>")
    home = os.stat(args[0])
    if not stat.S_ISDIR(home.st_mode) or home.st_uid != os.getuid() or home.st_mode & 0o077:
        die(1, "session-read: %s is not a private directory of yours" % args[0])
    token = read_private(os.path.join(args[0], "session"), 64)
    if token is None or not re.fullmatch(r"[0-9a-f]{16}", token):
        die(1, "session-read: the session file is not a private, generated token of yours")
    print(token)
    return 0


def cmd_inflight(args):
    """inflight <db> <session> [--others]: this session's jobs whose verdict is in-flight, as `name job_id status` lines (--others: how many
    in-flight jobs do NOT carry the session's tag). The same verdict_of that status uses, so a failed job with a restart pending counts."""
    if len(args) not in (2, 3) or (len(args) == 3 and args[2] != "--others"):
        usage("inflight: expected <db> <session> [--others]")
    mine, others = [], 0
    for row in query_ro(args[0], "SELECT * FROM jobs ORDER BY created_at, job_id"):
        if verdict_of(row) != "in-flight":
            continue
        if "session:" + args[1] in job_tags(row):
            mine.append(row)
        else:
            others += 1
    print(others) if len(args) == 3 else [print(tok(r["name"]), tok(r["job_id"]), r["status"]) for r in mine]
    return 0


COMMANDS = {"json-get": cmd_json_get, "jobs-ro": cmd_jobs_ro, "verdict-of": cmd_verdict_of, "launch": cmd_launch,
            "override-write": cmd_override_write, "override-take": cmd_override_take, "inflight": cmd_inflight, "session-read": cmd_session_read}


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        sys.stdout.write(__doc__)
        return 0
    if argv[0] not in COMMANDS:
        usage("unknown subcommand %r" % argv[0])
    try:
        return COMMANDS[argv[0]](argv[1:])
    except Exception as exc:  # surfaced, never swallowed; the message never carries stdin
        die(1, "%s: %s: %s" % (argv[0], type(exc).__name__, exc))


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
