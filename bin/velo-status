#!/bin/bash
# velo-status — one-shot status of every dispatched Velostream worker.
#
# Usage:
#   velo-status            summary table
#   velo-status -v         also show each worker's last log line
#   velo-status <issue>    detail for one issue
#
# Reports from GIT AND THE PROCESS TABLE, never from a worker's self-report —
# a worker that commits looks "unchanged" to its own runner, and one that
# leaks a tool call reports success while having executed nothing.

set -uo pipefail
VELO_STATE="${VELO_STATE:-$HOME/.agents/state}"

REPO="velostreamai/velostream"
ROOT="$HOME/RustroverProjects/velostream"
WORKTREE_BASE="$HOME/RustroverProjects"
# Native (Agent-tool) workers are recorded by velo-native, which sits beside this script.
NATIVE_BIN="$(dirname "${BASH_SOURCE[0]}")/velo-native"
# A native worker with no agent.log entry for this long is stalled?. Its heartbeat is
# slower than a dispatched run's (the 10m wedge rule), since it is in-process.
NATIVE_STALL_MINUTES=30

# Worktree derivations are shared with velo-record. If the live view and the
# recorded history ever disagreed about what a worktree contained, neither would
# be trustworthy — so there is one definition, not a copy in each reader.
LIB="$(dirname "${BASH_SOURCE[0]}")/velo-worktree-lib.sh"
[[ -f "$LIB" ]] || LIB="$ROOT/.agents/bin/velo-worktree-lib.sh"
# shellcheck source=/dev/null
source "$LIB"
# The local route is recognised by its endpoint, which velo-local.conf defines.
# shellcheck source=velo-local.conf
source "$(dirname "$LIB")/velo-local.conf" || { echo "velo-local.conf missing next to $LIB" >&2; exit 1; }

VERBOSE=0; ONLY=""; ONLY_CANON=""
for a in "$@"; do
  case "$a" in
    -v|--verbose) VERBOSE=1 ;;
    [0-9]*) ONLY="$a"; ONLY_CANON=$(canon_issue "$a") ;;
    *) echo "usage: velo-status [-v] [issue]" >&2; exit 1 ;;
  esac
done

RED=$'\033[31m'; GRN=$'\033[32m'; YEL=$'\033[33m'; DIM=$'\033[2m'; OFF=$'\033[0m'

# Map a running worker process -> the issue number in its --cwd.
#
# EVERY worker transport must appear in the pattern below. It listed only the
# Python runners, so `worker:codex` never matched and PID came back empty —
# which the STATE logic further down read as "not running" and reported as
# `done` with 0 commits one minute into a live 800s run (#2101). codex is not a
# velo-*-agent-sdk.py and spells the flag `--cd`, not `--cwd`: two independent
# misses, either one enough to lose the run. The LOG glob below already carries
# a comment about exactly this omission — that fix was applied there, not here.
#
# Wrappers must be shed so the pid returned is the one a human can `kill`:
# killing a wrapper orphans the runner AND guarantees no record is ever written.
# Each transport nests differently — the Python runners sit under the #1992
# `bash -c` supervisor, codex adds a `timeout <n> codex exec` frame carrying the
# same argv — and every wrapper is forked before the runner, so it holds the
# lower pid and would win `head -1`.
#
# Reads a `ps` snapshot rather than `pgrep -af`, because on macOS `pgrep -a` is
# a no-op: it prints bare pids with no command text, so the exclusions filtered
# nothing and #1992's supervisor shedding has in fact never worked on this
# platform. `-ww` defeats ps's terminal-width truncation, which would otherwise
# cut the argv before `--cd` on a narrow terminal and lose the match.
#
# The snapshot lands in a variable rather than piping straight into grep: in a
# pipeline both processes start together, so grep's own argv — which contains
# this very pattern, worktree path and all — can appear in the snapshot and
# match itself.
#
# The worktree path is ERE-ESCAPED before interpolation (#2102 review). It was
# spliced in raw, and a path is DATA, not pattern: under a home directory like
# `/Users/a+b/...` the `+` made the preceding character optional-repeat, so the
# helper did not match its own literal runner path but DID match `/Users/ab/...`.
# Either way the result is a confident wrong answer — an empty PID reads as
# "not running" and reports a live worker as done, which is the whole bug this
# helper was fixed for. `$HOME` is outside our control, so escaping is the fix
# rather than assuming worktree names stay tame.
ere_escape() { printf '%s' "$1" | sed 's/[][\\.*^$+?(){}|\/]/\\&/g'; }

worker_from_cmd() {   # $1 = the process argv
  # A FUNCTION so the test can execute this code instead of a copy of it. It was
  # inline, the test re-implemented it, and the only thing catching a divergence
  # was a grep for one literal arm — which proves the string exists, not that the
  # logic matches. That is the same defect a reviewer found in this repo twice.
  #
  # One arm per ROUTE, not per model: routes are unversioned and the model is
  # pinned in velo-dispatch. A per-model arm would need editing on every re-pin,
  # and the model a run used is already recorded per row in result.jsonl.
  # The local endpoint is tested OUTSIDE the case: an unset or empty value would
  # make the pattern `*""*`, which matches every argv and would name a codex run
  # velo-local. Guarded here rather than trusted to the caller's environment.
  # Every local server is the local route: LM Studio, llama-server and Sushi.
  # Any of them may be the one a run was dispatched to.
  local u
  for u in "${VELO_LMSTUDIO_BASE_URL:-}" "${VELO_LLAMA_SERVER_URL:-}" "${VELO_SUSHI_SERVER_URL:-}"; do
    if [[ -n "$u" && "$1" == *"$u"* ]]; then echo "velo-local"; return; fi
  done
  case "$1" in
    *":free"*)                echo "velo-free" ;;
    *deepseek/deepseek*)      echo "velo-deepseek" ;;
    # #2423: the haiku route is Anthropic, so it matches on the anthropic/ id
    # rather than a z-ai/ one. Same one-arm-per-ROUTE rule as the rest.
    *anthropic/claude-haiku*)  echo "velo-haiku" ;;
    *z-ai/glm*)               echo "velo-glm" ;;
    # The LM Studio endpoint IS the local route — a model-name arm broke
    # the moment the model changed (a live Flash-Next run showed `running?`).
    *lmstudio-agent-sdk*|*":1234/v1"*) echo "velo-local" ;;
    *"codex exec"*)           echo "velo-codex" ;;
    *)                        echo "running?" ;;
  esac
}

running_pid_for() {
  local wt snap
  wt=$(ere_escape "$1")
  snap=$(ps -axww -o pid=,command= 2>/dev/null)
  printf '%s\n' "$snap" \
    | grep -E "velo-(openrouter-agent-sdk|lmstudio-agent-sdk|openai-agents-runner)\.py.*--cwd $wt( |$)|codex exec .*--cd $wt( |$)" \
    | grep -vE '^[[:space:]]*[0-9]+[[:space:]]+(bash -c|timeout )' \
    | awk '{print $1}' | head -1
}

# Did THIS run exit? The supervisor writes one record row per exit — including
# crash and timeout — carrying the runner log it ran against, so the row naming
# this log is positive proof the run is over. Matched on the log, not just the
# issue, so a re-dispatch cannot inherit the previous run's record and report a
# fresh run as finished. Empty output = no exit recorded for this log.
#
# Compares the DECODED `log` field, not a substring of the raw line (#2102
# review, both rounds). Two separate defects sit on the naive approaches:
#
#   basename substring — unanchored, so a log name that is a prefix of another
#   cross-matches, and a false match here reports a LIVE run as finished.
#
#   raw `"log":"<path>"` grep — `velo-record` serialises with `json.dumps`,
#   whose default `ensure_ascii` renders any non-ASCII path as `\uXXXX`, and
#   which escapes `\` and `"`. So the string on disk is not the string we hold.
#   An accented character anywhere in $HOME — hardly exotic — makes the grep
#   never match, and a FINISHED run then reports as live forever.
#
# Parsing is the only approach that does not depend on a guess about escaping.
# It costs one interpreter start per worktree on a branch of the state logic
# that is already the uncommon case; a status tool that lies is worth more than
# 50ms.
#
# This is only sound because the log name is collision-free per run: two
# dispatches of one issue starting in the same second used to produce the SAME
# second-resolution filename, so the first run's exit record would suppress
# `live?` on the still-running second one. `velo-dispatch` now appends its pid
# — fixed there rather than papered over here, since no amount of matching can
# separate two runs that share an identity.
exit_record_for() {
  # Separate `local` statements: bash declares every name in a single `local`
  # before assigning any, so a later RHS referencing an earlier name on the same
  # line reads the shadowing-but-unset local and trips `set -u`.
  local issue="$1" log="$2"
  local res="$ROOT/.agents/tasks/${issue}.result.jsonl"
  local out rc
  [[ -f "$res" ]] || return 0
  # Return code is LOAD-BEARING and distinct from the output (#2102 review):
  #
  #   0 + output  a record exists — the run has exited
  #   0 + empty   no record — determined, not guessed
  #   2           COULD NOT DETERMINE
  #
  # The third case used to be indistinguishable from the second. `2>/dev/null`
  # plus an empty stdout meant an absent python3 (rc 127) or an unreadable
  # record file read as "no record", which the caller renders as `live?` — a
  # finished run shown as running, on evidence that never existed. That is the
  # error-swallowing this repo's policy forbids, and it defeats the purpose of a
  # tool whose whole job is not lying about liveness.
  #
  # stderr is deliberately NOT redirected: the interpreter's own message is the
  # diagnostic, and it belongs in front of whoever is reading the table.
  #
  # A malformed ROW is different, and is still skipped rather than fatal: the
  # record file is append-only and a crashed writer can leave a partial last
  # line. Skipping errs toward `live?` over a false `done`, which is the safe
  # direction for a row we can genuinely not parse.
  out=$(python3 -c '
import json, sys
path, want = sys.argv[1], sys.argv[2]
with open(path, encoding="utf-8") as fh:
    for line in fh:
        line = line.strip()
        if not line:
            continue
        try:
            row = json.loads(line)
        except ValueError:
            continue
        if (row.get("runner") or {}).get("log") == want:
            print(line)
            break
' "$res" "$log"); rc=$?
  if (( rc != 0 )); then
    printf '%s\n' "velo-status: cannot read $res (python3 exit $rc) — liveness for issue $issue is UNKNOWN, not live" >&2
    return 2
  fi
  printf '%s' "$out"
}

# Issue titles, fetched ONCE and in PARALLEL before the table is drawn.
#
# A bare number does not say what a worktree is for — reading the table meant
# going and looking each one up. Sequential `gh issue view` calls would add a
# second or so per worktree to a command whose whole point is being a one-shot
# glance, so they are forked together and collected.
TITLE_DIR=$(mktemp -d)
trap 'rm -rf "$TITLE_DIR"' EXIT
for WT in "$WORKTREE_BASE"/velostream-*; do
  [[ -d "$WT/.git" || -f "$WT/.git" ]] || continue
  N="${WT##*velostream-}"
  [[ "$N" =~ ^[0-9]+$ ]] || continue          # docsql / prgate etc. have no issue
  [[ -n "$ONLY" && "$N" != "$ONLY" ]] && continue
  ( gh issue view "$N" --repo "$REPO" --json title --jq .title 2>/dev/null \
      > "$TITLE_DIR/$N" ) &
done
wait

title_for() {  # $1 = issue number -> title, stripped of the [#PARENT] prefix
  local f="$TITLE_DIR/$1"
  [[ -s "$f" ]] || { printf -- '-'; return; }
  sed -E 's/^\[#[0-9]+\] *//' "$f" | head -1
}

# Native (Agent-tool) worker records, one TSV line each, read once. A read that fails
# is said on the table: a worker that cannot be read must not look like a free slot.
NATIVE_ROWS=$("$NATIVE_BIN" rows); NATIVE_RC=$?
DISPATCH_RUNNING=0; NATIVE_RUNNING=0
PRINTED_DISPATCH=""

# UTC start of a runner log, from its name <tag>-<UTC>[-<pid>].log -> YYYYMMDDTHHMMSSZ.
# Empty when the name carries no stamp.
dispatch_stamp() {  # <runner log>
  local s
  s=$(basename "$1" .log | sed -nE 's/.*-([0-9]{8}T[0-9]{6}Z)(-[0-9]+)?$/\1/p')
  [[ "$s" =~ ^[0-9]{8}T[0-9]{6}Z$ ]] || return 0
  printf '%s' "$s"
}

# Does a native record take ISSUE's row from the dispatch row? Only when the dispatch
# is NOT live (a record must never hide a running worker) and the record is NOT OLDER
# than the dispatch. Both stamps are whole seconds, so a record in the SAME second as the
# dispatch cannot be ordered against it, and it takes the row: hiding a native worker
# undercounts the slots. A dispatch with no log at all is no record of anything, so the
# native record stands alone. A dispatch whose start cannot be read is kept, never
# overridden on a guess.
native_takes_row() {  # <issue> <dispatch state> <dispatch log>
  local line nstart dstamp
  line=$(awk -F'\t' -v n="$1" '$1 == n { print; exit }' <<<"$NATIVE_ROWS")
  [[ -n "$line" ]] || return 1
  case "$2" in running|'live?'|'?') return 1 ;; esac
  [[ -n "$3" ]] || return 0
  dstamp=$(dispatch_stamp "$3")
  [[ -n "$dstamp" ]] || return 1
  nstart=$(awk -F'\t' '{ print $3 }' <<<"$line")
  [[ "${nstart//[-:]/}" == "$dstamp" ]] && return 0
  [[ "${nstart//[-:]/}" > "$dstamp" ]]
}

# The agent.log summary for one worktree -> LOGSUM, LOGC. Shared by dispatch and native
# rows. wedge_check=1 colours a RUNNING dispatch yellow after 10m with no entry (the
# dispatch wedge rule); native rows pass 0, since their own threshold is the STATE.
agentlog_cells() {  # <worktree> <state word> <wedge_check 0|1>
  local wt="$1" sw="$2" wc="$3" alog="$1/agent.log" linesn agemin age flags
  LOGSUM="-"; LOGC="$DIM"
  [[ -f "$alog" ]] || return 0
  linesn=$(wc -l < "$alog" | tr -d ' ')
  # Age comes from the last real UTC stamp IN the file, not the file mtime — an agent
  # can touch its log without progressing. Derived by the shared lib, which also
  # defines the stall predicate velo-watch will act on.
  agemin=$(wt_agentlog_age_min "$wt")
  age="?"; [[ -n "$agemin" ]] && age="${agemin}m"
  flags=""
  wt_stop_fired "$wt" && flags="${flags}S"
  grep -q 'FINDING' "$alog" && flags="${flags}F"
  grep -q 'CORRECTION' "$alog" && flags="${flags}C"
  grep -qE 'SECURITY|DATA-LOSS' "$alog" && flags="${flags}!"
  LOGSUM="${linesn}l ${age}${flags:+ $flags}"
  # A log that has not moved while the worker is ALIVE means the worker is wedged, or
  # is not writing the ~10-minute heartbeats the policy requires. Colour it either way.
  if [[ "$wc" == 1 && "$sw" == "running" && "$age" =~ ^([0-9]+)m$ && ${BASH_REMATCH[1]} -ge 10 ]]; then
    LOGC="$YEL"
  elif [[ "$flags" == *"!"* ]]; then
    LOGC="$RED"
  fi
}

# One table row. Each caller passes its facts, so a dispatch row and a native row cannot
# drift apart in layout. Unpushed commits are coloured: that is the state that silently
# loses work when a worktree is reset.
draw_row() {  # <issue> <worker> <state word> <state colour> <commits> <pushed> <dirty> <log colour> <log summary> <branch> <title>
  local issue="$1" worker="$2" sw="$3" sc="$4" commits="$5" pushed="$6" dirty="$7"
  local logc="$8" logsum="$9" branch="${10}" title="${11}" cflag_w cflag_c
  cflag_w="$commits"; cflag_c=""
  [[ "$commits" != "0" && "$pushed" != "0" ]] && { cflag_w="${commits}!"; cflag_c="$YEL"; }
  printf '%-7s %-13s %s%-8s%s %s%-7s%s %-6s %s%-16s%s %-26s %s%s%s\n' \
    "$issue" "${worker:0:13}" "$sc" "$sw" "$OFF" "$cflag_c" "$cflag_w" "$OFF" "$dirty" \
    "$logc" "$logsum" "$OFF" "${branch:0:26}" "$DIM" "${title:0:60}" "$OFF"
}

printf '%-7s %-13s %-8s %-7s %-6s %-16s %-26s %s\n' ISSUE WORKER STATE COMMITS DIRTY AGENT-LOG BRANCH TITLE
printf '%s\n' "──────────────────────────────────────────────────────────────────────────────────────────────────────"

FOUND=0
for WT in "$WORKTREE_BASE"/velostream-*; do
  [[ -d "$WT/.git" || -f "$WT/.git" ]] || continue
  ISSUE="${WT##*velostream-}"
  [[ -n "$ONLY" && "$ISSUE" != "$ONLY" ]] && continue
  FOUND=1

  BRANCH=$(wt_branch "$WT")
  COMMITS=$(wt_commits "$WT")
  DIRTY=$(wt_dirty "$WT")

  PID=$(running_pid_for "$WT")
  # One directory per issue, so this no longer enumerates worker tags. The old
  # glob hardcoded {deepseek,glm,velo-local} and would silently miss any worker
  # added later — it returned nothing for worker:codex runs.
  #
  # The directory holds TWO kinds of file and only one of them is a runner log
  # (#2112). `velo-dispatch` writes its own `dispatch-<UTC>.log` bookkeeping —
  # after the runner starts, and again at exit — plus `zg-index.log`. Taking the
  # newest `*.log` therefore picked a dispatch log most of the time, and every
  # signal below is derived from whatever this returns:
  #
  #   exit_record_for could never match  — the record names the RUNNER log, so
  #     the #2101 backstop was dead and the state fell out of a dispatch log's
  #     mtime
  #   the LEAKED / failed greps ran over a file that cannot contain their
  #     markers, so a genuinely leaked or crashed run read as clean
  #   the age column measured dispatch's last write, not the worker's
  #
  # It showed as worker `dispatch` in the table — a name no worker has. The
  # three things this tool exists to report were all being read off the wrong
  # file, and it looked fine.
  #
  # Excluding by name rather than selecting by a worker whitelist keeps the
  # #2101 property above: a worker tag nobody has added yet still matches.
  #
  # The exclusion is the dispatcher's EXACT filename shape, not the `dispatch-`
  # prefix (#2113 review). `dispatch-[^/]*` would also swallow a runner log from
  # any future LOGTAG beginning with those letters, leaving the worktree `idle`
  # despite a live worker — which is the forward-compatibility this whole
  # selection was written to preserve, defeated by the fix for it.
  #
  # The shapes differ reliably: bookkeeping is `dispatch-<UTC>.log`, a runner log
  # is `<tag>-<UTC>-<pid>.log` since #2101, so the trailing `-<pid>` keeps even a
  # literal `dispatch` LOGTAG distinguishable.
  LOG=$(ls -t "$VELO_STATE/dispatch/$ISSUE"/*.log 2>/dev/null \
        | grep -vE '/(dispatch-[0-9]{8}T[0-9]{6}Z|zg-index)\.log$' | head -1)
  WORKER="-"
  if [[ -n "$PID" ]]; then
    # A worker IS running: name it from the live process, not from a log glob.
    # Logs are matched by mtime, so a stale log from an EARLIER worker on the
    # same issue would otherwise mislabel the one actually running.
    CMD=$(ps -o command= -p "$PID" 2>/dev/null)
    WORKER=$(worker_from_cmd "$CMD")
  elif [[ -n "$LOG" ]]; then
    # Not running: the most recent log is the best available evidence of who
    # ran last.
    #
    # Logs are $VELO_STATE/dispatch/<issue>/<worker>-<UTC>.log — the issue is the
    # DIRECTORY, not part of the filename. The previous rule stripped from
    # "-<issue>" onward, which was right when logs were /tmp/deepseek-1898.log
    # and became a NO-OP the moment they moved: nothing matched, so the entire
    # filename became the worker name and velo-status printed "codex-20260" for
    # a codex run.
    #
    # Now strips the SHAPE of the suffix rather than counting hyphens. `${BN%-*}`
    # took everything before the last hyphen, which was correct for exactly one
    # log-name format — and this same commit adds a `-$$` disambiguator, so the
    # count changed and `glm-20260101T000000Z-1234` would have rendered as the
    # worker `glm-20260101T000000Z`. That is the identical regression the
    # paragraph above describes, reintroduced by a change two files away, which
    # is precisely why positional parsing does not belong here.
    #
    # An anchored pattern also FAILS VISIBLY: a name that does not end in
    # `-<UTC>-<pid>` is left whole rather than silently truncated at the wrong
    # place, so the table shows something obviously odd instead of something
    # plausibly wrong. Multi-hyphen worker names like velo-local survive.
    BN=$(basename "$LOG" .log)
    WORKER=$(sed -E 's/-[0-9]{8}T[0-9]{6}Z(-[0-9]+)?$//' <<<"$BN")
  fi

  if [[ -n "$PID" ]]; then
    STATE_W=running; STATE_C="$GRN"
  elif [[ -n "$LOG" ]]; then
    # Distinguish a clean finish from a crash/timeout, and flag leaked tool calls.
    TAIL=$(tail -5 "$LOG" 2>/dev/null)
    if grep -q "leaked_tool_calls=[1-9]" <<<"$TAIL"; then
      STATE_W=LEAKED; STATE_C="$RED"
    elif grep -qE "^ERROR:|exceeded [0-9]+s|Traceback" <<<"$TAIL"; then
      STATE_W=failed; STATE_C="$RED"
    elif REC=$(exit_record_for "$ISSUE" "$LOG"); (( $? == 2 )); then
      # The record check itself failed — python3 missing, file unreadable. We do
      # not know whether this run is alive, and `live?`/`done` both assert
      # something we cannot support. A separate state keeps the tool honest;
      # exit_record_for has already printed the reason to stderr.
      STATE_W='?'; STATE_C="$RED"
    elif [[ -z "$REC" && -n "$(find "$LOG" -mmin -10 2>/dev/null)" ]]; then
      # Backstop for the NEXT transport nobody adds above (#2101).
      #
      # `done` here is an inference from the absence of a crash marker, and a
      # live mid-write log has no crash marker either — so an unrecognised
      # worker reads as cleanly finished. Two facts separate the cases: the
      # supervisor writes an exit record on EVERY exit including crash and
      # timeout, and a finished run's log stops growing. No record AND a log
      # touched in the last 10 minutes means something is still writing it.
      #
      # Deliberately NOT "no record => not done": most historical logs predate
      # the record (#1992) or belong to runs killed outside the supervisor, and
      # measured over the current dispatch dirs that rule would repaint 8 of 12
      # rows. The recency clause confines this to the one ambiguous case.
      STATE_W='live?'; STATE_C="$YEL"
    else
      STATE_W=done; STATE_C="$DIM"
    fi
  else
    STATE_W=idle; STATE_C="$DIM"
  fi
  # A native record can take this issue's row (native_takes_row). Then the native pass
  # below draws it in this row's place, and this dispatch row is not printed.
  if native_takes_row "$ISSUE" "$STATE_W" "$LOG"; then
    continue
  fi
  PRINTED_DISPATCH="$PRINTED_DISPATCH $ISSUE"
  [[ "$STATE_W" == running ]] && DISPATCH_RUNNING=$((DISPATCH_RUNNING + 1))

  # Colour the commit count: work present but unpushed is the state that
  # silently loses everything if the worktree is reset.
  PUSHED=$(wt_unpushed "$WT" "$BRANCH")
  # ── agent.log summary ───────────────────────────────────────────────────
  # The STATE column reads PROCESSES, so it says "idle" for an agent that is
  # alive but wedged, and says nothing about what the agent found. The log has
  # both. A wedged run went unnoticed here for ~11 minutes because this column
  # did not exist.
  #
  # Reported: line count, age of the LAST entry, and flags for entries that
  # mean a human should look — S=STOP, F=FINDING, C=CORRECTION, !=SECURITY or
  # DATA-LOSS. Age is the wedge detector: a live process whose log has not
  # moved in a long time is stuck, not working.
  # NOTE: $LOG is the RUNNER's stdout under /tmp — useful for leak detection,
  # but it is not the reasoning trail. The trail is agent.log in the WORKTREE,
  # written by the worker itself under the logging policy. Read that.
  agentlog_cells "$WT" "$STATE_W" 1

  TITLE=$(title_for "$ISSUE")
  draw_row "$ISSUE" "$WORKER" "$STATE_W" "$STATE_C" "$COMMITS" "$PUSHED" "$DIRTY" \
    "$LOGC" "$LOGSUM" "$BRANCH" "$TITLE"

  if [[ $VERBOSE -eq 1 && -n "$LOG" ]]; then
    printf '        %s%s%s\n' "$DIM" "$(tail -1 "$LOG" | cut -c1-100)" "$OFF"
  fi

  # Recorded outcomes (#1992). The STATE column reads the PROCESS table, so it
  # can only describe the run happening NOW. The record is what finished runs
  # left behind — and it is the only place cost and rework appear at all.
  RES="$ROOT/.agents/tasks/${ISSUE}.result.jsonl"
  if [[ -f "$RES" && ( $VERBOSE -eq 1 || -n "$ONLY" ) ]]; then
    python3 - "$RES" <<'PYR'
import json, sys
# JSONL: a malformed line loses that ROW, never the file. The array format this
# replaced meant one bad byte made the whole history unreadable — and the writer
# then renamed it aside, so no consumer ever saw it again.
rows, bad = [], 0
for line in open(sys.argv[1], encoding="utf-8"):
    line = line.strip()
    if not line:
        continue
    try:
        rows.append(json.loads(line))
    except Exception:
        bad += 1
if bad:
    print(f"        ({bad} unreadable record line(s) skipped)")
# Show every run, not just the last: a re-dispatch is the interesting row, and
# "3 attempts, 2 abandoned" is the fact a single latest-row view hides.
for n, r in enumerate(rows, 1):
    c, w, k = r.get("cost") or {}, r.get("work") or {}, r.get("runner") or {}
    # `usd` is null unless the rate was real. An unpriced model still has honest
    # token counts, so show those and mark the money as not-a-price rather than
    # printing an invented figure next to a real one.
    usd = c.get("usd")
    src = c.get("source") or ""
    if usd is not None:
        cost = f"${usd:.4f}"
    elif "unpriced" in src:
        cost = "unpriced"
    elif src.startswith("sdk"):
        # Distinct from "cost n/a": there IS usage on record and an estimate
        # beside it, the tally is just incomplete. Collapsing the two hid the
        # difference between "we know nothing" and "we know a floor".
        cost = "est-only"
    else:
        cost = "cost n/a"
    if c.get("tokens_are_partial"):
        cost += "~"          # tokens are a floor: the prompt died mid-flight
    secs = r.get("wall_clock_s")
    print(f"        run {n}/{len(rows)}  {r.get('outcome','?'):<9} "
          f"{r.get('worker','?'):<14} {(str(secs)+'s') if secs is not None else '?':>7}  "
          f"{cost:>10}  {c.get('input_tokens',0)}in/{c.get('output_tokens',0)}out  "
          f"turns={k.get('turns')} commits={w.get('commits')} "
          f"{'LEAKED ' if k.get('leaked_tool_calls') else ''}"
          f"{'TIMEOUT' if k.get('timed_out') else ''}")
PYR
  fi
done

# ---- native (Agent-tool) workers ---------------------------------------------
# A record that did not take a dispatch row (native_takes_row) is drawn here. It has
# no process and no dispatch log, so the record is its only evidence.
while IFS=$'\t' read -r NI NMODEL _ NFIN _ _ NWT _ NSAGE; do
  [[ -n "$NI" ]] || continue
  # A native record is keyed by its canonical issue number, so the filter compares that. Dispatch
  # and worktree rows are named by their directory and keep the typed spelling, as they always have.
  [[ -n "$ONLY" && "$NI" != "$ONLY_CANON" ]] && continue
  case " $PRINTED_DISPATCH " in *" $NI "*) continue ;; esac
  FOUND=1
  BRANCH=$(wt_branch "$NWT")
  COMMITS=$(wt_commits "$NWT")
  DIRTY=$(wt_dirty "$NWT")
  PUSHED=$(wt_unpushed "$NWT" "$BRANCH")
  if [[ "$NFIN" != "-" ]]; then
    STATE_W="done"; STATE_C="$DIM"
  else
    # Stalled is measured from the last agent.log stamp. A worktree with no stamp yet
    # (a fresh start) is measured from when the record was started.
    NAGE=$(wt_agentlog_age_min "$NWT")
    NAGE=${NAGE:-$NSAGE}
    if (( NAGE < NATIVE_STALL_MINUTES )); then
      STATE_W=running; STATE_C="$GRN"
    else
      STATE_W='stalled?'; STATE_C="$YEL"
    fi
  fi
  agentlog_cells "$NWT" "$STATE_W" 0
  TITLE=$(title_for "$NI")
  draw_row "$NI" "native-$NMODEL" "$STATE_W" "$STATE_C" "$COMMITS" "$PUSHED" "$DIRTY" \
    "$LOGC" "$LOGSUM" "$BRANCH" "$TITLE"
  [[ "$STATE_W" == running ]] && NATIVE_RUNNING=$((NATIVE_RUNNING + 1))
done <<<"$NATIVE_ROWS"
[[ $NATIVE_RC -eq 0 ]] || echo "${RED}native records UNREADABLE${OFF}: velo-native rows exited $NATIVE_RC (reason on stderr). A worker whose record cannot be read is NOT shown."

[[ $FOUND -eq 1 ]] || { echo "no velostream-* worktrees found"; exit 0; }
echo "slots: $NATIVE_RUNNING native running, $DISPATCH_RUNNING dispatched running"

# Stale stashes are a trap for the next worker, and stashes are REPO-GLOBAL:
# every worktree shares one stash stack. A worker that runs `git stash pop`
# expecting its own entry pops whichever abandoned run left the top one.
# That happened on #1928 — the worker popped an unrelated
# `1748-v1-overrejects` stash into its tree, hit a conflict in a file it had
# never touched, and spent the recovery diagnosing someone else's work.
STASHES=$(git stash list 2>/dev/null | wc -l | tr -d ' ')
if [[ "$STASHES" -gt 0 ]]; then
  echo
  printf '%bwarn:%b %s stale stash entr%s on the SHARED stack — a worker running `git stash pop`\n' \
    "$YEL" "$OFF" "$STASHES" "$([[ "$STASHES" == 1 ]] && echo y || echo ies)"
  echo "      will pop whichever is on top, not its own. Clear them or brief workers not to stash."
  git stash list 2>/dev/null | head -3 | sed 's/^/      /'
  [[ "$STASHES" -gt 3 ]] && echo "      ... and $((STASHES - 3)) more"
fi

echo
echo "${YEL}n!${OFF} = commits not yet pushed   ${RED}LEAKED${OFF} = tool calls emitted as text, never ran"
echo "${YEL}live?${OFF} = no exit record and the log is still moving — a worker this build cannot see"
echo "${RED}?${OFF}     = liveness UNKNOWN: the record check itself failed (reason on stderr)"
echo "native-<model> = an Agent-tool worker recorded by velo-native   ${YEL}stalled?${OFF} = no agent.log entry for ${NATIVE_STALL_MINUTES}m, not finished"
echo "AGENT-LOG = lines, age of last entry, flags: S=STOP  F=FINDING  C=CORRECTION  ${RED}!${OFF}=SECURITY/DATA-LOSS"
echo "${YEL}yellow age${OFF} = running, but no log entry for 10m+ — wedged, OR not writing the"
echo "             heartbeats the policy requires. Both mean the report will be thin."

# ---- open PRs ---------------------------------------------------------------
echo
echo "open PRs:"
# The CI column is ONE state reduced from EVERY check row, by the definition velo-merge refuses
# on (velo-ci-rollup.jq): the first row is not the PR's state — a skipped optional lane sorts
# first and says nothing — and a definition that cannot be read or run is said so, never shown
# as an empty list or a guessed state.
CI_ROLLUP_JQ="$(dirname "${BASH_SOURCE[0]}")/velo-ci-rollup.jq"
if ! PRS_JSON=$(gh pr list --repo "$REPO" --state open --limit 10 \
      --json number,title,mergeable,statusCheckRollup 2>/dev/null); then
  echo "  (gh unavailable)"
elif ! CI_ROLLUP_DEFS=$(cat -- "$CI_ROLLUP_JQ" 2>&1); then
  echo "  (cannot read the CI rollup definition $CI_ROLLUP_JQ: $(head -n 1 <<<"$CI_ROLLUP_DEFS"))"
elif ! PR_LINES=$(jq -r "$CI_ROLLUP_DEFS"' .[] | (.statusCheckRollup | ci_rollup) as $ci
      | "  #\(.number) \(.mergeable // "?") \($ci.state)  \(.title[0:66])"' <<<"$PRS_JSON" 2>&1); then
  echo "  (could not classify the open PRs' checks: $(head -n 1 <<<"$PR_LINES" | cut -c1-200))"
else
  [[ -z "$PR_LINES" ]] || echo "$PR_LINES"
fi

# ---- parent efforts ---------------------------------------------------------
# Most work here belongs to an umbrella issue, signalled by a "[#NNNN]" title
# prefix. Showing progress against that umbrella answers "how much of this
# effort is left", which a per-PR view cannot.
PARENTS=$(gh pr list --repo "$REPO" --state open --json title --jq '.[].title' 2>/dev/null \
          | grep -oE '^\[#[0-9]+\]' | tr -d '[]#' | sort -u)
if [[ -n "$PARENTS" ]]; then
  echo
  echo "parent efforts:"
  for P in $PARENTS; do
    PT=$(gh issue view "$P" --repo "$REPO" --json title,state --jq '"\(.state) \(.title)"' 2>/dev/null)
    [[ -n "$PT" ]] || continue
    O=$(gh issue list --repo "$REPO" --search "\"[#$P]\" in:title" --state open   --limit 200 --json number --jq 'length' 2>/dev/null)
    C=$(gh issue list --repo "$REPO" --search "\"[#$P]\" in:title" --state closed --limit 200 --json number --jq 'length' 2>/dev/null)
    T=$(( ${O:-0} + ${C:-0} ))
    if [[ "$T" -gt 0 ]]; then
      PCT=$(( ${C:-0} * 100 / T ))
      printf '  #%-5s %3s/%-3s closed (%2s%%)  %s\n' "$P" "${C:-0}" "$T" "$PCT" "${PT:0:56}"
      # Name what is still open — "9 left" is less useful than which 9.
      gh issue list --repo "$REPO" --search "\"[#$P]\" in:title" --state open --limit 200 \
        --json number,title,labels \
        --jq '.[]|"      #\(.number) \([.labels[].name]|map(select(startswith("worker:")or.=="blocked"or.=="needs-design"))|join(","))  \(.title[0:52])"' 2>/dev/null
    fi
  done
fi

# ---- disk -------------------------------------------------------------------
AVAIL=$(df -g "$HOME" | awk 'NR==2 {print $4}')
echo
if [[ "$AVAIL" -lt 40 ]]; then
  echo "${RED}disk: ${AVAIL}GB free${OFF} — under 40GB. Workers die with errors that look"
  echo "  like compile bugs. Free space: rm -rf <merged-worktree>/target"
else
  echo "disk: ${AVAIL}GB free"
fi
