#!/bin/bash
# velo-spec-review — attest that a task spec + brief were read against the issue.
#
#   velo-spec-review <issue> <brief-file> [--by <name>]   attest (as before)
#   velo-spec-review <issue> --check                      review the SPEC (Codex)
#   velo-spec-review <issue> --check --worktree <path>    review the spec IN that
#                                                         worktree (branch, not master)
#
# --check is the loop: Codex reads the spec adversarially against the issue and
# the repo, reports findings, and exits non-zero. You fix the spec and re-run.
# Two consecutive CLEAN rounds on unchanged spec content complete the loop.
#
# Writes the `reviewed` block velo-dispatch requires:
#
#   "reviewed": { "by": ..., "at": <now>, "brief_sha256": <hash of brief> }
#
# It deliberately does NOT judge the spec — it records that a human did, and
# pins WHAT they read. `brief_sha256` is the point: it makes a post-review edit
# to the brief fail the next dispatch, which is the failure this exists to stop.
#
# Run it AFTER reading the issue (including comments) and the brief. Running it
# reflexively to clear a gate defeats it — the hash and timestamp are evidence,
# and a wrong attestation is worse than none because it looks like diligence.
#
# Attest mode refuses what velo-dispatch would refuse, before it records anything: a brief that the
# brief lint rejects, and an issue without exactly one `worker:*` label. A refusal writes nothing:
# no reviewed block, no change to the spec, nothing to the issue.
set -uo pipefail
REPO="velostreamai/velostream"
die() { printf '\n\033[31mERROR:\033[0m %s\n\n' "$1" >&2; exit 1; }
# The brief lint, one definition shared with velo-dispatch (see velo-brief-lint.sh).
. "$(dirname "${BASH_SOURCE[0]}")/velo-brief-lint.sh" || die "velo-brief-lint.sh missing next to velo-spec-review"

ISSUE="${1:-}"; BRIEF=""; BY="${USER:-unknown}"; CHECK=0; REVIEW_WT=""
STATE="${VELO_STATE:-$HOME/.agents/state}"
SPEC_TIMEOUT="${VELO_SPEC_TIMEOUT:-900}"
SPEC_CLEAN_ROUNDS="${VELO_SPEC_CLEAN_ROUNDS:-2}"
# Which reviewer runs a round. codex is the default and the one the clean-round
# bar was calibrated on; see the refusal in spec_check() for what a substitute
# must clear before it is allowed here.
SPEC_WORKER="${VELO_SPEC_WORKER:-codex}"
shift 1 2>/dev/null || true
while [[ $# -gt 0 ]]; do
  case "$1" in
    --check) CHECK=1; shift ;;
    --by)    BY="$2"; shift 2 ;;
    --worktree) REVIEW_WT="$2"; shift 2 ;;
    --worker) SPEC_WORKER="$2"; shift 2 ;;
    -*)      die "unknown flag: $1" ;;
    *)       [[ -z "$BRIEF" ]] && BRIEF="$1"; shift ;;
  esac
done

[[ "$ISSUE" =~ ^[0-9]+$ ]] || die "usage: velo-spec-review <issue> <brief-file> [--by <name>]
       velo-spec-review <issue> --check"
# Checked BEFORE the brief requirement, so `--worktree` without `--check` reports
# the flag misuse rather than "attest mode needs a brief file", which sends the
# reader looking for the wrong mistake.
[[ -z "$REVIEW_WT" || $CHECK -eq 1 ]] || die "--worktree is only valid with --check
       Attest mode must write the canonical spec that velo-dispatch reads."
if [[ $CHECK -eq 0 ]]; then
  [[ -n "$BRIEF" ]] || die "attest mode needs a brief file (or pass --check to review the spec)"
  [[ -f "$BRIEF" ]] || die "brief not found: $BRIEF"
fi
# Same ROOT as velo-dispatch, deliberately hardcoded rather than derived from
# the cwd. They must read the SAME spec file: an early version used
# `git rev-parse --show-toplevel`, so attesting from a worktree wrote a
# `reviewed` block that dispatch — reading the canonical repo — never saw, and
# the gate refused a spec that had in fact been reviewed. Caught by testing the
# two together; it would have looked like a flaky gate.
ROOT="$HOME/RustroverProjects/velostream"

# --check may review a spec that is not on master yet. Attest mode may NOT: the
# paragraph above is why, and it still holds.
#
# Without this, `--check` always read the canonical worktree while spec fixes sat
# on a branch, so round after round re-reviewed the SAME merged content. Two
# rounds were spent that way on #1918 before anyone noticed, and the finding
# count moved 5 -> 1 -> 3 on reviewer nondeterminism alone, which reads exactly
# like progress. A loop that cannot see your edits is worse than no loop: it
# manufactures the feeling of convergence.
#
# RESOLVE THE ROOT BEFORE CHECKING THE SPEC EXISTS. It used to check
# `$ROOT/.agents/tasks/<issue>.json` unconditionally first, and only then apply
# --worktree — so a spec that existed ONLY on the branch was rejected before the
# override ran, with "no task spec: <canonical path>". That made --worktree
# usable only for specs already on master, which is the precise opposite of what
# the paragraph above says it is for. Nothing caught it because reaching this
# code needs a spec, and every hand-run had one in both places.
REVIEW_ROOT="$ROOT"
if [[ -n "$REVIEW_WT" ]]; then
  [[ -d "$REVIEW_WT" ]] || die "--worktree not found: $REVIEW_WT"
  REVIEW_ROOT=$(cd "$REVIEW_WT" && pwd)
fi
SPEC="$REVIEW_ROOT/.agents/tasks/${ISSUE}.json"
# Name which tree was searched: with --worktree the canonical path is not the
# one that mattered, and reporting it sends the reader to the wrong file.
if [[ ! -f "$SPEC" ]]; then
  if [[ -n "$REVIEW_WT" ]]; then
    die "no task spec in that worktree: $SPEC"
  else
    die "no task spec: $SPEC"
  fi
fi

# ---- --check: have Codex review the SPEC, and loop until it stops finding ----
#
# Everything velo-dispatch validates about a spec is MECHANICAL: do the anchors
# resolve against origin/master, does the blast-radius count match, is `design`
# pinned, are deps closed, is there a `reviewed` block. All necessary, none of
# them judgement. A spec can pass every one of those and still send a worker at
# the wrong thing:
#
#   - stop_conditions that do not cover the hazard named in `_why`
#   - a fail_to_pass test that ALREADY passes, so it gates nothing
#   - an anchor whose symbol was renamed after `verified_against`
#   - acceptance criteria no run could actually demonstrate
#
# Two issues filed this week carried claims that did not survive being checked
# (#2004's branch anecdote, #2007's 4.4x). The spec is the thing a worker is
# actually paid to follow, and until now nothing read it adversarially.
#
# Codex, because it found a real defect in every round it ran against this
# tooling. A spec is small, so a round is cheap next to a code review.
#
# The loop is deliberately NOT automatic: findings are reported, a human fixes
# the spec, and the check is re-run. A reviewer that edits the artefact it is
# reviewing converges on something nobody chose.
#
# "Clean" requires TWO consecutive clean rounds ON THE SAME SPEC CONTENT. One
# clean round proves the last fix did not break anything obvious; two proves the
# reviewer stopped finding things rather than merely finding different things.
# Any edit to the spec resets the streak, because the thing under review changed.
spec_check() {
  local round_log streak spec_now
  mkdir -p "$STATE/spec/$ISSUE"
  spec_now=$(shasum -a 256 "$SPEC" | cut -d' ' -f1)

  # Substitution is ALLOWED but never SILENT. The rule this encodes: on #1988 a
  # local model approved a diff carrying two P1s and asserted the opposite of
  # one of them, so a quiet fallback to whatever is on PATH is forbidden. That
  # is an argument about model CAPABILITY, not about the string "codex" — so a
  # frontier model may run a round, provided the run says so everywhere the
  # verdict is read: stdout, the round log, and the ledger.
  case "$SPEC_WORKER" in
    codex)
      command -v codex >/dev/null 2>&1 || die "codex CLI not on PATH — cannot run the spec review.
  Do NOT silently substitute a weaker model: on #1988 a local one approved a diff
  carrying two P1s and asserted the opposite of one of them.
  To use a declared substitute: --worker opus"
      ;;
    opus)
      command -v claude >/dev/null 2>&1 || die "claude CLI not on PATH — cannot run --worker opus."
      printf '\033[33m  SUBSTITUTE\033[0m spec review running on OPUS (effort high), not codex.\n'
      printf '             Recorded in the ledger and the round log. The clean-round bar was\n'
      printf '             calibrated on codex; a CLEAN from a substitute is evidence, not proof.\n'
      ;;
    *)
      die "unknown --worker '$SPEC_WORKER'. Allowed: codex (default), opus.
  Anything weaker is refused outright — see #1988."
      ;;
  esac

  round_log="$STATE/spec/$ISSUE/review-$(date -u +%Y%m%dT%H%M%SZ).log"
  local brief="$STATE/spec/$ISSUE/brief.md"

  {
    echo "You are reviewing a TASK SPEC before a worker is dispatched against it."
    echo "You are NOT reviewing code, and there is no diff. Read-only: do not write files."
    echo
    echo "The spec tells an autonomous worker what to change, what must not change,"
    echo "when to stop, and which tests prove it worked. A worker follows it without"
    echo "judgement, so a wrong spec spends a whole run producing confidently wrong work."
    echo
    echo "## The spec"
    echo '```json'
    cat "$SPEC"
    echo '```'
    echo
    echo "## The issue it claims to implement"
    gh issue view "$ISSUE" --repo "$REPO" --json title,body,comments \
      --jq '"### " + .title + "\n\n" + .body + "\n\n## Comments\n" + ([.comments[] | "- " + .author.login + ": " + .body] | join("\n"))' 2>/dev/null
    echo
    echo "## ATTACK — verify, do not summarise"
    echo
    echo "You have a shell. USE IT. Every claim below is checkable against the repo"
    echo "at $ROOT (read-only; do not modify it)."
    echo
    echo "1. ANCHORS. For each entry in .anchors, does that file exist at"
    echo "   origin/master and does the named symbol still appear in it? The spec"
    echo "   was verified against \$(jq -r .verified_against). Master has moved."
    echo "   A stale anchor sends the worker to a line that is not there."
    echo "2. TESTS. For each .tests.fail_to_pass, does that test EXIST, and does it"
    echo "   currently FAIL? A fail_to_pass that already passes gates nothing and"
    echo "   the run will look successful having changed nothing. Say which."
    echo "   For .tests.pass_to_stay, do they exist and currently pass?"
    echo "3. STOP CONDITIONS. Read ._why. Does .stop_conditions actually cover the"
    echo "   hazard it describes? Name any hazard in _why with no matching stop."
    echo "4. FORBIDDEN. If .forbidden exists, is each entry checkable after the"
    echo "   fact from a diff? An unverifiable prohibition is decoration."
    echo "5. BLAST RADIUS. Does .blast_radius.pattern still match the stated count"
    echo "   at origin/master? Run the grep. Report the real number."
    echo "6. SCOPE vs ISSUE. Does the spec implement what the issue asks, or"
    echo "   something adjacent? Quote the divergence."
    echo "7. ACHIEVABILITY. Could a worker with Read/Grep/Bash/Edit/Write and no"
    echo "   LSP actually satisfy this, in the turns available? If it requires"
    echo "   type-aware refactoring across many call sites, say so — that is a"
    echo "   spec that cannot be honoured, not a worker that failed."
    echo
    echo "## OUTPUT — exact format, last line machine-read"
    echo
    echo "For each finding: SEVERITY (HIGH/MED/LOW), which numbered check, what is"
    echo "wrong, and the command you ran that shows it. Mark anything you could not"
    echo "execute as UNVERIFIED and say why."
    echo
    echo "End with EXACTLY one of these as the FINAL line, nothing after it:"
    echo "  VERDICT: CLEAN"
    echo "  VERDICT: FINDINGS <n>"
  } > "$brief"

  printf '  .. spec review round for #%s (%s, up to %ss)\n' "$ISSUE" "$SPEC_WORKER" "$SPEC_TIMEOUT"
  # Name the tree under review, its HEAD, and whether it is dirty or ahead of
  # master. A round that silently reviewed stale content is indistinguishable
  # from a round that found nothing, so this line is the difference between a
  # verdict you can trust and one you cannot.
  R_HEAD=$(git -C "$REVIEW_ROOT" rev-parse --short HEAD 2>/dev/null || echo '?')
  R_AHEAD=$(git -C "$REVIEW_ROOT" rev-list --count origin/master..HEAD 2>/dev/null || echo '?')
  R_DIRTY=$(git -C "$REVIEW_ROOT" status --porcelain -- .agents/tasks 2>/dev/null | wc -l | tr -d ' ')
  printf '  reviewing %s (HEAD %s, %s commit(s) ahead of origin/master, %s uncommitted spec file(s))\n' \
    "$REVIEW_ROOT" "$R_HEAD" "$R_AHEAD" "$R_DIRTY"
  if [[ "$REVIEW_ROOT" == "$ROOT" && "$R_AHEAD" == "0" && "$R_DIRTY" == "0" ]]; then
    printf '  \033[2m(spec content equals origin/master — if you just edited it on a branch, pass --worktree <path>)\033[0m\n'
  fi
  case "$SPEC_WORKER" in
    codex)
      ( cd "$REVIEW_ROOT" && timeout "$SPEC_TIMEOUT" codex review - < "$brief" ) > "$round_log" 2>&1
      ;;
    opus)
      # Same brief, same cwd, same read-only contract. Edit/Write/NotebookEdit are
      # disallowed because a reviewer that can edit the artefact under review
      # converges on something nobody chose (see this function's header).
      ( cd "$REVIEW_ROOT" && timeout "$SPEC_TIMEOUT" claude -p --model opus --effort high \
          --permission-mode dontAsk --disallowed-tools Edit Write NotebookEdit \
          < "$brief" ) > "$round_log" 2>&1
      ;;
  esac
  local rc=$?

  local verdict findings
  # Strip the label: the ledger and the case below compare the TOKEN. Keeping
  # the whole match stored "VERDICT: CLEAN" and compared it against "CLEAN",
  # so the streak never incremented and every clean round reported NOT CLEAN.
  # Found by stubbing codex before spending a paid round on it.
  verdict=$(grep -oE '^VERDICT: (CLEAN|FINDINGS [0-9]+)' "$round_log" | tail -1 | sed 's/^VERDICT: //')
  if [[ $rc -eq 124 ]]; then
    verdict="TIMEOUT"
  elif [[ -z "$verdict" ]]; then
    # Fail closed. A review with no parseable verdict is not a pass — it is a
    # review that did not finish, or a model that ignored the format. Treating
    # silence as CLEAN is how a gate reports success having produced nothing.
    verdict="NO-VERDICT"
  fi
  # Digits only. A model that ends without a newline, or adds a stray character,
  # yielded "2n" here — which crashed the ledger append below and SILENTLY LOST
  # the round. An audit ledger that drops entries when something unexpected
  # happens is worthless precisely when it matters.
  findings=$(sed -nE 's/^VERDICT: FINDINGS ([0-9]+).*/\1/p' "$round_log" | tail -1 | tr -cd '0-9')

  python3 - "$STATE/spec/$ISSUE/rounds.jsonl" "$spec_now" "$verdict" "${findings:-0}" "$round_log" "$SPEC_WORKER" <<'PY'
import json, sys, os, datetime
path, spec_sha, verdict, findings, log, worker = sys.argv[1:7]
# Nothing here may raise. The round HAPPENED; a value we cannot parse is a
# reason to record it as unparseable, never a reason to lose the entry.
try:
    n = int(findings)
except (TypeError, ValueError):
    n = 0
rec = {
    "at": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "spec_sha256": spec_sha, "verdict": verdict or "UNPARSEABLE",
    "findings": n, "log": log, "worker": worker,
}
if findings and not findings.isdigit():
    rec["findings_raw"] = findings
try:
    with open(path, "a") as f:
        f.write(json.dumps(rec) + "\n")
except Exception as exc:
    print(f"WARNING: could not append to the spec-review ledger: {exc}", file=sys.stderr)
PY

  streak=$(python3 - "$STATE/spec/$ISSUE/rounds.jsonl" "$spec_now" "$SPEC_WORKER" <<'PY'
import json, sys
path, spec_sha, worker = sys.argv[1:4]
n = 0
try:
    rows = [json.loads(l) for l in open(path) if l.strip()]
except FileNotFoundError:
    rows = []
# Count trailing CLEAN rounds against THIS spec content. An edit resets the
# streak because the artefact under review changed.
# Also require the SAME worker across the streak. Two CLEAN rounds from two
# different reviewers is weaker evidence than two from one: it can mean each
# stopped finding things the other would have found. Rows written before the
# worker field existed are treated as codex, which is what they were.
for r in reversed(rows):
    if (r.get("spec_sha256") != spec_sha
            or r.get("verdict") != "CLEAN"
            or r.get("worker", "codex") != worker):
        break
    n += 1
print(n)
PY
)

  echo
  sed -n '/^## /,$p' "$round_log" 2>/dev/null | tail -60
  echo
  printf '  log: %s\n' "$round_log"

  case "$verdict" in
    CLEAN)
      if [[ "$streak" -ge "$SPEC_CLEAN_ROUNDS" ]]; then
        printf '\033[32m  ok\033[0m spec review CLEAN x%s on the same spec — loop complete\n' "$streak"
        return 0
      fi
      printf '\033[33mwarn:\033[0m clean, but only %s of %s consecutive rounds on this spec.\n' \
        "$streak" "$SPEC_CLEAN_ROUNDS" >&2
      printf '      Re-run without editing the spec to confirm.\n' >&2
      return 1 ;;
    TIMEOUT)
      printf '\033[31mERROR:\033[0m review timed out after %ss — no verdict.\n' "$SPEC_TIMEOUT" >&2
      return 2 ;;
    NO-VERDICT)
      printf '\033[31mERROR:\033[0m no VERDICT line — treating as NOT clean.\n' >&2
      printf '      A review that produced no verdict did not finish. Read the log.\n' >&2
      return 2 ;;
    FINDINGS*)
      printf '\033[31mNOT CLEAN:\033[0m %s findings. Fix the spec, then re-run.\n' "${findings:-?}" >&2
      return 1 ;;
    *)
      printf '\033[31mERROR:\033[0m unrecognised verdict %q — treating as NOT clean.\n' "$verdict" >&2
      return 2 ;;
  esac
}

if [[ $CHECK -eq 1 ]]; then
  spec_check
  exit $?
fi

# The brief must pass the lint velo-dispatch runs BEFORE anything is attested. A refusal here writes
# nothing: no reviewed block, no change to the spec, nothing to the issue.
velo_brief_lint "$BRIEF" || exit 1

# One read for everything the attestation rests on, so the labels and the updatedAt it is pinned to
# describe the same issue state. A label edit moves updatedAt: read apart, a check could pass on
# labels that changed before the timestamp it then records.
META=$(gh issue view "$ISSUE" --repo "$REPO" --json updatedAt,labels 2>/dev/null) \
  || die "could not read issue #$ISSUE"
UPD=$(jq -r .updatedAt <<<"$META") || die "could not read updatedAt of #$ISSUE"
[[ -n "$UPD" && "$UPD" != null ]] || die "issue #$ISSUE has no updatedAt to pin the attestation to"
LABELS=$(jq -r '[.labels[].name] | join(",")' <<<"$META") || die "could not read the labels of #$ISSUE"

# velo-dispatch routes by the issue's worker:* label and refuses on zero of them or on two (its
# WORKERS and COUNT lines). The spec's `worker` field does not stand in for the label: dispatch
# routes by the label alone and only warns when the spec disagrees with it.
WORKERS=$(tr ',' '\n' <<<"$LABELS" | grep '^worker:' || true)
COUNT=$(grep -c . <<<"$WORKERS" || true)
if [[ "$COUNT" -eq 0 ]]; then
  die "#$ISSUE has no 'worker:*' label — velo-dispatch refuses it, so this attestation would certify
  a brief nothing can dispatch.
  Add the label FIRST, then re-run this review. A label edit moves the issue's updatedAt, which
  would make an attestation written before the edit stale the moment it is written.
  Add one of:
    worker:local     free, local Qwen3-Coder. Scoped impl + audits, slower.
    worker:deepseek  very cheap. Fast scoped impl against a PINNED design.
    worker:haiku     cheap, Claude leg. Scoped impl when a DeepSeek-shaped
                     route should run on Anthropic's cheap model instead.
    worker:glm       pricier. Multi-step reasoning / per-case judgement.
    worker:codex     most capable, most expensive. Architecture-weight work:
                     anything where a WRONG answer costs more than the run."
elif [[ "$COUNT" -gt 1 ]]; then
  die "#$ISSUE has $COUNT worker labels ($(tr '\n' ' ' <<<"$WORKERS")) — velo-dispatch allows at most one.
  Remove all but one, then re-run this review: a label edit moves the issue's updatedAt."
fi

# Attest as of the issue's OWN updatedAt, not wall-clock now. If a comment lands
# between reading and attesting, the next dispatch must catch it — stamping
# `now` would paper over exactly that race.
HASH=$(shasum -a 256 "$BRIEF" | cut -d' ' -f1)

python3 - "$SPEC" "$BY" "$UPD" "$HASH" <<'PY'
import json, sys
spec, by, at, h = sys.argv[1:5]
d = json.load(open(spec))
d["reviewed"] = {"by": by, "at": at, "brief_sha256": h}
json.dump(d, open(spec, "w"), indent=2)
PY

printf '\033[32m  ok\033[0m #%s reviewed by %s\n' "$ISSUE" "$BY"
printf '     at           %s   (the issue'"'"'s own updatedAt)\n' "$UPD"
printf '     brief sha256 %s\n' "$HASH"
printf '     Any later edit to the brief, or any new comment on #%s, now fails dispatch.\n' "$ISSUE"
